# FIXME: disable for now
Exit! 0

When the image library is /imageLib/ {
    set cc [dict link $C {}]
    cc::extend $imageLib
    cc::include <math.h>
    cc::code {
        double lastMutatedT;
        Image im;
    }
    cc::proc init {} void {
        im.width = 640;
        im.height = 480;
        im.bytesPerRow = 640 * 4;
        im.components = 4;
        im.data = calloc(im.bytesPerRow, im.height);
    }
    cc::proc mutateImage {double t} void {
        if (t - lastMutatedT < 1) {
            return;
        }
        lastMutatedT = t;
        for (int i = 0; i < im.bytesPerRow * im.height; i++) {
            if (i % 4 != 3) {
                im.data[i] = (((int)floor(t) % 10) / 10.0) * 255.0;
            } else if (i % 4 == 3) {
                im.data[i] = 255;
            }
            // if (im.data[i] == 0) { im.data[i] = 255; break; }
        }
        im.uniq++;
        printf("Mut\n");
    }
    cc::proc getImage {} Image {
        return im;
    }
    set lib [cc::compile]
    lib::init
    Claim the texture-churn library is $lib
}

Wish the GPU creates canvas TEST with width 1024 height 1024
Claim $this has canvas projection {
    {1 0 0}
    {0 1 0}
    {0 0 1}
}
Claim $this has canvas TEST with width 1024 height 1024
Claim $this has resolved geometry {width 1 height 1 left 0.7}

When the texture-churn library is /lib/ &\
     the clock time is /t/ {
    # Draw an image in C.
    # Then push it to the screen.
    lib::mutateImage $t

    # Then copy it back and check that it's been filled?
    Wish $this displays image [lib::getImage]
}

When display /disp/ has width /w/ height /h/ &\
     the GPU has created canvas TEST with /...canvasOpts/ {

    set a [list -0.5 -0.5]
    set b [list 0.5 -0.5]
    set c [list 0.5 0.5]
    set d [list -0.5 0.5]

    Wish the GPU draws pipeline "image" with arguments \
        [list [list $w $h] \
             {{1 0 0} {0 1 0} {0 0 1}} \
             $canvasOpts::texture $a $b $c $d]
}

Assert! when /__this/ has program code /__programCode/ [fn {__this __programCode} {
    SayWithSource [dict create sourceFileName $__this sourceLineNumber 1] \
        when [fn {} $__programCode]
}]
fn LoadProgram! {programFilename} {
    set fp [file open $programFilename r]
    Hold! -keep 100ms -on boot.folk -key [list $programFilename code] \
        Claim $programFilename has program code [stream read $fp]
    close $fp
}

fn loadPrograms {} {
    LoadProgram! builtin-programs/web/web.folk
    LoadProgram! builtin-programs/web/textures.folk
    LoadProgram! builtin-programs/image/image-lib.folk
    LoadProgram! builtin-programs/gpu/textures.folk
    LoadProgram! builtin-programs/gpu/canvases.folk
    LoadProgram! builtin-programs/draw/image.folk
    LoadProgram! builtin-programs/gpu/gpu-fns.folk
    source builtin-programs/gpu/gpu.folk
}
loadPrograms
