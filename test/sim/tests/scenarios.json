        {"k": "app", "a": "size", "size": 17},
        {"k": "app", "a": "stroke", "tool": "line"},
        {"k": "app", "a": "stroke", "tool": "pen"},
        {"k": "app", "a": "confirm-open"},
        {"k": "app", "a": "clear-cancelled"},
        {"k": "app", "a": "undo"},
        {"k": "app", "a": "undo"},
        {"k": "app", "a": "redo"}
      ]
    },
