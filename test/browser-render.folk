# End-to-end test of the browser driver: real headless Chromium renders
# test/browser-fixtures/*.html, and we check the actual pixels of the
# frames after they go through Folk's in-memory PNG loader (the same
# path that browser.folk uses to put frames on the table). Nothing is
# written to disk.
#
# The driver is asynchronous: calls return at once and frames arrive
# when Chromium repaints, so each check waits for a frame that
# satisfies a condition rather than forcing a screenshot.
#
# Needs uvx + network on first run (to fetch Playwright) and a Chromium
# Playwright can launch (see browser-setup.folk).

source test/browser-test-helpers.tcl
requireBrowserDriver
source builtin-programs/image/image-lib.folk
source builtin-programs/image/png-lib.folk
source builtin-programs/browser/browser-lib.folk
source builtin-programs/browser/browser-setup.folk
source builtin-programs/browser/browser-driver.folk

expectSteps {render links scroll text-fragment hover-feedback dwell-navigates tilt-scrolls} 150

When the browser driver is /driver/ &\
     the png library is /pngLib/ &\
     the image library is /imageLib/ &\
     the browser library is /lib/ {

    # Waits (up to `timeout` s) for a frame of `sid` for which `cond`
    # (evaluated with im and meta bound) is true; returns {im meta}.
    fn waitFrame {sid cond {timeout 15}} {
        set deadline [expr {[clock milliseconds] + $timeout * 1000}]
        set lastN -1
        set meta {}
        while {[clock milliseconds] < $deadline} {
            set meta [$driver frame $sid $lastN]
            if {[dict size $meta] == 0} { sleep 0.02; continue }
            set lastN [dict get $meta n]
            if {![dict get $meta hasPixels]} { continue }
            set im [$pngLib loadPngFromMemory [$driver framePng $sid $lastN]]
            uplevel 1 [list set im $im]
            uplevel 1 [list set meta $meta]
            if {[uplevel 1 $cond]} {
                return [list $im $meta]
            }
        }
        error "waitFrame $sid: no frame satisfied {$cond} within ${timeout}s (last: [dict getdef $meta status ?] [dict getdef $meta url ?] scrollY [dict getdef $meta scrollY ?])"
    }

    set index "$browserFixtureUrl/index.html"
    set two "$browserFixtureUrl/two.html"
    $driver openSession s1 $index 1024 640 {}

    check render {
        lassign [waitFrame s1 {expr {[dict get $meta status] eq "loaded" && [dict get $meta url] eq $index}}] im meta
        assertEq [$imageLib Image_width $im] 1024
        assertEq [$imageLib Image_height $im] 640
        assertEq [dict get $meta title] "Folk browser fixture"
        # Red header, blue link, white page.
        assertPixel $imageLib $im 10 10 {255 0 0}
        assertPixel $imageLib $im 1000 190 {255 0 0}
        assertPixel $imageLib $im 110 310 {0 0 255}
        assertPixel $imageLib $im 700 500 {255 255 255}
        # Link text is white on blue: some of the link box should be
        # neither, i.e. text actually got drawn.
        assert {[fractionMatching $imageLib $im {100 300 400 80} {0 0 255}] < 0.98}
        pass render
    }

    check links {
        lassign [waitFrame s1 {expr {[llength [dict get $meta links]] == 2}}] im meta
        set links [dict get $meta links]
        assertEq [lindex $links 1 0] "$browserFixtureUrl/two.html#second"
        lassign [lindex $links 0] href x y w h
        assertEq $href $two
        assertNear $x 100 1; assertNear $y 300 1
        assertNear $w 400 1; assertNear $h 80 1
        # And the library's hit test finds it from a viewport point.
        assertEq [lindex [$lib linkAt $links 300 340] 0] $href
        pass links
    }

    check scroll {
        $driver scrollBy s1 0 1000
        lassign [waitFrame s1 {expr {abs([dict get $meta scrollY] - 1000) < 1}}] im meta
        # The green band (document y 1000..1400) is now at the top.
        assertPixel $imageLib $im 10 10 {0 255 0}
        assertPixel $imageLib $im 500 390 {0 255 0}
        assertPixel $imageLib $im 500 450 {255 255 255}
        # The links scrolled out of view, and that was reported.
        assertEq [llength [dict get $meta links]] 0
        assert {[dict get $meta linksChanged]}
        $driver scrollBy s1 0 -1000
        waitFrame s1 {expr {[dict get $meta scrollY] == 0}}
        pass scroll
    }

    check text-fragment {
        set url "$index#:~:text=The%20bad%20news,the%20first%20place"
        set directives {}
        foreach d [$lib textFragmentDirectives $url] {
            lappend directives {*}[dict values $d]
        }
        # dict order is prefix start end suffix
        assertEq [llength $directives] 4
        $driver openSession s2 $url 1024 640 $directives
        lassign [waitFrame s2 {expr {[dict get $meta status] eq "loaded" && [dict get $meta scrollY] > 1800}}] im meta
        set fragment [dict get $meta fragment]
        if {[llength $fragment] != 1} { error "fragment matches: $fragment" }
        # The highlighted range is painted yellow on screen.
        lassign [lindex $fragment 0] fx fy fw fh
        if {$fy < 0 || $fy > 640} { error "fragment not in view: $fragment" }
        set yellow [fractionMatching $imageLib $im [list $fx $fy $fw $fh] {255 235 59}]
        if {$yellow < 0.3} { error "fragment isn't highlighted (yellow fraction $yellow)" }
        # Text before the fragment is not highlighted.
        assertPixel $imageLib $im 45 [expr {int($fy) - 30}] {255 255 255}
        $driver closeSession s2
        pass text-fragment
    }

    check hover-feedback {
        lassign [$driver hover s1 $two 1.5] hovered progress
        assertEq $hovered $two
        assert {$progress < 1}
        # Green outline just outside the link box shows up in a frame.
        lassign [waitFrame s1 {expr {[dict get $meta hover] eq $two && [pixelIs $imageLib $im 98 340 {0 200 83} 60]}}] im meta
        pass hover-feedback
    }

    check dwell-navigates {
        # The dwell timer runs inside the driver; no further hover
        # calls are needed for the link to be followed.
        lassign [waitFrame s1 {expr {[dict get $meta url] eq $two && [dict get $meta status] eq "loaded"}}] im meta
        assertPixel $imageLib $im 10 10 {255 0 255}
        assertPixel $imageLib $im 512 320 {255 0 255}
        assert {[dict get $meta linksChanged]}
        pass dwell-navigates
    }

    check tilt-scrolls {
        $driver openSession s3 $index 1024 640 {}
        waitFrame s3 {expr {[dict get $meta status] eq "loaded"}}
        # 2000 px/s for ~0.3 s, integrated by the driver.
        $driver tilt s3 0 2000
        sleep 0.3
        $driver tilt s3 0 0
        lassign [waitFrame s3 {expr {[dict get $meta scrollY] > 300}}] im meta
        # Give it a moment to settle, then it must have stopped.
        sleep 0.3
        lassign [waitFrame s3 {expr {1}}] im meta2
        set y [dict get $meta2 scrollY]
        if {$y < 300 || $y > 1200} { error "unexpected tilt scroll $y" }
        $driver closeSession s3
        pass tilt-scrolls
    }

    $driver closeSession s1
}
