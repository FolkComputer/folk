When {
    source "builtin-programs/web/web.folk"
}

# Wait for the Web server to boot.
while true {
    try {
        set script {puts "test/ws: server is online; continuing."}
        exec websocat --one-message -u "ws://127.0.0.1:4273/ws" \
            <<$script
        break
    } on error e {
        # puts stderr $e
        sleep 0.3
    }
}

set ws [dict get [QueryOne! the websocket library is /ws/] ws]
dict assign $ws wsSend wsReadMsg

set client [socket connect 127.0.0.1 4273]
set clientKey "dGhlIHNhbXBsZSBub25jZQ=="
stream write $client "GET /ws HTTP/1.1\r\nHost: 127.0.0.1:4273\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: $clientKey\r\nSec-WebSocket-Version: 13\r\n\r\n"

while true {
    set line [string trimright [stream gets $client] "\r"]
    if {$line eq ""} { break }
}

# Emulate what folk.js sends:
wsSend $client {
    Assert! when websocket $chan is connected [fn {} {
        wsSend $ctx [list test-channel pong]
        Claim there is a sent statement
    }]
}

# Verify the client receives the message sent by wsSend $ctx.
set reply [wsReadMsg $client]
set payload [dict get $reply payload]
if {$payload ne "test-channel pong"} {
    error "Expected 'test-channel pong', got '$payload'"
}
puts "test/ws: successfully received response from wsSend: $payload"

When there is a sent statement {
    # Test to make sure this statement gets retracted on WS
    # disconnect.
    On unmatch {
        puts "test/ws: disconnected cleanly and statement retracted; test passed."
        Exit! 0
    }

    close $client
}
