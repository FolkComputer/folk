# Ported off Jim's `oo` package: dict sugar replaces it. An "object" is just a
# dict, its methods are `method` closures stored in that dict, and calling
# `obj::m` passes the dict in as `self` and writes any mutation back.

set C [dict create procs {} name C]

method C::addProc {self name rtype} {
    if {[dict exists $self::procs $name]} { error "C proc: Name collision: $name" }
    dict set self::procs $name $rtype
}
method C::procNames {self} { return [dict keys $self::procs] }
method C::describe {self} { return "$self::name([llength [dict keys $self::procs]])" }

C::addProc addify int
C::addProc negate int

# Mutation through a method is written back to the dict it was called on.
assert {[C::procNames] eq {addify negate}}
assert {$C::procs eq {addify int negate int}}
assert {[C::describe] eq "C(2)"}

# A method can read sibling state, and collisions are caught.
assert {[catch {C::addProc addify int} err] == 1}
assert {$err eq "C proc: Name collision: addify"}

# Plain dicts are values: mutating a copy leaves the original alone.
set D $C
dict set D name D
assert {$C::name eq "C"}
assert {$D::name eq "D"}

puts "weird: ok"
Exit! 0
