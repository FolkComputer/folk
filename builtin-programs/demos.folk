# Setting aside this tag space (45000 to 45050) for Folk Demo Booklet
Claim 45000 has demo code {
    Wish $this is labelled "Welcome to Folk! This is a program"
    Wish $this is outlined green
}
Claim 45001 has demo code  {
    Wish $this is labelled "My wishes came true!"
    Wish $this is outlined blue
}
Claim 45002 has demo code {
    When /actor/ is cool {
        Wish $this is labelled "$actor is pretty cool"
        Wish $actor is outlined red 
    }
}
Claim 45003 has demo code {
    Claim $this is actor
    Claim $this is cool
}
Claim 45004 has demo code {
    When the clock time is /t/ {
        Wish $this is labelled $t
    }
}
Claim 45005 has demo code {
    When the clock time is /t/ {
        Wish $this draws a circle offset [list expr {sin($t) * 50} 0]
    }
}
Claim 45006 has demo code {
    Wish $this is outlined blue
    When $this points up at /p/ {
        Wish $this is labelled "Pointing at $p"
        Wish $p is labelled "and I am being pointed at"
    }
}
Claim 45007 has demo code {
    Wish $this is outlined red
    Wish $this is labelled "I am a program"
}
Claim 45008 has demo code {
    When $this has camera slice /slice/ {
    Wish $this displays camera slice $slice
    }
}
Claim 45009 has demo code {
    # Dock ruler.
    #
    # This page projects two dashed squares ("docks"), one off its
    # left edge and one off its right edge. Slide another program up
    # to a dock so that its AprilTag sits inside the square, and that
    # tag gets registered as a piece of this program: piece A for the
    # left dock, piece B for the right dock. The tags stay registered
    # after they leave the docks: wherever they go on the table, we
    # draw a dashed line between them and report the distance between
    # their centers in mm. Docking a different tag replaces the piece,
    # and a tag moved to the other dock becomes that dock's piece instead.

    set dockSize 0.06 ;# side length of each dock square, in meters
    set dockGap 0.01 ;# gap between each dock and the edge of this page
    set docks {left {name A color gold} right {name B color skyblue}}

    Wish $this is outlined white
    Wish $this is labelled "Dock ruler\ndock a tag on each side, then move them"

    When the quad library is /quadLib/ &\
         the pose library is /poseLib/ &\
         the quad changer is /quadChange/ &\
         display /disp/ has width /w/ height /h/ &\
         display /disp/ has intrinsics /intr/ {

        fn quadChange

        # The docks: draw them, and register any AprilTag that enters one.
        When $this has quad /q/ & $this has resolved geometry /geom/ {
            set q [quadChange $q "display $disp"]

            # Dock rectangles are in page coordinates (meters from the
            # top-left corner of this page), level with our own tag.
            set yc [expr {[dict get $geom top] + [dict get $geom tagSize] / 2.0}]
            set y0 [expr {$yc - $dockSize / 2.0}]
            set y1 [expr {$yc + $dockSize / 2.0}]

            dict for {side dock} $docks {
                if {$side eq "left"} {
                    set x1 [expr {-$dockGap}]
                    set x0 [expr {$x1 - $dockSize}]
                } else {
                    set x0 [expr {[dict get $geom width] + $dockGap}]
                    set x1 [expr {$x0 + $dockSize}]
                }
                set name [dict get $dock name]
                set color [dict get $dock color]

                set dockPx [lmap xy [list [list $x0 $y0] [list $x1 $y0] \
                                         [list $x1 $y1] [list $x0 $y1] \
                                         [list $x0 $y0]] {
                    $poseLib project $intr $w $h [$quadLib xyToPoint $q $xy]
                }]
                Wish to draw a dashed line onto $disp with \
                    points $dockPx width 3 color $color dashlength 10

                # Caption under the dock, reading the same way as this page.
                lassign [lrange $dockPx 2 3] bottomRightPx bottomLeftPx
                set right [vec2 sub $bottomRightPx $bottomLeftPx]
                Wish to draw text onto $disp with \
                    position [vec2 scale [vec2 add $bottomLeftPx $bottomRightPx] 0.5] \
                    scale 22 anchor top text "dock $name" color $color \
                    radians [expr {-atan2([lindex $right 1], [lindex $right 0])}]

                When tag /tag/ has quad /tq/ {
                    if {$tag eq $this} { return }

                    set center [$quadLib centroid [quadChange $tq "display $disp"]]
                    lassign [$quadLib pointToXY $q $center] x y
                    if {$x < $x0 || $x > $x1 || $y < $y0 || $y > $y1} { return }

                    # A tag is sitting in this dock: light the dock up.
                    Wish to draw a line onto $disp with \
                        points $dockPx width 6 color green layer 1

                    # (Kept for a moment, so that the tag doesn't seem
                    # to blink out of the dock whenever its quad or
                    # ours is updated.)
                    Claim -keep 200ms $this has tag $tag in dock $side
                }
            }
        }

        # Decide which tag is each dock's piece. This is the only
        # place that changes the registration, so that tags arriving
        # at both docks at once can't trip over each other.
        When the collected results for \
                 [list /someone/ claims $this has tag /tag/ in dock /side/] \
                 are /results/ {
            set occupants [dict create left {} right {}]
            foreach result $results {
                dict lappend occupants [dict get $result side] [dict get $result tag]
            }

            set pieces [dict create left "" right ""]
            foreach result [Query! $this has dock pieces /pieces/] {
                set pieces [dict get $result pieces]
            }
            set old $pieces

            dict for {side tags} $occupants {
                # The current piece keeps its dock for as long as it
                # sits there (so two tags sharing a dock don't fight
                # over it).
                if {[lsearch -exact $tags [dict get $pieces $side]] >= 0} { continue }

                # Otherwise whoever is in the dock gets it -- except
                # for the other dock's piece, if it hasn't properly
                # left the other dock yet.
                set otherSide [expr {$side eq "left" ? "right" : "left"}]
                set otherPiece [dict get $pieces $otherSide]
                set candidates [lmap tag [lsort -unique $tags] {
                    if {$tag eq $otherPiece &&
                        [lsearch -exact [dict get $occupants $otherSide] $tag] >= 0} {
                        continue
                    }
                    set tag
                }]
                if {[llength $candidates] == 0} { continue }
                set tag [lindex $candidates 0]
                dict set pieces $side $tag

                # A tag is only ever one piece: if it was the other
                # dock's piece, it has moved over here.
                if {$otherPiece eq $tag} { dict set pieces $otherSide "" }
            }

            if {$pieces ne $old} {
                Hold! -key dock-pieces Claim $this has dock pieces $pieces
            }
        }

        # Mark each registered tag with a ring and its letter.
        When $this has dock pieces /pieces/ & $this has quad /q/ {
            # Direction of this page's top edge on the display, so
            # that the letters read the same way as the page does.
            lassign [lmap v [$quadLib vertices [quadChange $q "display $disp"]] {
                $poseLib project $intr $w $h $v
            }] topLeftPx topRightPx
            set pageRight [vec2 sub $topRightPx $topLeftPx]
            set pageRadians [expr {-atan2([lindex $pageRight 1], [lindex $pageRight 0])}]

            dict for {side piece} $pieces {
                if {$piece eq ""} { continue }
                set name [dict get $docks $side name]
                set color [dict get $docks $side color]

                When tag $piece has quad /tq/ {
                    # Tags are blacked out on the display out to ~2x
                    # their size (so that the camera can still see
                    # them), so draw the ring outside that.
                    set ring [$quadLib scale [quadChange $tq "display $disp"] 2.6]
                    set ringPx [lmap v [$quadLib vertices $ring] {
                        $poseLib project $intr $w $h $v
                    }]
                    Wish to draw a line onto $disp with \
                        points [list {*}$ringPx [lindex $ringPx 0]] \
                        width 4 color $color

                    lassign $ringPx tl tr
                    Wish to draw text onto $disp with \
                        position [vec2 scale [vec2 add $tl $tr] 0.5] \
                        scale 30 anchor bottom text $name color $color \
                        radians $pageRadians
                }
            }
        }

        # The ruler: measure between piece A and piece B.
        When $this has dock pieces /pieces/ {
            set a [dict get $pieces left]
            set b [dict get $pieces right]
            if {$a eq "" || $b eq ""} { return }

            When $this has quad /q/ &\
                 tag $a has quad /qa/ & tag $b has quad /qb/ {
                # Tag centers in display space, which is in meters.
                set ca [$quadLib centroid [quadChange $qa "display $disp"]]
                set cb [$quadLib centroid [quadChange $qb "display $disp"]]
                lassign $ca ax ay az
                lassign $cb bx by bz
                set mm [expr {1000.0 * sqrt(($bx-$ax)*($bx-$ax) +
                                            ($by-$ay)*($by-$ay) +
                                            ($bz-$az)*($bz-$az))}]

                set pa [$poseLib project $intr $w $h $ca]
                set pb [$poseLib project $intr $w $h $cb]
                if {[vec2 distance $pa $pb] < 1} { return }

                Wish to draw a dashed line onto $disp with \
                    points [list $pa $pb] width 4 color white dashlength 12

                # Distance report at the midpoint, running along the line
                # (flipped if needed so it isn't upside down relative to
                # this page) and sitting just above it.
                lassign [lmap v [$quadLib vertices [quadChange $q "display $disp"]] {
                    $poseLib project $intr $w $h $v
                }] topLeftPx topRightPx
                set dir [vec2 normalize [vec2 sub $pb $pa]]
                if {[vec2 dot $dir [vec2 sub $topRightPx $topLeftPx]] < 0} {
                    set dir [vec2 scale $dir -1]
                }
                lassign $dir dx dy
                set up [list $dy [expr {-$dx}]]
                Wish to draw text onto $disp with \
                    position [vec2 add [vec2 scale [vec2 add $pa $pb] 0.5] \
                                  [vec2 scale $up 10]] \
                    scale 36 anchor bottom color white \
                    text [format "%.0f mm" $mm] \
                    radians [expr {-atan2($dy, $dx)}]
            }
        }
    }
}
