# Setting aside this tag space (45000 to 45050) for Folk Demo Booklet
Claim 45000 has demo code {
    Wish $this is labelled "Welcome to Folk! This is a program"
    Wish $this is outlined green
}
Claim 45001 has demo code  {
    Wish $this is labelled "My wishes came true!"
    Wish $this is outlined blue
}
Claim 45002 has demo code {
    When /actor/ is cool {
        Wish $this is labelled "$actor is pretty cool"
        Wish $actor is outlined red 
    }
}
Claim 45003 has demo code {
    Claim $this is actor
    Claim $this is cool
}
Claim 45004 has demo code {
    When the clock time is /t/ {
        Wish $this is labelled $t
    }
}
Claim 45005 has demo code {
    When the clock time is /t/ {
        Wish $this draws a circle offset [list expr {sin($t) * 50} 0]
    }
}
Claim 45006 has demo code {
    Wish $this is outlined blue
    When $this points up at /p/ {
        Wish $this is labelled "Pointing at $p"
        Wish $p is labelled "and I am being pointed at"
    }
}
Claim 45007 has demo code {
    Wish $this is outlined red
    Wish $this is labelled "I am a program"
}
Claim 45008 has demo code {
    When $this has camera slice /slice/ {
    Wish $this displays camera slice $slice
    }
}
Claim 45009 has demo code {
    # Dock ruler.
    #
    # This page projects a dashed square (the "dock") just to the left
    # of its own AprilTag. Slide another program up to the dock so
    # that its AprilTag sits inside the square, and that tag gets
    # registered as a piece of this program. The two most recently
    # docked tags (A and B) stay registered after they leave the dock:
    # wherever they go on the table, we draw a dashed line between
    # them and report the distance between their centers in mm.

    set dockSize 0.06 ;# side length of the dock square, in meters
    set dockGap 0.01 ;# gap between the dock and the left edge of this page

    Wish $this is outlined white
    Wish $this is labelled "Dock ruler\ndock two tags, then move them apart"

    When the quad library is /quadLib/ &\
         the pose library is /poseLib/ &\
         the quad changer is /quadChange/ &\
         display /disp/ has width /w/ height /h/ &\
         display /disp/ has intrinsics /intr/ {

        fn quadChange

        # The dock: draw it, and register any AprilTag that enters it.
        When $this has quad /q/ & $this has resolved geometry /geom/ {
            set q [quadChange $q "display $disp"]

            # Dock rectangle in page coordinates (meters from the
            # top-left corner of this page), level with our own tag.
            set x1 [expr {-$dockGap}]
            set x0 [expr {$x1 - $dockSize}]
            set yc [expr {[dict get $geom top] + [dict get $geom tagSize] / 2.0}]
            set y0 [expr {$yc - $dockSize / 2.0}]
            set y1 [expr {$yc + $dockSize / 2.0}]

            set dockPx [lmap xy [list [list $x0 $y0] [list $x1 $y0] \
                                     [list $x1 $y1] [list $x0 $y1] \
                                     [list $x0 $y0]] {
                $poseLib project $intr $w $h [$quadLib xyToPoint $q $xy]
            }]
            Wish to draw a dashed line onto $disp with \
                points $dockPx width 3 color white dashlength 10

            # Caption under the dock, reading the same way as this page.
            lassign [lrange $dockPx 2 3] bottomRightPx bottomLeftPx
            set right [vec2 sub $bottomRightPx $bottomLeftPx]
            Wish to draw text onto $disp with \
                position [vec2 scale [vec2 add $bottomLeftPx $bottomRightPx] 0.5] \
                scale 22 anchor top text "dock" color white \
                radians [expr {-atan2([lindex $right 1], [lindex $right 0])}]

            When tag /tag/ has quad /tq/ {
                if {$tag eq $this} { return }

                set center [$quadLib centroid [quadChange $tq "display $disp"]]
                lassign [$quadLib pointToXY $q $center] x y
                if {$x < $x0 || $x > $x1 || $y < $y0 || $y > $y1} { return }

                # A tag is sitting in the dock: light the dock up.
                Wish to draw a line onto $disp with \
                    points $dockPx width 6 color green layer 1

                # Register it, keeping only the two newest pieces.
                set pieces [list]
                foreach result [Query! $this has dock pieces /pieces/] {
                    set pieces [dict get $result pieces]
                }
                if {[lsearch -exact $pieces $tag] < 0} {
                    lappend pieces $tag
                    Hold! -key dock-pieces \
                        Claim $this has dock pieces [lrange $pieces end-1 end]
                }
            }
        }

        # The ruler: mark the registered tags and measure between them.
        When $this has dock pieces /pieces/ & $this has quad /q/ {
            # Direction of this page's top edge on the display, so that
            # our text reads the same way as the page does.
            lassign [lmap v [$quadLib vertices [quadChange $q "display $disp"]] {
                $poseLib project $intr $w $h $v
            }] topLeftPx topRightPx
            set pageRight [vec2 sub $topRightPx $topLeftPx]
            set pageRadians [expr {-atan2([lindex $pageRight 1], [lindex $pageRight 0])}]

            foreach piece $pieces name {A B} color {gold skyblue} {
                if {$piece eq ""} { continue }
                When tag $piece has quad /tq/ {
                    # Ring around the tag. Tags are blacked out on the
                    # display out to ~2x their size (so that the
                    # camera can still see them), so draw outside that.
                    set ring [$quadLib scale [quadChange $tq "display $disp"] 2.6]
                    set ringPx [lmap v [$quadLib vertices $ring] {
                        $poseLib project $intr $w $h $v
                    }]
                    Wish to draw a line onto $disp with \
                        points [list {*}$ringPx [lindex $ringPx 0]] \
                        width 4 color $color

                    lassign $ringPx tl tr
                    Wish to draw text onto $disp with \
                        position [vec2 scale [vec2 add $tl $tr] 0.5] \
                        scale 30 anchor bottom text $name color $color \
                        radians $pageRadians
                }
            }

            if {[llength $pieces] < 2} { return }
            lassign $pieces a b
            When tag $a has quad /qa/ & tag $b has quad /qb/ {
                # Tag centers in display space, which is in meters.
                set ca [$quadLib centroid [quadChange $qa "display $disp"]]
                set cb [$quadLib centroid [quadChange $qb "display $disp"]]
                lassign $ca ax ay az
                lassign $cb bx by bz
                set mm [expr {1000.0 * sqrt(($bx-$ax)*($bx-$ax) +
                                            ($by-$ay)*($by-$ay) +
                                            ($bz-$az)*($bz-$az))}]

                set pa [$poseLib project $intr $w $h $ca]
                set pb [$poseLib project $intr $w $h $cb]
                if {[vec2 distance $pa $pb] < 1} { return }

                Wish to draw a dashed line onto $disp with \
                    points [list $pa $pb] width 4 color white dashlength 12

                # Distance report at the midpoint, running along the
                # line (flipped if needed so it isn't upside down
                # relative to this page) and sitting just above it.
                set dir [vec2 normalize [vec2 sub $pb $pa]]
                if {[vec2 dot $dir $pageRight] < 0} {
                    set dir [vec2 scale $dir -1]
                }
                lassign $dir dx dy
                set up [list $dy [expr {-$dx}]]
                Wish to draw text onto $disp with \
                    position [vec2 add [vec2 scale [vec2 add $pa $pb] 0.5] \
                                  [vec2 scale $up 10]] \
                    scale 36 anchor bottom color white \
                    text [format "%.0f mm" $mm] \
                    radians [expr {-atan2($dy, $dx)}]
            }
        }
    }
}
