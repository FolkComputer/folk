# Display discovery shares the renderer's instance and physical device.
When the GPU library is /gpuLib/ {
set cc [C]
$cc cflags -I./vendor
$cc code {
    #define VOLK_IMPLEMENTATION
    #include "volk/volk.h"
    static VkFence hotplugFence;
}
$cc extend $gpuLib

$cc proc initEnumeration {} void {
    volkInitialize();
    volkLoadInstanceOnly(*instance_ptr());
    volkLoadDevice(*device_ptr());
}
$cc proc stopHotplug {} void {
    if (hotplugFence != VK_NULL_HANDLE) {
        vkDestroyFence(*device_ptr(), hotplugFence, NULL);
        hotplugFence = VK_NULL_HANDLE;
    }
}
$cc proc armHotplug {} bool {
    if (!*supportsDisplayControl_ptr()) return false;
    VkDeviceEventInfoEXT info = {0};
    info.sType = VK_STRUCTURE_TYPE_DEVICE_EVENT_INFO_EXT;
    info.deviceEvent = VK_DEVICE_EVENT_TYPE_DISPLAY_HOTPLUG_EXT;
    VkFence next = VK_NULL_HANDLE;
    VkResult res = vkRegisterDeviceEventEXT(*device_ptr(), &info, NULL, &next);
    // Register before rescanning so changes during enumeration are not missed.
    if (hotplugFence != VK_NULL_HANDLE) vkDestroyFence(*device_ptr(), hotplugFence, NULL);
    hotplugFence = res == VK_SUCCESS ? next : VK_NULL_HANDLE;
    if (res != VK_SUCCESS) {
        fprintf(stderr, "gpu/enumerate: hotplug registration failed (%d); polling instead\n", res);
    }
    return res == VK_SUCCESS;
}
$cc proc hotplugged {} bool {
    VkResult res = vkGetFenceStatus(*device_ptr(), hotplugFence);
    if (res == VK_NOT_READY) return false;
    if (res != VK_SUCCESS) FOLK_ERROR("Hotplug fence failed: %s (%d)", VkResultToString(res), res);
    return true;
}
$cc proc enumerateDisplays {} Jim_Obj* {
    if (!*supportsDisplay_ptr()) return Jim_NewListObj(interp, NULL, 0);
    Jim_Obj *allDisplaysList = Jim_NewListObj(interp, NULL, 0);
    VkResult res;

    // Use the same physical device as rendering.
    {
        VkPhysicalDevice physicalDevice = *physicalDevice_ptr();

        uint32_t displayCount;
        if ((res = vkGetPhysicalDeviceDisplayPropertiesKHR(physicalDevice, &displayCount, NULL)) != VK_SUCCESS) goto failed;

        VkDisplayPropertiesKHR displayProps[displayCount ? displayCount : 1];
        if ((res = vkGetPhysicalDeviceDisplayPropertiesKHR(physicalDevice, &displayCount, displayProps)) != VK_SUCCESS) goto failed;

        for (uint32_t i = 0; i < displayCount; i++) {
            uint32_t modeCount;
            if ((res = vkGetDisplayModePropertiesKHR(physicalDevice, displayProps[i].display,
                                          &modeCount, NULL)) != VK_SUCCESS) goto failed;

            VkDisplayModePropertiesKHR modeProps[modeCount ? modeCount : 1];
            if ((res = vkGetDisplayModePropertiesKHR(physicalDevice, displayProps[i].display,
                                          &modeCount, modeProps)) != VK_SUCCESS) goto failed;
            if (modeCount == 0) continue;

            Jim_Obj *modesList = Jim_NewListObj(interp, NULL, 0);
            for (uint32_t j = 0; j < modeCount; j++) {
                Jim_Obj *modeDict = Jim_ObjPrintf("visibleRegion {%u %u} refreshRate %u",
                    modeProps[j].parameters.visibleRegion.width,
                    modeProps[j].parameters.visibleRegion.height,
                    modeProps[j].parameters.refreshRate);
                Jim_ListAppendElement(interp, modesList, modeDict);
            }

            int modesLen;
            const char *modesStr = Jim_GetString(modesList, &modesLen);
            Jim_Obj *displayDict = Jim_ObjPrintf("name {%s} physicalDimensions {%u %u} "
                                                 "physicalResolution {%u %u} modes {%s}",
                displayProps[i].displayName ? displayProps[i].displayName : "",
                displayProps[i].physicalDimensions.width,
                displayProps[i].physicalDimensions.height,
                displayProps[i].physicalResolution.width,
                displayProps[i].physicalResolution.height,
                modesStr);

            Jim_ListAppendElement(interp, allDisplaysList, displayDict);
        }
    }

    return allDisplaysList;
failed:
    Jim_FreeNewObj(interp, allDisplaysList);
    FOLK_ERROR("Display enumeration failed: %s (%d)", VkResultToString(res), res);
}

set displayLib [$cc compile]
$displayLib initEnumeration
On unmatch [list $displayLib stopHotplug]

if {[$gpuLib getSupportsGlfw]} {
    Claim $::thisNode has display glfw with info {name "GLFW (windowed)"}
}

# Arm before the first scan. Without the extension, rescan once per second.
set hotplug [$displayLib armHotplug]
set previousDisplays {}
set generation 0
set rescan true
while true {
    if {$rescan} {
        try {
            set displays [lmap display [$displayLib enumerateDisplays] {
                # Even an off/on cycle with identical modes invalidates surfaces.
                dict set display generation $generation
                set display
            }]
            if {$displays ne $previousDisplays} {
                Hold! -key displays {
                    foreach display $displays {
                        Claim $::thisNode has display $display(name) with info $display
                    }
                }
                set previousDisplays $displays
            }
            set rescan false
        } on error e {
            puts stderr "gpu/enumerate: $e; retrying"
            after 1000
        }
    }
    if {$hotplug} {
        after 100
        try {
            if {[$displayLib hotplugged]} {
                set hotplug [$displayLib armHotplug]
                incr generation
                set rescan true
            }
        } on error e {
            puts stderr "gpu/enumerate: $e; polling instead"
            $displayLib stopHotplug
            set hotplug false
            incr generation
            set rescan true
        }
    } else {
        after 1000
        set rescan true
    }
}
}
