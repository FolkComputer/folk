set trieLib [apply [fn {} {
    set cc [dict link $C {}]
    cc::addcflags -I. trie.o
    cc::include <stdlib.h>
    cc::include <string.h>
    cc::include "trie.h"
    cc::addcap Trie /trie-pointer
    cc::addcode {
        typedef struct Db Db;
        extern Db* db;

        extern void dbLockClauseToStatementRef(Db* db);
        extern void dbUnlockClauseToStatementRef(Db* db);
        extern Trie* dbGetClauseToStatementRef(Db* db);

#ifdef TRACY_ENABLE

#include <string.h>
void *tmalloc(size_t sz) {
    void *ptr = malloc(sz);
    TracyCAllocS(ptr, sz, 4);
    return ptr;
}
void *tcalloc(size_t s1, size_t s2) {
    void *ptr = calloc(s1, s2);
    TracyCAllocS(ptr, s1 * s2, 4);
    return ptr;
}
char *tstrdup(const char *s0) {
    int sz = strlen(s0) + 1;
    char *s = tmalloc(sz);
    memcpy(s, s0, sz);
    return s;
}
void tfree(void *ptr) {
    TracyCFreeS(ptr, 4);
    free(ptr);
}

#else

#define tmalloc malloc
#define tcalloc calloc
#define tstrdup strdup
#define tfree free

#endif

        static void trieRetireValue(Zicl_Object* obj) {
            Zicl_DropRef(Zicl_BoxObject(obj));
        }
        static const TrieAllocator trieAllocator = {
            .alloc = tmalloc,
            .retire = tfree,
            .retireValue = trieRetireValue,
        };

        static Zicl_List* jimObjToClause(Zicl_Interp* interp, Zicl_Value clauseObj) {
            Zicl_List* list; folkZiclAssert(Zicl_DupAsList(interp, clauseObj, &list));
            return list;
        }
    }
    cc::proc tclify {Trie* trie} Zicl_Value {
        int objc = 3 + trie->branchesCount;
        Zicl_Value objv[objc];
        folkZiclAssert(Zicl_NewStringFormatted(&objv[0], "x%" PRIxPTR, (uintptr_t) trie));
        if (Zicl_AsPtr(trie->key)) {
            folkZiclAssert(Zicl_NewStringFormatted(&objv[1], "%s", ziclString(trie->key)));
        } else {
            folkZiclAssert(Zicl_NewStringFormatted(&objv[1], "ROOT"));
        }
        if (trie->hasValue) {
            folkZiclAssert(Zicl_NewStringFormatted(&objv[2], "%" PRIu64, trie->value));
        } else {
            folkZiclAssert(Zicl_NewStringFormatted(&objv[2], "NULL"));
        }
        for (int i = 0; i < trie->branchesCount; i++) {
            // HACK: const isn't supported yet, so have to cast.
            objv[3+i] = trie->branches[i] ? tclify((Trie *)trie->branches[i]) : ziclNewString("", 0);
        }
        Zicl_Value result = Zicl_BoxList(ziclNewList(objv, objc));
        for (int i = 0; i < objc; i++) Zicl_DropRef(objv[i]);
        return result;
    }
    cc::proc dbTrieTclify {} Zicl_Value {
        dbLockClauseToStatementRef(db);
        Trie* trie = dbGetClauseToStatementRef(db);
        Zicl_Value ret = tclify(trie);
        dbUnlockClauseToStatementRef(db);
        return ret;
    }
    cc::proc new {} Trie* {
        return (Trie *)trieNew();
    }
    cc::proc add {Trie@ trie Zicl_Value patternObj uint64_t value} Trie@ {
        Zicl_List* pattern = jimObjToClause(interp, patternObj);
        const Trie* result = trieAdd(trie.ptr, &trieAllocator, pattern, value);
        Zicl_DropRefList(pattern);
        if (result == trie.ptr) {
            // trieAdd is a no-op when the clause is already present (see its
            // own comment): the returned pointer is byte-identical to the
            // input, so propagate the input's capability instead of minting
            // a new, unrelated one.
            return (Trie_capPair){ .ptr = (Trie*)result, .cap = trie.cap };
        }
        return (Trie_capPair){ .ptr = (Trie*)result };  // .cap left zero -> mint fresh
    }
    cc::proc lookup {Trie* trie Zicl_Value patternObj} Zicl_Value {
        uint64_t results[50];
        Zicl_List* pattern = jimObjToClause(interp, patternObj);
        int resultCount = trieLookup(trie, pattern, results, 50);
        Zicl_DropRefList(pattern);

        Zicl_Value resultObjs[resultCount];
        for (int i = 0; i < resultCount; i++) {
            resultObjs[i] = Zicl_NewLong(results[i]);
        }

        Zicl_Value result = Zicl_BoxList(ziclNewList(resultObjs, resultCount));
        for (int i = 0; i < resultCount; i++) Zicl_DropRef(resultObjs[i]);
        return result;
    }
    cc::proc remove_ {Trie* trie Zicl_Value patternObj} Trie* {
        uint64_t results[50];
        Zicl_List* pattern = jimObjToClause(interp, patternObj);
        int resultCount;
        trie = (Trie *)trieRemove(trie, &trieAllocator,
                                  pattern, results, 50, &resultCount);
        Zicl_DropRefList(pattern);
        return trie;
    }

    return [cc::compile]
}]]

set trieDotify {{trieLib tclifiedTrie} {
    fn idify {word} {
        # generate id-able word by eliminating all non-alphanumeric
        regsub -all {\W+} $word "_"
    }
    fn labelify {word} {
        # shorten the longest lines
        set word [join [lmap line [split $word "\n"] {
            expr { [string length $line] > 80 ? "[string range $line 0 80]..." : $line }
        }] "\n"]
        string map {"\"" "\\\""} [string map {"\\" "\\\\"} $word]
    }
    fn subdot {subtrie} {
        set branches [lassign $subtrie ptr key id]

        set dot [list]
        lappend dot "$ptr \[label=\"[labelify $key]\"\];"
        foreach branch $branches {
            if {$branch eq {}} continue
            set branchptr [lindex $branch 0]
            lappend dot "$ptr -> $branchptr;"
            lappend dot [subdot $branch]
        }
        return [join $dot "\n"]
    }
    return "digraph { rankdir=LR; [subdot $tclifiedTrie] }"
}}

set getDotAsPdf {{dot} {
    set fd [file open |[list dot -Tpdf <<$dot] rb]
    set response [stream read $fd]
    try {
        close $fd
        return $response
    } on error e {
        if {[catch {exec which dot}] != 0} {
            error "graphviz not installed!"
        }
    }
}}

Wish the web server handles route {/trie-graph\.pdf} with handler {
    set trie []
    set dot [apply $trieDotify $trieLib [trieLib::dbTrieTclify]]

    dict create statusAndHeaders "HTTP/1.1 200 OK
Connection: close
Content-Type: application/pdf

" \
        body [apply $getDotAsPdf $dot]
}
