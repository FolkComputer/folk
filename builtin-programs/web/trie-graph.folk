set trieLib [apply [fn {} {
    set cc [dict link $C {}]
    cc::cflags -I. trie.o
    cc::include <stdlib.h>
    cc::include <string.h>
    cc::include "trie.h"
    cc::code {
        typedef struct Db Db;
        extern Db* db;

        extern void dbLockClauseToStatementRef(Db* db);
        extern void dbUnlockClauseToStatementRef(Db* db);
        extern Trie* dbGetClauseToStatementRef(Db* db);

#ifdef TRACY_ENABLE

#include <string.h>
void *tmalloc(size_t sz) {
    void *ptr = malloc(sz);
    TracyCAllocS(ptr, sz, 4);
    return ptr;
}
void *tcalloc(size_t s1, size_t s2) {
    void *ptr = calloc(s1, s2);
    TracyCAllocS(ptr, s1 * s2, 4);
    return ptr;
}
char *tstrdup(const char *s0) {
    int sz = strlen(s0) + 1;
    char *s = tmalloc(sz);
    memcpy(s, s0, sz);
    return s;
}
void tfree(void *ptr) {
    TracyCFreeS(ptr, 4);
    free(ptr);
}

#else

#define tmalloc malloc
#define tcalloc calloc
#define tstrdup strdup
#define tfree free

#endif

        static void trieRetireObj(Zicl_Obj* obj) {
            Zicl_DropRef(Zicl_BoxObject(obj));
        }
        static const TrieAllocator trieAllocator = {
            .alloc = tmalloc,
            .retire = tfree,
            .retireObj = trieRetireObj,
        };

        static Zicl_List* valueToClause(Zicl_Interp* interp, Zicl_Val clauseObj) {
            Zicl_List* list; folkZiclAssert(Zicl_DupAsList(interp, clauseObj, &list));
            return list;
        }
    }
    cc::objtype Trie {
        typedef struct TrieCap {
            Zicl_CapHead head;
            Trie* trie;
        } TrieCap;

        static void trieFree(Trie* trie) {
            if (trie == NULL) return;
            for (int i = 0; i < trie->branchesCount; i++) {
                if (trie->branches[i] != NULL) {
                    trieFree((Trie*)trie->branches[i]);
                }
            }
            if (Zicl_AsObj(trie->key)) trieRetireObj(Zicl_AsObj(trie->key));
            tfree(trie);
        }

        static void Trie_deinitBody(Zicl_CapHead* head) {
            TrieCap* cap = Zicl_ContainerOf(head, TrieCap, head);
            trieFree(cap->trie);
            cap->trie = NULL;
        }

        static void Trie_destroyBacking(Zicl_CapHead* head) {
            free(Zicl_ContainerOf(head, TrieCap, head));
        }

        static const Zicl_CapHeadVTable Trie_vtable = {
            .name = "trie-pointer",
            .deinit_body = Trie_deinitBody,
            .destroy_backing = Trie_destroyBacking,
        };
        const Zicl_CapHeadVTable* Trie_VTable = &Trie_vtable;

        static inline TrieCap* Trie_resolve(Zicl_Interp* interp, Zicl_Shim* shim) {
            Zicl_CapHead* head = NULL;
            __ENSURE_OK(Zicl_ResolveCap(interp, shim, Trie_VTable, &head));
            __defer(__capDropInFlight, head);
            return Zicl_ContainerOf(head, TrieCap, head);
        }

        static inline Zicl_Val Trie_wrap(Trie* trie) {
            TrieCap* cap = (TrieCap*) malloc(sizeof(TrieCap));
            memset(&cap->head, 0, sizeof(cap->head));
            cap->head.vtable = Trie_VTable;
            cap->trie = trie;
            Zicl_Val out;
            folkZiclAssert(Zicl_CapNewOwning(&cap->head, &out));
            return out;
        }
    }
    cc::argtype Trie* {
        Trie* $argname = Trie_resolve(interp, $shim)->trie;
    }
    cc::rtype Trie* {
        $robj = Trie_wrap($rvalue);
    }
    cc::proc tclify {Trie* trie} Zicl_Val {
        int objc = 3 + trie->branchesCount;
        Zicl_Val objv[objc];
        folkZiclAssert(Zicl_NewStringFormatted(&objv[0], "x%" PRIxPTR, (uintptr_t) trie));
        if (Zicl_AsObj(trie->key)) {
            folkZiclAssert(Zicl_NewStringFormatted(&objv[1], "%s", ziclString(trie->key)));
        } else {
            folkZiclAssert(Zicl_NewStringFormatted(&objv[1], "ROOT"));
        }
        if (trie->hasValue) {
            folkZiclAssert(Zicl_NewStringFormatted(&objv[2], "%" PRIu64, trie->value));
        } else {
            folkZiclAssert(Zicl_NewStringFormatted(&objv[2], "NULL"));
        }
        for (int i = 0; i < trie->branchesCount; i++) {
            // HACK: const isn't supported yet, so have to cast.
            objv[3+i] = trie->branches[i] ? tclify((Trie *)trie->branches[i]) : ziclNewString("", 0);
        }
        Zicl_Val result = Zicl_BoxList(ziclNewList(objv, objc));
        for (int i = 0; i < objc; i++) Zicl_DropRef(objv[i]);
        return result;
    }
    cc::proc dbTrieTclify {} Zicl_Val {
        dbLockClauseToStatementRef(db);
        Trie* trie = dbGetClauseToStatementRef(db);
        Zicl_Val ret = tclify(trie);
        dbUnlockClauseToStatementRef(db);
        return ret;
    }
    cc::proc new {} Trie* {
        return (Trie *)trieNew();
    }
    cc::proc add {Zicl_Shim* trieShim Zicl_Val patternObj uint64_t value} Zicl_Val {
        TrieCap* cap = Trie_resolve(interp, trieShim);
        Zicl_List* pattern = valueToClause(interp, patternObj);
        const Trie* result = trieAdd(cap->trie, &trieAllocator, pattern, value);
        Zicl_DropRefList(pattern);
        if (result == cap->trie) {
            // trieAdd is a no-op when the clause is already present (see its
            // own comment): the returned pointer is byte-identical to the
            // input, so propagate the input's capability instead of minting
            // a new, unrelated one.
            return Zicl_Ref(Zicl_Current(trieShim));
        }
        cap->trie = NULL;
        Zicl_CapClose(&cap->head);
        return Trie_wrap((Trie*)result);
    }
    cc::proc lookup {Trie* trie Zicl_Val patternObj} Zicl_Val {
        uint64_t results[50];
        Zicl_List* pattern = valueToClause(interp, patternObj);
        int resultCount = trieLookup(trie, pattern, results, 50);
        Zicl_DropRefList(pattern);

        Zicl_Val resultObjs[resultCount];
        for (int i = 0; i < resultCount; i++) {
            resultObjs[i] = Zicl_NewLong(results[i]);
        }

        Zicl_Val result = Zicl_BoxList(ziclNewList(resultObjs, resultCount));
        for (int i = 0; i < resultCount; i++) Zicl_DropRef(resultObjs[i]);
        return result;
    }
    cc::proc remove_ {Zicl_Shim* trieShim Zicl_Val patternObj} Zicl_Val {
        TrieCap* cap = Trie_resolve(interp, trieShim);
        uint64_t results[50];
        Zicl_List* pattern = valueToClause(interp, patternObj);
        int resultCount;
        const Trie* result = trieRemove(cap->trie, &trieAllocator,
                                        pattern, results, 50, &resultCount);
        Zicl_DropRefList(pattern);
        if (result == cap->trie) {
            return Zicl_Ref(Zicl_Current(trieShim));
        }
        cap->trie = NULL;
        Zicl_CapClose(&cap->head);
        return Trie_wrap((Trie*)result);
    }

    return [cc::compile]
}]]

fn trieLabelify {word} {
    # shorten the longest lines
    set word [join [lmap line [split $word "\n"] {
        expr { [string length $line] > 80 ? "[string range $line 0 80]..." : $line }
    }] "\n"]
    string map {"\"" "\\\""} [string map {"\\" "\\\\"} $word]
}
fn trieDotify {trieLib tclifiedTrie} {
    set dot [list]
    set stack [list $tclifiedTrie]
    while {[llength $stack] > 0} {
        set item [lindex $stack end]
        set stack [lrange $stack 0 end-1]

        set branches [lassign $item ptr key id]
        lappend dot "$ptr \[label=\"[trieLabelify $key]\"\];"
        foreach branch $branches {
            if {$branch eq {}} continue
            set branchptr [lindex $branch 0]
            lappend dot "$ptr -> $branchptr;"
            lappend stack $branch
        }
    }
    return "digraph { rankdir=LR; [join $dot "\n"] }"
}

fn getDotAsPdf {dot} {
    set inPath "/tmp/folk-trie-[pid].dot"
    set outPath "/tmp/folk-trie-[pid].pdf"
    set fd [file open $inPath w]
    stream write $fd $dot
    close $fd
    try {
        exec dot -Tpdf -o $outPath $inPath
        set fd [file open $outPath r]
        set response [stream read $fd]
        close $fd
        return $response
    } on error e {
        if {[catch {exec which dot}] != 0} {
            error "graphviz not installed!"
        }
        error $e
    } finally {
        file delete -force $inPath
        file delete -force $outPath
    }
}

Wish the web server handles route {/trie-graph\.pdf} with handler [fn {args} {
    set trie []
    set dot [trieDotify $trieLib [trieLib::dbTrieTclify]]

    dict create statusAndHeaders "HTTP/1.1 200 OK
Connection: close
Content-Type: application/pdf

" \
        body [getDotAsPdf $dot]
}]
