try {

puts "web: [__threadId] (PID [pid])"

set ws [import "lib/ws.tcl"]
Claim the websocket library is $ws
dict assign $ws wsUpgradeHandshake wsReadMsg wsSend


fn htmlLib::htmlEscape {s} {
    string map {& "&amp;" < "&lt;" > "&gt;" "\"" "&quot;"} $s
}

fn htmlLib::html {body} {
    dict create statusAndHeaders "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/html; charset=utf-8\r\n\r\n" body $body
}

fn htmlLib::json {body} {
    dict create statusAndHeaders "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: application/json; charset=utf-8\r\n\r\n" body $body
}

fn htmlLib::HtmlWhen {args} {
    set callbacks [dict create]
    set pattern [list]
    for {set i 0} {$i < [llength $args]} {incr i} {
        set arg [lindex $args $i]
        if {$arg in [list "-beforeNodeAdded" "-afterNodeAdded" "-beforeNodeMorphed" \
                         "-afterNodeMorphed" "-beforeNodeRemoved" "-afterNodeRemoved" \
                         "-beforeAttributeUpdated"]} {
            incr i
            dict set callbacks [string range $arg 1 end] \
                [lindex $args $i]
        } else {
            lappend pattern $arg
        }
    }

    set body [lindex $pattern end]
    set pattern [lreplace $pattern end end]

    set sourceInfo [info source $body]
    set prologue {dict assign -all [lindex $args 0]}
    set render [uplevel 1 [info source [list fn args "$prologue;$body"] {*}$sourceInfo]]

    # Retract when the page is closed.
    if {[lrange $pattern 0 3] eq "the collected results for"} {
        set resultsVar [__scanVariable [lindex $pattern 6]]
        set whenBody [eval [list fn args "
            set htmls \[list\]
            lappend htmls \[render \[dict create $resultsVar \[lindex \$args 0\]\]\]
            Notify: the html for {$pattern} is \[join \$htmls \\n\]
        "]]
        Assert! when {*}$pattern $whenBody
    } else {
        set whenBody [eval [list fn args "
            set htmls \[list\]
            foreach result \[lindex \$args 0\] {
                lappend htmls \[render \$result\]
            }
            Notify: the html for {$pattern} is \[join \$htmls \\n\]
        "]]
        Assert! when the collected results for {*}$pattern are /results/ $whenBody
    }

    set htmls [list]
    # HACK: ForEach! won't work on collection since the When when ->
    # creating wish doesn't exist.
    if {[lrange $pattern 0 3] eq "the collected results for"} {
        set results [Query! {*}[lindex $pattern 4]]
        set resultsVar [__scanVariable [lindex $pattern 6]]
        lappend htmls [render [dict create $resultsVar $results]]
    } else {
        ForEach! {*}$pattern {
            lappend htmls [render $__result]
        }
    }

    set callbacksJs [join [lmap {callbackName callback} $callbacks {
        subst {$callbackName: $callback}
    }] ,]
    return [subst {
        <div style="display: contents;">[join $htmls \n]</div>
        <script>
        (function() {
          const el = document.currentScript.previousElementSibling;
          const callbacks = {$callbacksJs};
          folk.subscribe(`the html for {$pattern} is /html/`, ({html}) => {
            if (window.Idiomorph) {
              Idiomorph.morph(el, html, {morphStyle:'innerHTML', callbacks:callbacks});
            } else {
              el.innerHTML = html;
            }
          });
        })();
        </script>
    }]
}

Claim the html library is $htmlLib
dict assign $htmlLib htmlEscape html json

fn readFile {filename contentTypeVar} {
    upvar $contentTypeVar contentType
    set fd [file open $filename rb]
    set response [stream read $fd]; close $fd; return $response
}

fn headerGet {headers name args} {
    foreach {k v} $headers {
        if {[string equal -nocase $k $name]} { return $v }
    }

    if {[llength $args] > 0} { return [lindex $args 0] }
    error "missing HTTP header $name"
}

fn parseQueryString {queryString} {
    set QUERY [dict create]
    if {$queryString eq ""} { return $QUERY }

    set queryString [string range $queryString 1 end]
    foreach pair [split $queryString &] {
        if {[regexp {^([^=]*)=(.*)$} $pair -> key value]} {
            # URL decode key and value.
            regsub -all {\+} $key { } key
            regsub -all {%([0-9A-Fa-f]{2})} $key {[format %c 0x\1]} key
            set key [subst $key]

            regsub -all {\+} $value { } value
            regsub -all {%([0-9A-Fa-f]{2})} $value {[format %c 0x\1]} value
            set value [subst $value]

            dict set QUERY $key $value
        }
    }
    return $QUERY
}

fn handlePage {path httpStatusVar contentTypeVar} {
    upvar $contentTypeVar contentType
    switch -exact -- $path {
        "/favicon.ico" {
            set contentType "image/x-icon"
            readFile "assets/favicon.ico" contentType
        }
        "/style.css" {
            set contentType "text/css"
            readFile "assets/style.css" contentType
        }
        "/lib/folk.js" {
            set contentType "text/javascript"
            readFile "lib/folk.js" contentType
        }
        "/vendor/idiomorph.js" {
            set contentType "text/javascript"
            readFile "vendor/idiomorph.js" contentType
        }
        default {
            upvar $httpStatusVar httpStatus
            set httpStatus "HTTP/1.1 404 Not Found"
            subst {
                <html>
                <b>$path</b> Not found.
                </html>
            }
        }
    }
}

fn handleConnection {chan} {
    try {
        set line [string trimright [stream gets $chan] "\r"]
        set firstline $line

        set headers [list]
        while true {
            set line [string trimright [stream gets $chan] "\r"]
            if {$line eq ""} { break }

            if {[regexp {^([^\s:]+)\s*:\s*(.+)} $line -> k v]} {
                lappend headers $k $v
            } else {
                break
            }
        }

        if {[regexp {GET ([^ ]*) HTTP/1.1} $firstline -> path] && $path ne "/ws"} {
            set response {}
            try {
                ForEach! /someone/ wishes the web server handles route /route/ with /...options/ {
                    set handler [dict get $options handler]
                    set vars [regexp -inline ^${route}(\\?.*)?$ $path]
                    if {[llength $vars] > 0} {
                        set queryString [lindex $vars end]
                        set QUERY [parseQueryString $queryString]
                        set vars [lrange $vars 0 end-1]
                        while {[llength $vars] < 10} { lappend vars "" }

                        set response [handler {*}$vars $QUERY]
                        break
                    }
                }
                if {$response eq ""} {
                    set httpStatus "HTTP/1.1 200 OK"
                    set contentType "text/html; charset=utf-8"
                    set body [handlePage $path httpStatus contentType]
                    set response [dict create statusAndHeaders "$httpStatus\r\nConnection: close\r\nContent-Type: $contentType\r\n\r\n" body $body]
                }
                if {![dict exists $response statusAndHeaders]} {
                    error "Response not generated"
                }
            } on error {err opts} {
                set errorStack [expr {[dict exists $opts -errorstack] ?
                                      [dict get $opts -errorstack] : {}}]
                set src [lindex $errorStack 1]
                stream write $realStderr "Web error in $src ($path): $err\n  [errorInfoFor $err $opts]\n"

                set contentType "text/html; charset=utf-8"
                set body [subst {
                    <html>
                    <head>
                    <title>folk: 500 Internal Server Error</title>
                    </head>
                    <body>
                    <pre>[htmlEscape $err]:
[htmlEscape [errorInfoFor $err $opts]]</pre>
                    </body>
                    </html>
                }]
                set response [dict create statusAndHeaders "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Type: $contentType\r\n\r\n" body $body]
            }
            stream write $chan [dict get $response statusAndHeaders]
            if {[dict exists $response body]} {
                stream write $chan [dict get $response body]
            }
            close $chan

        } elseif {[regexp {POST ([^ ]*) HTTP/1.1} $firstline -> path]} {
            set httpStatus "HTTP/1.1 200 OK"
            set contentType "text/plain; charset=utf-8"
            stream write $chan "$httpStatus\r\nConnection: close\r\nContent-Type: $contentType\r\n\r\n"

            set contentLength [headerGet $headers Content-Length 0]
            set body ""
            if {$contentLength > 0} {
                set body [stream read $chan $contentLength]
            }
            try {
                stream write $chan [eval $body]
            } on error e {
                stream write $chan "Error: $e"
            }
            close $chan

        } elseif {[info exists path] && $path eq "/ws"} {
            set clientKey [headerGet $headers Sec-WebSocket-Key ""]
            if {$clientKey eq ""} {
                stream write $chan "HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nMissing Sec-WebSocket-Key\r\n"
                close $chan
                return
            }

            set acceptKey [wsUpgradeHandshake $clientKey]
            stream write $chan "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: $acceptKey\r\n\r\n"

            set this $chan
            set ctx $chan
            Assert! websocket $chan is connected
            try {
                while true {
                    set msg [wsReadMsg $chan]
                    set opcode [dict get $msg opcode]
                    if {$opcode eq "close"} {
                        break
                    } elseif {$opcode eq "text"} {
                        set text [dict get $msg payload]
                        try {
                            eval $text
                        } on error e {
                            stream write $realStderr "Web socket eval error: $e\n"
                        }
                    }
                }
            } on error e {
                # Client disconnected or read error.
            } finally {
                Retract! websocket $chan is connected
                try { close $chan } on error e {}
            }

        } else {
            close $chan
        }
    } on error {e opts} {
        stream write $realStderr "handleConnection uncaught error: $e\n[errorInfoFor $e $opts]\n"
    }
}



Subscribe: http client /client/ arrived {
    handleConnection $client
}

while true {
    try {
        set listener [socket listen 4273]
        break
    } on error e {
        # Handles failure to bind to :4273. We try again in a second.
        stream write $realStderr "web: $e\n"
        sleep 1
    }
}

while true {
    set client [socket accept $listener]
    stream write $realStderr "web: accepted client $client\n"
    Notify: http client $client arrived
}

} on error {e opts} {
    stream write $realStderr "WARNING: web.folk failed to initialize;
the web server is probably down; check /var/tmp/folk-[pid]/ for log files.
------------------------------------------
[errorInfoFor $e $opts]\n"
    return -code error -errorstack [dict get $opts -errorstack] $e
}
