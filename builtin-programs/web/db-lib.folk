Claim the db library is [apply [fn {} {
    set cc [dict link $C {}]
    cc::addcflags -I. -I./vendor/tracy/public
    cc::include "db.h"
    cc::include "common.h"
    cc::include "vendor/stb_ds.h"

    cc::addcode {
        typedef struct ListOfEdgeTo {
            size_t capacityEdges;
            size_t nEdges; // This is an estimate.
            uint64_t edges[];
        } ListOfEdgeTo;
        typedef struct GenRc {
            int16_t rc;

            int gen: 15;
            bool alive: 1;
        } GenRc;

        #include <pthread.h>
    }
    set dbCFd [fopen "db.c" r]; set dbC [read $dbCFd]; close $dbCFd
    cc::addcode [lindex [regexp -inline {typedef struct Destructor \{.*\} Destructor;} $dbC] 0]
    cc::addcode [lindex [regexp -inline {typedef struct DestructorSet \{.*\} DestructorSet;} $dbC] 0]
    cc::addcode [lindex [regexp -inline {typedef struct Statement \{.*\} Statement;} $dbC] 0]
    cc::addcode [lindex [regexp -inline {typedef struct Match \{.*\} Match;} $dbC] 0]
    cc::addcode [lindex [regexp -inline {typedef struct Hold \{.*\} Hold;} $dbC] 0]
    cc::addcode [lindex [regexp -inline {typedef struct StatementRefList \{.*\} StatementRefList;} $dbC] 0]
    cc::addcode [lindex [regexp -inline {typedef struct AtomicallyVersionList \{.*\} AtomicallyVersionList;} $dbC] 0]
    cc::addcode [lindex [regexp -inline {typedef struct AtomicallyVersion \{.*\} AtomicallyVersion;} $dbC] 0]
    cc::addcode [lindex [regexp -inline {typedef struct Atomically \{.*\} Atomically;} $dbC] 0]
    cc::addcode [lindex [regexp -inline {typedef struct Db \{.*\} Db;} $dbC] 0]
    cc::argtype StatementRef { StatementRef $argname; sscanf(ziclShimString($shim), "s%d:%d", &$argname.idx, &$argname.gen); }
    cc::argtype MatchRef { MatchRef $argname; sscanf(ziclShimString($shim), "m%d:%d", &$argname.idx, &$argname.gen); }

    cc::addcode {
        static Zicl_Value clauseToJimObj(Zicl_List* clause) {
            return Zicl_BoxList(Zicl_BorrowList(clause));
        }
    }

    cc::proc statementParentCount {Db* db StatementRef stmtRef} int {
        Statement* stmt = statementAcquire(db, stmtRef);
        if (stmt == NULL) { return -1; }
        int ret = stmt->parentCount;
        statementRelease(db, stmt);
        return ret;
    }
    cc::proc statementPtrCount {Db* db StatementRef stmtRef} int {
        Statement* stmt = statementAcquire(db, stmtRef);
        if (stmt == NULL) { return -1; }
        GenRc genRc = stmt->genRc;
        int ret = genRc.rc - 1;
        statementRelease(db, stmt);
        return ret;
    }
    cc::proc clause {Db* db StatementRef stmtRef} Zicl_Value {
        Statement* stmt = statementAcquire(db, stmtRef);
        if (stmt == NULL) { return ziclNewString("(null)", -1); }
        Zicl_Value ret = clauseToJimObj(statementClause(stmt));
        statementRelease(db, stmt);
        return ret;
    }
    cc::proc childMatches {Db* db StatementRef stmtRef} Zicl_Value {
        Statement* stmt = statementAcquire(db, stmtRef);
        if (stmt == NULL) { return ziclNewString("", 0); }

        pthread_mutex_lock(&stmt->childMatchesMutex);
        if (stmt->childMatches == NULL) {
            pthread_mutex_unlock(&stmt->childMatchesMutex);
            statementRelease(db, stmt);
            return ziclNewString("", 0);
        }

        Zicl_List* childList = ziclNewList(NULL, 0);
        for (int i = 0; i < stmt->childMatches->nEdges; i++) {
            MatchRef child = { .val = stmt->childMatches->edges[i] };
            Zicl_Value childStr;
            folkZiclAssert(Zicl_NewStringFormatted(&childStr, "m%d:%d", child.idx, child.gen));
            ziclListAppend(childList, childStr);
            Zicl_Release(childStr);
        }

        pthread_mutex_unlock(&stmt->childMatchesMutex);
        statementRelease(db, stmt);
        return Zicl_BoxList(childList);
    }

    cc::proc matchAcq {Db* db MatchRef matchRef} Match* {
        return matchAcquire(db, matchRef);
    }
    cc::proc matchRel {Db* db Match* match} void {
        matchRelease(db, match);
    }
    cc::proc matchPtrCount {Db* db MatchRef matchRef} int {
        Match* match = matchAcquire(db, matchRef);
        GenRc genRc = match->genRc;
        int ret = genRc.rc - 1;
        matchRelease(db, match);
        return ret;
    }
    cc::proc matchIsAlive {Db* db MatchRef matchRef} int {
        Match* match = matchAcquire(db, matchRef);
        GenRc genRc = match->genRc;
        int alive = genRc.alive;
        matchRelease(db, match);
        return alive;
    }
    cc::addcode {
        #define CHILD_STATEMENTS_REMOVING ((ListOfEdgeTo*)1)
    }
    cc::proc childStatements {Db* db MatchRef matchRef} Zicl_Value {
        Match* match = matchAcquire(db, matchRef);
        if (match == NULL) { return ziclNewString("", 0); }

        pthread_mutex_lock(&match->childStatementsMutex);
        if (match->childStatements == NULL ||
            match->childStatements == CHILD_STATEMENTS_REMOVING) {

            pthread_mutex_unlock(&match->childStatementsMutex);
            matchRelease(db, match);
            return ziclNewString("", 0);
        }

        Zicl_List* childList = ziclNewList(NULL, 0);
        for (int i = 0; i < match->childStatements->nEdges; i++) {
            StatementRef child = { .val = match->childStatements->edges[i] };
            Zicl_Value childStr;
            folkZiclAssert(Zicl_NewStringFormatted(&childStr, "s%d:%d", child.idx, child.gen));
            ziclListAppend(childList, childStr);
            Zicl_Release(childStr);
        }

        pthread_mutex_unlock(&match->childStatementsMutex);
        matchRelease(db, match);
        return Zicl_BoxList(childList);
    }

    cc::proc countAliveStatements {Db* db} int {
      int count = 0;
      for (int i = 1; i < 65536; i++) {  // slot 0 is reserved
        GenRc genRc = db->statementPool[i].genRc;
        if (genRc.alive) {
          count++;
        }
      }
      return count;
    }

    cc::proc holds {Db* db} Zicl_Value {
        Zicl_List* retList = ziclNewList(NULL, 0);

        mutexLock(&db->holdsMutex);
        for (int i = 0; i < shlen(db->holds); i++) {
            Hold* hold = &db->holds[i];

            Statement* stmt = statementAcquire(db, hold->statement);
            if (stmt == NULL) {
                fprintf(stderr, "db-lib: holds: WARNING: held statement on (%s) is invalid! (s%d:%d)\n",
                        hold->key, hold->statement.idx, hold->statement.gen);
                continue;
            }

            const char* clauseStr = ziclListString(statementClause(stmt));
            Zicl_Value keyStr = ziclNewString(hold->key, -1);
            Zicl_Value refStr;
            folkZiclAssert(Zicl_NewStringFormatted(&refStr, "s%d:%d", hold->statement.idx, hold->statement.gen));
            Zicl_Value clauseValStr = ziclNewString(clauseStr, -1);
            statementRelease(db, stmt);

            Zicl_Value holdItems[] = { keyStr, Zicl_NewLong(hold->version), refStr, clauseValStr };
            Zicl_Value holdVal = Zicl_BoxList(ziclNewList(holdItems, sizeof(holdItems)/sizeof(holdItems[0])));
            Zicl_Release(keyStr);
            Zicl_Release(refStr);
            Zicl_Release(clauseValStr);

            ziclListAppend(retList, holdVal);
            Zicl_Release(holdVal);
        }
        mutexUnlock(&db->holdsMutex);

        return Zicl_BoxList(retList);
    }

    cc::proc atomicallys {Db* db} Zicl_Value {
        Zicl_List* retList = ziclNewList(NULL, 0);

        mutexLock(&db->atomicallysMutex);
        for (int i = 0; i < sizeof(db->atomicallys)/sizeof(db->atomicallys[0]); i++) {
            Atomically* atomically = &db->atomicallys[i];
            if (atomically->key == NULL) { continue; }

            // Count versions in allVersions list
            int versionCount = 0;
            AtomicallyVersionList* vl = atomically->allVersions;
            while (vl != NULL) {
                versionCount++;
                vl = vl->next;
            }

            // Get latest converged version info
            int latestConvergedNumber = -1;
            if (atomically->latestConvergedVersion != NULL) {
                latestConvergedNumber = atomically->latestConvergedVersion->number;
            }

            Zicl_Value keyStr = ziclNewString(atomically->key, -1);
            Zicl_Value atomicallyItems[] = {
                keyStr,
                Zicl_NewLong(latestConvergedNumber),
                Zicl_NewLong(versionCount)
            };
            Zicl_Value atomicallyVal = Zicl_BoxList(ziclNewList(atomicallyItems, sizeof(atomicallyItems)/sizeof(atomicallyItems[0])));
            Zicl_Release(keyStr);

            ziclListAppend(retList, atomicallyVal);
            Zicl_Release(atomicallyVal);
        }
        mutexUnlock(&db->atomicallysMutex);

        return Zicl_BoxList(retList);
    }

    return [cc::compile]
}]]
