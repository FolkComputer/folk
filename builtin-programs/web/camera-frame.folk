When the jpeg library is /jpegLib/ {
    Wish the web server handles route {/camera-frame} with handler {
        set camera [dict getdef $QUERY camera /any/]
        ForEach! camera $camera has jpeg frame /jpeg/ at timestamp /any/ {
            set data [$jpegLib jpegData $jpeg]
            set fsize [string bytelength $data]
            break
        }
        if {![info exists data]} {
            error "camera-frame: No valid camera frame found (for $camera)"
        }

        dict create statusAndHeaders [join [list \
            "HTTP/1.1 200 OK" \
            "Connection: close" \
            "Content-Type: image/jpeg" \
            "Cache-Control: no-store" \
            "Content-Length: $fsize" "" ""] "\r\n"] \
            body $data
    }
}

# Only selected files are served under /lib; publish the camera client explicitly.
Wish the web server handles route {/lib/camera-frames\.js} with hidden true handler {
    set fd [open lib/camera-frames.js rb]
    try { set data [read $fd] } finally { close $fd }
    dict create statusAndHeaders [join [list \
        "HTTP/1.1 200 OK" \
        "Connection: close" \
        "Content-Type: text/javascript; charset=utf-8" \
        "Cache-Control: no-cache" \
        "Content-Length: [string bytelength $data]" "" ""] "\r\n"] body $data
}
