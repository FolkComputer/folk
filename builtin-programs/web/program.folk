Wish the web server handles route {/program/(.*)$} with handler {
    set programName $1
    Require! $1 has program code /programCode/

    set replacements [Query! /someone/ wishes program $programName is replaced with /...replacedOpts/]
    if {[llength $replacements] > 0} {
        set programCode [dict get [lindex $replacements 0] replacedOpts code]
    }

    html [subst {
        <html>
        <head>
            <title>[htmlEscape $programName]</title>
            <link rel="stylesheet" href="/style.css">
        </head>
        <body>
        <h1>[htmlEscape $programName]</h1>
        <pre><code>[htmlEscape $programCode]</code></pre>
        </body>
        </html>
    }]
}
