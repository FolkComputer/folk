Wish the web server handles route "/quads" with handler {
    html {
        <!DOCTYPE html>
        <html>
        <head>
            <title>Folk Quads 3D</title>
            <script src="/lib/folk.js"></script>
            <script type="importmap">
                {"imports": {
                    "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
                    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
                }}
            </script>
            <style>
                body { margin: 0; overflow: hidden; font-family: monospace; }
                canvas { display: block; }
                #stats {
                    position: absolute; top: 10px; left: 10px;
                    color: white; background: rgba(0, 0, 0, 0.7);
                    padding: 10px; border-radius: 4px; line-height: 1.6;
                    font-size: 14px;
                }
            </style>
        </head>
        <body>
            <div id="stats">
                <div>Quads: <span id="quad-count">0</span></div>
                <div>Space: <span id="camera-space">none</span></div>
            </div>
            <script type="module">
                import * as THREE from 'three';
                import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

                const scene = new THREE.Scene();
                scene.background = new THREE.Color(0x1a1a1a);
                scene.add(new THREE.GridHelper(2, 20), new THREE.AxesHelper(0.5));
                const camera = new THREE.PerspectiveCamera(60, 1, 0.01, 100);
                camera.position.set(0, 0, -2);
                const renderer = new THREE.WebGLRenderer({ antialias: true });
                renderer.setPixelRatio(window.devicePixelRatio);
                document.body.appendChild(renderer.domElement);
                const controls = new OrbitControls(camera, renderer.domElement);
                controls.enableDamping = true;
                controls.dampingFactor = 0.05;
                controls.minDistance = 0.1;
                controls.maxDistance = 10;
                function resize() {
                    camera.aspect = window.innerWidth / window.innerHeight;
                    camera.updateProjectionMatrix();
                    renderer.setSize(window.innerWidth, window.innerHeight);
                }
                window.addEventListener('resize', resize);
                resize();

                const quads = new Map();
                const dropoutHoldMs = 150, dropoutFadeMs = 100;
                let cameraSpace = null, results = [], dirty = false;

                function createQuad(tag) {
                    const hash = Math.abs([...tag].reduce((h, c) =>
                        ((h << 5) - h) + c.charCodeAt(0), 0));
                    const geometry = new THREE.BufferGeometry();
                    geometry.setAttribute('position', new THREE.BufferAttribute(new Float32Array(12), 3));
                    geometry.setIndex([0, 1, 3, 1, 2, 3]);
                    const mesh = new THREE.Mesh(geometry, new THREE.MeshBasicMaterial({
                        color: new THREE.Color().setHSL((hash % 360) / 360, 0.7, 0.6),
                        side: THREE.DoubleSide, transparent: true, opacity: 0.8
                    }));
                    const canvas = document.createElement('canvas');
                    canvas.width = 512;
                    canvas.height = 128;
                    const context = canvas.getContext('2d');
                    Object.assign(context, {
                        font: 'Bold 48px Arial', fillStyle: 'white',
                        textAlign: 'center', textBaseline: 'middle'
                    });
                    context.fillText(tag, 256, 64);
                    const sprite = new THREE.Sprite(new THREE.SpriteMaterial({
                        map: new THREE.CanvasTexture(canvas), depthTest: false
                    }));
                    sprite.scale.set(0.2, 0.05, 1);
                    scene.add(mesh, sprite);
                    return { mesh, sprite, missingSince: null };
                }

                function removeQuad(tag, { mesh, sprite }) {
                    scene.remove(mesh, sprite);
                    mesh.geometry.dispose();
                    mesh.material.dispose();
                    sprite.material.map.dispose();
                    sprite.material.dispose();
                    quads.delete(tag);
                }

                function updateQuads(now) {
                    const present = new Set();
                    for (const { tag, quad } of results) {
                        const [space, encodedVertices] = loadList(quad);
                        if (space !== cameraSpace) continue;
                        const vertices = loadList(encodedVertices).map(row => loadList(row).map(Number));
                        if (vertices.length !== 4 || vertices.some(v =>
                            v.length !== 3 || !v.every(Number.isFinite))) continue;
                        present.add(tag);
                        if (!quads.has(tag)) quads.set(tag, createQuad(tag));
                        const q = quads.get(tag);
                        const position = q.mesh.geometry.getAttribute('position');
                        position.array.set(vertices.flat());
                        position.needsUpdate = true;
                        q.mesh.geometry.computeBoundingSphere();
                        // Labels ignore depth, so placing them at the center is enough.
                        q.sprite.position.fromArray([0, 1, 2].map(axis =>
                            vertices.reduce((sum, v) => sum + v[axis], 0) / 4));
                        q.missingSince = null;
                    }
                    for (const [tag, q] of quads) {
                        if (!present.has(tag) && q.missingSince === null) q.missingSince = now;
                    }
                }

                function animate(now = performance.now()) {
                    requestAnimationFrame(animate);
                    // Coalesce intermediate query results into one update per frame.
                    if (dirty) { dirty = false; updateQuads(now); }
                    for (const [tag, q] of quads) {
                        const elapsed = q.missingSince === null ? 0 : now - q.missingSince;
                        if (elapsed >= dropoutHoldMs + dropoutFadeMs) {
                            removeQuad(tag, q);
                        } else {
                            const opacity = 1 - Math.max(0, elapsed - dropoutHoldMs) / dropoutFadeMs;
                            q.mesh.material.opacity = 0.8 * opacity;
                            q.sprite.material.opacity = opacity;
                        }
                    }
                    document.getElementById('quad-count').textContent = quads.size;
                    document.getElementById('camera-space').textContent = cameraSpace || 'none';
                    controls.update();
                    renderer.render(scene, camera);
                }
                animate();

                const ws = new FolkWS();
                ws.watchCollected('/someone/ claims camera /camera/ has width /w/ height /h/', cameras => {
                    const spaces = [...new Set(cameras.map(r => r.camera))].sort();
                    // Preserve the selected camera through reordered or empty updates.
                    if (spaces.length && !spaces.includes(cameraSpace)) {
                        cameraSpace = spaces[0];
                        for (const [tag, q] of quads) removeQuad(tag, q);
                        dirty = true;
                    }
                });
                ws.watchCollected('/someone/ claims /tag/ has quad /quad/', quads => {
                    results = quads;
                    dirty = true;
                });
            </script>
        </body>
        </html>
    }
}
