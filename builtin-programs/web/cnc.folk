# Four corresponding image corners per camera, held persistently on cnc.
fn cncRay {k w h point} {
    dict with k {}
    set u [expr {([lindex $point 0]*double($k(width))/$w-$cx)/$fx}]
    set v [expr {([lindex $point 1]*double($k(height))/$h-$cy)/$fy}]
    set x $u;set y $v
    for {set i 0} {$i<100} {incr i} {
        set r [expr {$x*$x+$y*$y}];set radial [expr {1+$k1*$r+$k2*$r*$r}]
        set nx [expr {($u-2*$p1*$x*$y-$p2*($r+2*$x*$x))/$radial}]
        set ny [expr {($v-$p1*($r+2*$y*$y)-2*$p2*$x*$y)/$radial}]
        if {!(abs($nx)<Inf && abs($ny)<Inf)} {error "Camera distortion did not converge."}
        set change [expr {abs($nx-$x)>abs($ny-$y)?abs($nx-$x):abs($ny-$y)}];set x $nx;set y $ny
        if {$change<1e-12} {return [list [expr {$x-$s/$fx*$y}] $y]}
    }
    error "Camera distortion did not converge."
}

fn cncProject {k w h point} {
    dict with k {}
    lassign $point x y z
    if {$z<=0} {error "The bed is behind a camera or projector."}
    set y [expr {double($y)/$z}];set x [expr {double($x)/$z+$s/$fx*$y}]
    set r [expr {$x*$x+$y*$y}];set radial [expr {1+$k1*$r+$k2*$r*$r}]
    list [expr {(($x*$radial+2*$p1*$x*$y+$p2*($r+2*$x*$x))*$fx+$cx)*$w/double($k(width))}] \
         [expr {(($y*$radial+$p1*($r+2*$y*$y)+2*$p2*$x*$y)*$fy+$cy)*$h/double($k(height))}]
}

fn cncReconstruct {left right lk le rk re pk pw ph} {
    package require linalg
    namespace import ::math::linearalgebra::*
    fn cncRay
    fn cncProject
    if {[norm [sub $le(t) $re(t)]]<.01} {error "The calibrated stereo baseline is too small."}
    set selections [list $left $right];set intrinsics [list $lk $rk];set translations [list $le(t) $re(t)]
    set rotations [list [transpose $le(R)] [transpose $re(R)]]
    set projections {};set rays {}
    foreach selection $selections k $intrinsics R $rotations t $translations {
        set points $selection(points);set width $selection(width);set height $selection(height)
        if {[llength $points]!=4 || $width<=0 || $height<=0} {error "Select four corners per camera."}
        set sign 0;set area 0
        for {set i 0} {$i<4} {incr i} {
            set a [lindex $points $i];set b [lindex $points [expr {($i+1)%4}]];set d [lindex $points [expr {($i+2)%4}]]
            if {[llength $a]!=2} {error "Invalid corner."}
            lassign $a x y;lassign $b bx by;lassign $d dx dy
            if {!(abs($x)<Inf && abs($y)<Inf && $x>=0 && $y>=0 && $x<$width && $y<$height)} {error "A corner is outside its image."}
            set turn [expr {($bx-$x)*($dy-$by)-($by-$y)*($dx-$bx)}]
            if {$turn==0 || ($i && $sign*$turn<=0)} {error "Click four corners in perimeter order, without crossing edges."}
            set sign $turn;set area [expr {$area+$x*$by-$y*$bx}]
        }
        if {abs($area)<50} {error "The selected quad is too small."}
        lappend projections [lmap row $R v [scale -1 [matmul $R $t]] {concat $row [list $v]}]
        lappend rays [lmap p $points {cncRay $k $width $height $p}]
    }
    set points {}
    for {set i 0} {$i<4} {incr i} {
        set A {}
        foreach P $projections xy $rays {
            foreach coordinate [lindex $xy $i] row [lrange $P 0 1] {lappend A [sub [scale $coordinate [lindex $P 2]] $row]}
        }
        lassign [determineSVD $A] U S V
        set v [getcol $V [lsearch -exact $S [lindex [lsort -real $S] 0]]]
        if {abs([lindex $v 3])<1e-10} {error "The corner rays do not triangulate."}
        lappend points [scale [expr {1.0/[lindex $v 3]}] [lrange $v 0 2]]
    }
    set center [scale .25 [matmul [transpose $points] {1 1 1 1}]]
    set centered [lmap p $points {sub $p $center}]
    lassign [determineSVD $centered] U S V
    set normal [getcol $V [lsearch -exact $S [lindex [lsort -real $S] 0]]]
    set deviation [lmap p $centered {dotproduct $p $normal}]
    set lengths [lmap a $points b [concat [lrange $points 1 end] [list [lindex $points 0]]] {norm [sub $a $b]}]
    if {[lindex [lsort -real $lengths] 0]<.003} {error "The reconstructed quad is degenerate."}
    set meanSide [dotproduct $lengths {.25 .25 .25 .25}]
    set maxDeviation [lindex [lsort -real [lmap d $deviation {expr {abs($d)}}]] end]
    for {set pass 0} {$pass<2} {incr pass} {
        if {$pass} {set points [lmap p $points d $deviation {sub $p [scale $d $normal]}]}
        set sum 0;set maxError 0
        foreach p $points i {0 1 2 3} {
            if {[lindex $p 2]<=0} {error "The bed is behind the projector."}
            foreach selection $selections k $intrinsics R $rotations t $translations {
                set uv [cncProject $k $selection(width) $selection(height) [matmul $R [sub $p $t]]]
                set error [norm [sub $uv [lindex $selection(points) $i]]]
                set sum [expr {$sum+$error*$error}];if {$error>$maxError} {set maxError $error}
            }
        }
        set rms [expr {sqrt($sum/8.0)}]
        # Thresholds from 4845e7b5: 15 px before fitting; 20 RMS / 40 max after.
        if {!(abs($rms)<Inf) || $rms>($pass?20:15) || ($pass && $maxError>40)} {error [format "Reprojection error %.1f px RMS / %.1f px max. Check corner order and calibration." $rms $maxError]}
        if {!$pass && $maxDeviation>($meanSide*.03>.005?$meanSide*.03:.005)} {error "The selected corners are not coplanar."}
    }
    dict create points3d $points projectorQuad [lmap p $points {cncProject $pk $pw $ph $p}] reprojectionRms $rms
}

When the collected results for {camera /camera/ has CNC bed corners /points/ with width /width/ height /height/} are /selections/ {
    Claim CNC bed reconstruction is {waiting {Select four corners in each camera; both need saved calibration.}}
    if {[llength $selections]!=2} return
    lassign [lsort -command {apply {{a b} {string compare [dict get $a camera] [dict get $b camera]}}} $selections] left right
    set lc [dict get $left camera];set rc [dict get $right camera]
    if {$lc eq $rc} return
    When camera $lc has intrinsics /lk/ &\
         camera $rc has intrinsics /rk/ &\
         camera $lc to display /display/ has extrinsics /le/ &\
         camera $rc to display /display/ has extrinsics /re/ &\
         display /display/ has intrinsics /pk/ &\
         display /display/ has width /pw/ height /ph/ {
        try {
            fn cncReconstruct
            set result [cncReconstruct $left $right $lk $le $rk $re $pk $pw $ph]
            if {![dict exists $result error]} {
                lassign [dict get $result projectorQuad] p0 p1 p2 p3
                Wish to draw a quad onto $display with p0 $p0 p1 $p1 p2 $p2 p3 $p3 color green layer 100
                Claim CNC bed has quad [dict get $result points3d] in display $display
            }
        } on error {e} {set result [dict create error $e]}
        Claim CNC bed reconstruction is $result
    }
}

Wish the web server handles route {/cnc} with handler {
    set panels {}
    foreach item [lrange [lsort -command {apply {{a b} {string compare $a(camera) $b(camera)}}} [Query! camera /camera/ has width /w/ height /h/]] 0 1] {
        set camera $item(camera);set saved null
        foreach s [Query! cnc claims camera $camera has CNC bed corners /points/ with width /width/ height /height/] {set saved [json::encode [dict remove $s __ref] {obj points {list list num} width num height num}]}
        lappend panels [subst {
            <section data-camera="[htmlEscape $camera]" data-saved="[htmlEscape $saved]">
                <h3>[htmlEscape $camera]</h3>
                <div class="image">
                    <canvas></canvas>
                    <svg></svg>
                </div>
                <p class="status">Loading…</p>
                <button class="undo">Undo corner</button>
                <button class="clear">Clear / redraw</button>
                <button class="resume">Resume live</button>
            </section>
        }]
    }
    set script {
        const ws = new FolkWS(document.getElementById('connectionStatus'));
        ws.watchCollected('/any/ claims CNC bed reconstruction is /result/', matches => {
            const results = matches.map(match => loadDict(match.result));
            const s = results.find(result => !result.waiting) || results[0];
            document.getElementById('bed').textContent = s?.error || s?.waiting || (s ?
                `Bed projected. Reprojection RMS: ${Number(s.reprojectionRms).toFixed(2)} px.` :
                'Select four corners in each camera.');
        });

        let stopped = false;
        window.addEventListener('pagehide', () => stopped = true);

        document.querySelectorAll('section').forEach(panel => {
            const camera = panel.dataset.camera;
            const canvas = panel.querySelector('canvas');
            const ctx = canvas.getContext('2d');
            const svg = panel.querySelector('svg');
            const label = panel.querySelector('.status');
            const saved = JSON.parse(panel.dataset.saved);
            let points = saved?.points || [];
            let width = saved?.width || 0, height = saved?.height || 0;
            let live = true, busy = false, ready = false, version = 0, timer, request;

            function draw() {
                svg.setAttribute('viewBox', `0 0 ${width || canvas.width} ${height || canvas.height}`);
                const scale = (width || canvas.width) / canvas.getBoundingClientRect().width;
                svg.innerHTML = `
                    <${points.length === 4 ? 'polygon' : 'polyline'}
                        points="${points.map(p => p.join(',')).join(' ')}"
                        fill="none" stroke="#00ff66" stroke-width="2"
                        vector-effect="non-scaling-stroke"/>
                ` + points.map(([x, y], i) => `
                    <circle cx="${x}" cy="${y}" r="${4 * scale}" fill="#ffcc00"/>
                    <text x="${x + 8 * scale}" y="${y - 8 * scale}"
                        font-size="${14 * scale}" fill="white" stroke="black"
                        stroke-width="${2 * scale}" paint-order="stroke">${i + 1}</text>
                `).join('');
                label.textContent = points.length === 4 ? 'Four corners saved.' :
                    `Click corner ${points.length + 1} of 4.`;
            }

            async function frame() {
                if (stopped || !live) return;
                if (document.hidden) {
                    timer = setTimeout(frame, 500);
                    return;
                }
                const generation = version;
                request = new AbortController();
                try {
                    const r = await fetch('/camera-frame?' + new URLSearchParams({camera}), {
                        cache: 'no-store', signal: request.signal,
                    });
                    if (!r.ok) throw Error(`Camera: ${r.status}`);
                    const image = await createImageBitmap(await r.blob());
                    try {
                        if (!live || stopped || generation !== version) return;
                        if (canvas.width !== image.width) canvas.width = image.width;
                        if (canvas.height !== image.height) canvas.height = image.height;
                        ctx.drawImage(image, 0, 0);
                        ready = true;
                        draw();
                    } finally {
                        image.close();
                    }
                } catch (e) {
                    if (live) label.textContent = e.message;
                }
                if (live && !stopped && generation === version) timer = setTimeout(frame, 100);
            }

            function resume() {
                version++;
                request?.abort();
                clearTimeout(timer);
                live = true;
                frame();
            }

            canvas.onclick = async e => {
                if (!ready || busy || points.length === 4) return;
                live = false;
                version++;
                request?.abort();
                clearTimeout(timer);
                if (!points.length) {
                    width = canvas.width;
                    height = canvas.height;
                }
                const r = canvas.getBoundingClientRect();
                points.push([
                    Math.max(0, Math.min(width - 1, (e.clientX - r.left) * width / r.width)),
                    Math.max(0, Math.min(height - 1, (e.clientY - r.top) * height / r.height)),
                ]);
                draw();
                if (points.length === 4) {
                    busy = true;
                    label.textContent = 'Saving…';
                    try {
                        await ws.run(tcl`Hold! -save -on cnc -key ${camera} -- cnc claims camera ${camera} has CNC bed corners ${points} with width ${width} height ${height}`);
                        draw();
                    } catch (e) {
                        points.pop();
                        draw();
                        label.textContent = e.message;
                    } finally {
                        busy = false;
                    }
                }
            };

            panel.querySelector('.undo').onclick = async () => {
                if (busy || !points.length) return;
                busy = true;
                try {
                    await ws.hold(camera, '', 'cnc', true);
                    points.pop();
                    draw();
                } catch (e) {
                    label.textContent = e.message;
                } finally {
                    busy = false;
                }
            };

            panel.querySelector('.clear').onclick = async () => {
                if (busy) return;
                busy = true;
                try {
                    await ws.hold(camera, '', 'cnc', true);
                    points = [];
                    width = height = 0;
                    draw();
                    resume();
                } catch (e) {
                    label.textContent = e.message;
                } finally {
                    busy = false;
                }
            };

            panel.querySelector('.resume').onclick = resume;
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) request?.abort();
            });
            window.addEventListener('pagehide', () => {
                version++;
                request?.abort();
                clearTimeout(timer);
            });
            frame();
        });
    }
    html [subst {
<!doctype html>
<html>
<head>
    <title>CNC bed</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body {
            font-family: sans-serif;
            margin: 12px;
        }
        .cameras {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }
        section { min-width: 0; }
        h3 {
            font-size: 13px;
            overflow-wrap: anywhere;
        }
        .image { position: relative; }
        canvas {
            display: block;
            width: 100%;
            cursor: crosshair;
        }
        svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        @media (max-width: 700px) {
            .cameras { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <h1>CNC bed</h1>
    <p>
        Click the same four bed corners in perimeter order in both views: same starting corner, same direction.
        First click freezes the image; fourth click saves. Selections and projection persist after closing this page.
    </p>
    <span id="connectionStatus">Connecting…</span>
    <p id="bed">Select four corners in each camera.</p>
    <div class="cameras">[join $panels \n]</div>
    <script src="/lib/folk.js"></script>
    <script>$script</script>
</body>
</html>
    }]
}
