When the image library is /imageLib/ {
    set aecc [C]
    $aecc extend $imageLib
    $aecc include <stdint.h>

    $aecc struct TagLocalContrast {
        int count;
        double white;
        double black;
        double satFrac;
    }

    # Measures how bright the white cells and how dark the black cells
    # of one detected tag are.
    #
    #   count:   how many pixels we managed to sample (0 if the tag is
    #            entirely off-frame)
    #   white:   mean of the brightest quarter of the samples
    #   black:   mean of the darkest quarter of the samples
    #   satFrac: fraction of that brightest quarter that is clipped
    #            (>= 250)
    $aecc proc getTagLocalContrast {Image grayFrame double[4][2] corners} TagLocalContrast {
        FOLK_ENSURE(grayFrame.components == 1);

        uint32_t histogram[256] = {0};
        uint32_t n = 0;

        // Sample a 64x64 grid in tag-local coordinates (bilinear
        // interpolation between the 4 corners), so that we stay
        // inside the tag even when it is rotated. The axis-aligned
        // bounding box of a rotated tag is up to half paper & table.
        const int samples = 64;
        for (int sy = 0; sy < samples; sy++) {
            double v = (sy + 0.5) / samples;
            for (int sx = 0; sx < samples; sx++) {
                double u = (sx + 0.5) / samples;

                double topX = corners[0][0] + u * (corners[1][0] - corners[0][0]);
                double topY = corners[0][1] + u * (corners[1][1] - corners[0][1]);
                double botX = corners[3][0] + u * (corners[2][0] - corners[3][0]);
                double botY = corners[3][1] + u * (corners[2][1] - corners[3][1]);
                int x = (int)(topX + v * (botX - topX) + 0.5);
                int y = (int)(topY + v * (botY - topY) + 0.5);

                // A tag can hang off the edge of the frame (and the
                // corners may be from a slightly older frame).
                if (x < 0 || y < 0 ||
                    x >= (int)grayFrame.width || y >= (int)grayFrame.height) {
                    continue;
                }

                histogram[grayFrame.data[y * grayFrame.bytesPerRow + x]]++;
                n++;
            }
        }

        TagLocalContrast ret = {.count = (int)n, .white = 0, .black = 0, .satFrac = 0};
        if (n == 0) return ret;

        // Quartile means, not the single brightest/darkest pixel: one
        // noisy pixel or one specular glint should not decide the
        // exposure of the whole camera.
        uint32_t quarter = n / 4;
        if (quarter == 0) quarter = 1;

        uint32_t whiteCount = 0, clippedCount = 0; uint64_t whiteSum = 0;
        for (int i = 255; i >= 0 && whiteCount < quarter; i--) {
            uint32_t take = histogram[i];
            if (take > quarter - whiteCount) take = quarter - whiteCount;
            whiteSum += (uint64_t)i * take;
            whiteCount += take;
            if (i >= 250) clippedCount += take;
        }
        uint32_t blackCount = 0; uint64_t blackSum = 0;
        for (int i = 0; i < 256 && blackCount < quarter; i++) {
            uint32_t take = histogram[i];
            if (take > quarter - blackCount) take = quarter - blackCount;
            blackSum += (uint64_t)i * take;
            blackCount += take;
        }

        ret.white = (double)whiteSum / whiteCount;
        ret.black = (double)blackSum / blackCount;
        ret.satFrac = (double)clippedCount / whiteCount;
        return ret;
    }

    set autoExpLib [$aecc compile]

    # aeNextExposure --
    #
    #   The control law. Pure Tcl with no Folk dependencies, so it can
    #   be unit-tested on its own.
    #
    #   cur:   currently wished exposure time in microseconds
    #   stats: list of per-tag dicts {count N white W black B satFrac S}
    #   lo/hi: allowed exposure range in microseconds
    #
    #   Returns the exposure to wish for next. Returning exactly $cur
    #   means "leave the camera alone".
    fn aeNextExposure {cur stats lo hi} {
        # Aim the tags' white cells here (out of 255).
        set target 200.0
        # Do nothing while within +-deadband of the target, so sensor
        # noise and JPEG wobble don't turn into exposure churn.
        set deadband 12.0
        # Proportional gain in the log domain (1.0 = jump straight to
        # the estimated ideal; smaller = smoother, and robust to the
        # 1-3 frames a USB camera takes to apply a new exposure).
        set gain 0.6
        # Never move by more than this factor in one step.
        set maxRatio 1.5
        # If more than this fraction of the white samples is clipped,
        # we can't tell _how_ overexposed we are, so just back off by a
        # fixed factor.
        set clipFrac 0.25
        set clipStep 0.7

        if {[llength $stats] == 0} { return $cur }

        # Median across tags: one tag under projector spill, a glint
        # or a hand shadow should not drag everyone else.
        set whites [lsort -real [lmap s $stats {dict get $s white}]]
        set sats [lsort -real [lmap s $stats {dict get $s satFrac}]]
        set mid [expr {[llength $whites] / 2}]
        set white [lindex $whites $mid]
        set sat [lindex $sats $mid]

        if {$sat > $clipFrac} {
            set ratio $clipStep
        } else {
            if {abs($target - $white) <= $deadband} { return $cur }
            if {$white < 1.0} { set white 1.0 }
            # 8-bit pixel values go roughly as exposure^(1/2.2)
            # (camera tone curve), so the exposure ratio that fixes a
            # pixel ratio is pow(pixelRatio, 2.2).
            set ratio [expr {pow($target / $white, 2.2 * $gain)}]
            if {$ratio > $maxRatio} { set ratio $maxRatio }
            if {$ratio < 1.0 / $maxRatio} { set ratio [expr {1.0 / $maxRatio}] }
        }

        # V4L2 exposure_time_absolute has 100us granularity. Stay on
        # that grid, and always move by at least one step in the
        # commanded direction (otherwise small corrections at short
        # exposures round away to nothing and we stall forever).
        set next [expr {int($cur * $ratio) / 100 * 100}]
        if {$next == $cur} {
            set next [expr {$ratio > 1.0 ? $cur + 100 : $cur - 100}]
        }
        if {$next < $lo} { set next $lo }
        if {$next > $hi} { set next $hi }
        return $next
    }

    # aeSweepExposure --
    #
    #   Used when no tag has been detected for a while: the exposure is
    #   probably so far off that there is nothing to measure. Walks the
    #   range geometrically (x1.6 per step) in direction dir (+1 up,
    #   -1 down), bouncing at the ends. Returns {next newDir}.
    fn aeSweepExposure {cur dir lo hi} {
        set step 1.6
        if {$dir > 0} {
            set next [expr {int($cur * $step) / 100 * 100}]
            if {$next >= $hi} { set next $hi; set dir -1 }
        } else {
            set next [expr {int($cur / $step) / 100 * 100}]
            if {$next <= $lo} { set next $lo; set dir 1 }
        }
        return [list $next $dir]
    }

    puts "Before when"

    When camera /camera/ has width /width/ height /height/ &\
    /someone/ wishes camera /camera/ detects tags {
        puts "Immediately after when"
        set n 0
        while true {
            sleep 1
            # get local apriltag slices
            puts "start [incr n]"
            Expect! /detector/ detects tags /tags/ on camera $camera \
            at timestamp /frameTs/ in time /time/
            try {
                Require! camera $camera has gray frame /grayFrame/ at timestamp $frameTs
            } on error e {
                puts $e
                continue
            }
            # puts $tags
            # puts $grayFrame
            foreach tag $tags {
                set stats [$autoExpLib getTagLocalContrast $grayFrame [dict get $tag p]]
                puts $stats
            }
            # compare white to target white
            # set contrast to target contrast value
                # gain?
                # exposure time?
        }
    }
}


