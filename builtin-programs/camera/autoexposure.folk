# Folk-level autoexposure, driven by AprilTags.
#
# This is different from the camera's built-in autoexposure (which
# looks at the whole frame, so a bright projection or a dark table
# drags it around). We look only at the pixels inside each detected
# tag and adjust exposure time so that the tags' white cells sit at
# ~200/255: bright enough for a solid black/white split, with
# headroom so they don't clip.
#
# Turn it on with:
#
#     Wish camera /dev/video0 uses AprilTag-based autoexposure
#
# (or the checkbox on the /camera web page).

When the image library is /imageLib/ {
    set aecc [C]
    $aecc extend $imageLib
    $aecc include <stdint.h>

    $aecc struct TagLocalContrast {
        int count;
        double white;
        double black;
        double satFrac;
    }

    # Measures how bright the white cells and how dark the black cells
    # of one detected tag are.
    #
    #   count:   how many pixels we managed to sample (0 if the tag is
    #            entirely off-frame)
    #   white:   mean of the brightest quarter of the samples
    #   black:   mean of the darkest quarter of the samples
    #   satFrac: fraction of that brightest quarter that is clipped
    #            (>= 250)
    $aecc proc getTagLocalContrast {Image grayFrame double[4][2] corners} TagLocalContrast {
        FOLK_ENSURE(grayFrame.components == 1);

        uint32_t histogram[256] = {0};
        uint32_t n = 0;

        // Sample a 64x64 grid in tag-local coordinates (bilinear
        // interpolation between the 4 corners), so that we stay
        // inside the tag even when it is rotated. The axis-aligned
        // bounding box of a rotated tag is up to half paper & table.
        const int samples = 64;
        for (int sy = 0; sy < samples; sy++) {
            double v = (sy + 0.5) / samples;
            for (int sx = 0; sx < samples; sx++) {
                double u = (sx + 0.5) / samples;

                double topX = corners[0][0] + u * (corners[1][0] - corners[0][0]);
                double topY = corners[0][1] + u * (corners[1][1] - corners[0][1]);
                double botX = corners[3][0] + u * (corners[2][0] - corners[3][0]);
                double botY = corners[3][1] + u * (corners[2][1] - corners[3][1]);
                int x = (int)(topX + v * (botX - topX) + 0.5);
                int y = (int)(topY + v * (botY - topY) + 0.5);

                // A tag can hang off the edge of the frame (and the
                // corners may be from a slightly older frame).
                if (x < 0 || y < 0 ||
                    x >= (int)grayFrame.width || y >= (int)grayFrame.height) {
                    continue;
                }

                histogram[grayFrame.data[y * grayFrame.bytesPerRow + x]]++;
                n++;
            }
        }

        TagLocalContrast ret = {.count = (int)n, .white = 0, .black = 0, .satFrac = 0};
        if (n == 0) return ret;

        // Quartile means, not the single brightest/darkest pixel: one
        // noisy pixel or one specular glint should not decide the
        // exposure of the whole camera.
        uint32_t quarter = n / 4;
        if (quarter == 0) quarter = 1;

        uint32_t whiteCount = 0, clippedCount = 0; uint64_t whiteSum = 0;
        for (int i = 255; i >= 0 && whiteCount < quarter; i--) {
            uint32_t take = histogram[i];
            if (take > quarter - whiteCount) take = quarter - whiteCount;
            whiteSum += (uint64_t)i * take;
            whiteCount += take;
            if (i >= 250) clippedCount += take;
        }
        uint32_t blackCount = 0; uint64_t blackSum = 0;
        for (int i = 0; i < 256 && blackCount < quarter; i++) {
            uint32_t take = histogram[i];
            if (take > quarter - blackCount) take = quarter - blackCount;
            blackSum += (uint64_t)i * take;
            blackCount += take;
        }

        ret.white = (double)whiteSum / whiteCount;
        ret.black = (double)blackSum / blackCount;
        ret.satFrac = (double)clippedCount / whiteCount;
        return ret;
    }

    # Rough mean brightness of the whole frame (every 8th pixel in
    # each direction). Only used to guess which way to start
    # sweeping when no tag is visible.
    $aecc proc getFrameBrightness {Image grayFrame} int {
        FOLK_ENSURE(grayFrame.components == 1);
        uint64_t sum = 0; uint32_t n = 0;
        for (uint32_t y = 0; y < grayFrame.height; y += 8) {
            for (uint32_t x = 0; x < grayFrame.width; x += 8) {
                sum += grayFrame.data[y * grayFrame.bytesPerRow + x];
                n++;
            }
        }
        return n == 0 ? 0 : (int)(sum / n);
    }

    set autoExpLib [$aecc compile]

    # aeNextExposure --
    #
    #   The control law. Pure Tcl with no Folk dependencies, so it can
    #   be unit-tested on its own.
    #
    #   cur:   currently wished exposure time in microseconds
    #   stats: list of per-tag dicts {count N white W black B satFrac S}
    #   lo/hi: allowed exposure range in microseconds
    #
    #   Returns the exposure to wish for next. Returning exactly $cur
    #   means "leave the camera alone".
    fn aeNextExposure {cur stats lo hi} {
        # Aim the tags' white cells here (out of 255).
        set target 200.0
        # Do nothing while within +-deadband of the target, so sensor
        # noise and JPEG wobble don't turn into exposure churn.
        set deadband 12.0
        # Proportional gain in the log domain (1.0 = jump straight to
        # the estimated ideal; smaller = smoother, and robust to the
        # 1-3 frames a USB camera takes to apply a new exposure).
        set gain 0.6
        # Never move by more than this factor in one step.
        set maxRatio 1.5
        # If more than this fraction of the white samples is clipped,
        # we can't tell _how_ overexposed we are, so just back off by a
        # fixed factor.
        set clipFrac 0.25
        set clipStep 0.7

        if {[llength $stats] == 0} { return $cur }

        # Median across tags: one tag under projector spill, a glint
        # or a hand shadow should not drag everyone else.
        set whites [lsort -real [lmap s $stats {dict get $s white}]]
        set sats [lsort -real [lmap s $stats {dict get $s satFrac}]]
        set mid [expr {[llength $whites] / 2}]
        set white [lindex $whites $mid]
        set sat [lindex $sats $mid]

        if {$sat > $clipFrac} {
            set ratio $clipStep
        } else {
            if {abs($target - $white) <= $deadband} { return $cur }
            if {$white < 1.0} { set white 1.0 }
            # 8-bit pixel values go roughly as exposure^(1/2.2)
            # (camera tone curve), so the exposure ratio that fixes a
            # pixel ratio is pow(pixelRatio, 2.2).
            set ratio [expr {pow($target / $white, 2.2 * $gain)}]
            if {$ratio > $maxRatio} { set ratio $maxRatio }
            if {$ratio < 1.0 / $maxRatio} { set ratio [expr {1.0 / $maxRatio}] }
        }

        # V4L2 exposure_time_absolute has 100us granularity. Stay on
        # that grid, and always move by at least one step in the
        # commanded direction (otherwise small corrections at short
        # exposures round away to nothing and we stall forever).
        set next [expr {int($cur * $ratio) / 100 * 100}]
        if {$next == $cur} {
            set next [expr {$ratio > 1.0 ? $cur + 100 : $cur - 100}]
        }
        if {$next < $lo} { set next $lo }
        if {$next > $hi} { set next $hi }
        return $next
    }

    # aeSweepExposure --
    #
    #   Used when no tag has been detected for a while: the exposure is
    #   probably so far off that there is nothing to measure. Walks the
    #   range geometrically (x1.6 per step) in direction dir (+1 up,
    #   -1 down), bouncing at the ends. Returns {next newDir}.
    fn aeSweepExposure {cur dir lo hi} {
        set step 1.6
        if {$dir > 0} {
            set next [expr {int($cur * $step) / 100 * 100}]
            if {$next >= $hi} { set next $hi; set dir -1 }
        } else {
            set next [expr {int($cur / $step) / 100 * 100}]
            if {$next <= $lo} { set next $lo; set dir 1 }
        }
        return [list $next $dir]
    }

    When /someone/ wishes camera /camera/ uses AprilTag-based autoexposure {
        # $camera may be a virtual (cropped) camera {/dev/videoN i}:
        # tags are detected on it, but exposure belongs to the device.
        set exposureCamera [lindex $camera 0]

        # Allowed exposure range in microseconds. 300us is about as
        # short as UVC cameras go (needed in direct sun); 15ms is the
        # longest that still fits in a frame at the 60fps we request.
        set lo 300
        set hi 15000

        On unmatch {
            Hold! -key [list autoexposure-state $camera] {}
        }

        When -serially camera $camera has gray frame /grayFrame/ at timestamp /frameTs/ {
            # All state lives in a held statement, because a When body
            # starts from a fresh copy of its environment every time.
            set state {lastRunTs 0 lostSince {} lastSweepTs 0 sweepDir 1
                       sweepHome {} sweepBounces 0 restUntil 0}
            foreach r [Query! camera $camera has autoexposure state /state/] {
                set state [dict get $r state]
            }

            # Run at most ~10 times a second. That gives the camera the
            # 1-3 frames it needs to apply a new exposure before we
            # measure again. We do it by returning early rather than
            # sleeping, so we never hold on to a worker thread or a
            # stale frame.
            if {$frameTs - [dict get $state lastRunTs] < 0.1} { return }
            dict set state lastRunTs $frameTs

            # Calibration temporarily takes over the exposure; don't
            # fight it (and don't measure its frames).
            if {[llength [Query! /someone/ wishes camera $exposureCamera \
                              temporarily uses exposure time /us/ us]] > 0} {
                return
            }

            # What exposure is wished for right now? (This is the same
            # statement the manual slider on the /camera page holds.)
            set cur 0
            foreach r [Query! /someone/ wishes camera $exposureCamera \
                           uses exposure time /us/ us] {
                set cur [dict get $r us]
            }
            if {$cur < $lo || $cur > $hi} {
                # Nobody has set a manual exposure (or it is 0 = the
                # camera's built-in auto mode, or out of our range).
                # Start from a middling value; the law below takes it
                # from there.
                set cur [expr {$cur > $hi ? $hi : 3000}]
                Hold! -on builtin-programs/web/setup.folk -key "exposure $exposureCamera" \
                    Wish camera $exposureCamera uses exposure time $cur us
                Hold! -key [list autoexposure-state $camera] \
                    Claim camera $camera has autoexposure state $state
                return
            }

            # Collect the most recent corners for each tag, from both
            # the entire-frame and the incremental detector. They may
            # be a frame or two older than $grayFrame; tags move
            # slowly compared to that, and getTagLocalContrast is
            # bounds-checked.
            set corners [dict create]
            foreach r [Query! /detector/ detects tags /tags/ on camera $camera \
                           at timestamp /detTs/ in time /detTime/] {
                # Ignore a detector that has stalled.
                if {$frameTs - [dict get $r detTs] > 0.5} { continue }
                foreach tag [dict get $r tags] {
                    dict set corners [dict get $tag id] [dict get $tag p]
                }
            }

            set stats [list]
            dict for {id p} $corners {
                set s [$autoExpLib getTagLocalContrast $grayFrame $p]
                if {[dict get $s count] == 0} { continue }
                lappend stats $s
            }

            set next $cur
            if {[llength $stats] > 0} {
                dict set state lostSince {}
                dict set state sweepHome {}
                dict set state sweepBounces 0
                dict set state restUntil 0
                set next [aeNextExposure $cur $stats $lo $hi]
            } elseif {[dict get $state lostSince] eq ""} {
                dict set state lostSince $frameTs
            } elseif {$frameTs - [dict get $state lostSince] > 0.5 &&
                      $frameTs >= [dict get $state restUntil] &&
                      $frameTs - [dict get $state lastSweepTs] >= 0.4} {
                # No tag for half a second. Either there are no tags
                # on the table, or the exposure is so far off that
                # they can't be seen (direct sun, dark room). Sweep
                # through the range, one step every 0.4s, until a tag
                # shows up; then the normal law takes over.
                if {[dict get $state sweepHome] eq ""} {
                    dict set state sweepHome $cur
                    dict set state sweepBounces 0
                    # Start in the likelier direction: if the frame is
                    # mostly bright we are probably overexposed (sun),
                    # so go shorter first; otherwise go longer first.
                    dict set state sweepDir \
                        [expr {[$autoExpLib getFrameBrightness $grayFrame] > 128 ? -1 : 1}]
                }
                dict set state lastSweepTs $frameTs
                if {[dict get $state sweepBounces] >= 2} {
                    # We have been to both ends of the range and found
                    # nothing, so the table is probably just empty. Go
                    # back to where we were and rest for 5s, so the
                    # picture isn't pulsing forever for everyone else
                    # who uses the camera.
                    set next [dict get $state sweepHome]
                    dict set state sweepHome {}
                    dict set state restUntil [expr {$frameTs + 5.0}]
                } else {
                    lassign [aeSweepExposure $cur [dict get $state sweepDir] $lo $hi] \
                        next sweepDir
                    if {$sweepDir != [dict get $state sweepDir]} {
                        dict incr state sweepBounces
                    }
                    dict set state sweepDir $sweepDir
                }
            }
            dict set state tagCount [llength $stats]
            Hold! -key [list autoexposure-state $camera] \
                Claim camera $camera has autoexposure state $state

            if {$next != $cur} {
                # Same -on and -key as the manual slider in
                # web/camera.folk, so there is only ever one exposure
                # wish, and when autoexposure is switched off the
                # camera simply stays where we left it. Not -save'd:
                # that would rewrite the hold file ~10 times a second.
                Hold! -on builtin-programs/web/setup.folk -key "exposure $exposureCamera" \
                    Wish camera $exposureCamera uses exposure time $next us
            }
        }
    }
}
