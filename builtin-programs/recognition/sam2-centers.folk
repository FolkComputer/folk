set cc [C]

# Returns the centroid of the nonzero pixels in a SAM2 mask, scaled into the
# viewport's local {x y} meter space. An empty mask has no center.
$cc proc sam2MaskCenter {int width int height Jim_Obj* mask
                         double scaleX double scaleY} Jim_Obj* {
    if (width <= 0 || height <= 0) {
        return Jim_NewListObj(interp, NULL, 0);
    }

    int maskLen = 0;
    const uint8_t *maskData = (const uint8_t *)Jim_GetString(mask, &maskLen);
    FOLK_ENSURE(maskLen == width * height);

    uint64_t count = 0;
    uint64_t sumX = 0;
    uint64_t sumY = 0;
    for (int y = 0; y < height; y++) {
        for (int x = 0; x < width; x++) {
            if (maskData[y * width + x] == 0) continue;
            count++;
            sumX += (uint64_t)x;
            sumY += (uint64_t)y;
        }
    }

    if (count == 0) {
        return Jim_NewListObj(interp, NULL, 0);
    }

    Jim_Obj *center[2] = {
        Jim_NewDoubleObj(interp,
            ((double)sumX / (double)count + 0.5) * scaleX),
        Jim_NewDoubleObj(interp,
            ((double)sumY / (double)count + 0.5) * scaleY),
    };
    return Jim_NewListObj(interp, center, 2);
}

Claim the SAM2 centers library is [$cc compile]

# Auto-trigger the center provider when a When subscribes to an object's center.
When /someone/ wishes /v/ tracks object /obj/ /...any/ {
    When when $obj has center /center/ in $v /lambda/ with environment /e/ {
        Wish $obj has center in $v
    }
}

fn advectCenterWithFlow {opticalFlowLib center geom frame flow} {
    if {[llength $center] != 2} {
        return $center
    }

    set frameWidth [dict get $frame width]
    set frameHeight [dict get $frame height]
    if {$frameWidth <= 0 || $frameHeight <= 0 ||
        $geom(width) <= 0 || $geom(height) <= 0} {
        return $center
    }

    # Convert the center from viewport meters to source-frame pixels. The
    # optical-flow library maps that position to its nearest native grid cell.
    set pixelX [expr {[lindex $center 0] / $geom(width) * $frameWidth}]
    set pixelY [expr {[lindex $center 1] / $geom(height) * $frameHeight}]
    set vector [$opticalFlowLib sampleOpticalFlow $flow $pixelX $pixelY]
    if {[llength $vector] != 2} {
        return $center
    }

    set x [expr {[lindex $center 0] +
                 [lindex $vector 0] * $geom(width) / $frameWidth}]
    set y [expr {[lindex $center 1] +
                 [lindex $vector 1] * $geom(height) / $frameHeight}]
    if {$x < 0.0} { set x 0.0 }
    if {$y < 0.0} { set y 0.0 }
    if {$x > $geom(width)} { set x $geom(width) }
    if {$y > $geom(height)} { set y $geom(height) }
    list $x $y
}

When /someone/ wishes /obj/ has center in /v/ {
    # Canonical:
    When $obj has mask /mask/ in /v/ with /...maskOptions/ &\
         /v/ has resolved geometry /geom/ &\
         the SAM2 centers library is /centersLib/ {

        set width [dict get $maskOptions width]
        set height [dict get $maskOptions height]
        set scaleX [expr {double($geom(width)) / double($width)}]
        set scaleY [expr {double($geom(height)) / double($height)}]
        set center [$centersLib sam2MaskCenter \
                        $width $height $mask $scaleX $scaleY]

        if {[llength $center] == 2} {
            # Keep the SAM2 observation separately so optical-flow updates can
            # notice a new authoritative center and re-anchor to it.
            Hold! -on $v -key [list sam2 observed center $obj] \
                Claim $obj has SAM2 center $center in $v
            Hold! -on $v -key [list sam2 center $obj] \
                Claim $obj has center $center in $v
        }
    }

    # Optical-flow interpolation between authoritative SAM2 mask updates.
    When the optical flow library is /opticalFlowLib/ &\
         $v has resolved geometry /flowGeom/ {
        Wish $v has camera slice

        set previousFrame {}
        set previousFrameRef {}
        set acquiredFrameRef {}
        set predictedCenter {}
        set observedCenterRef {}

        try -signal {
            while true {
                set frameResults [Query! $v has camera slice /frame/]
                if {[llength $frameResults] == 0} {
                    sleep 0.005
                    continue
                }
                set frameResult [lindex $frameResults end]
                set frameRef [dict get $frameResult __ref]
                if {$frameRef eq $previousFrameRef} {
                    sleep 0.005
                    continue
                }

                # A camera slice owns its Image through a statement destructor.
                # Retain the statement while the image is passed through CUDA.
                if {[catch {StatementAcquire! $frameRef}]} {
                    continue
                }
                set acquiredFrameRef $frameRef
                set frame [dict get $frameResult frame]

                set didReanchor false
                set observedResults \
                    [Query! $obj has SAM2 center /observedCenter/ in $v]
                if {[llength $observedResults] > 0} {
                    set observedResult [lindex $observedResults end]
                    set newObservedRef [dict get $observedResult __ref]
                    if {$newObservedRef ne $observedCenterRef} {
                        set predictedCenter \
                            [dict get $observedResult observedCenter]
                        set observedCenterRef $newObservedRef
                        set didReanchor true
                    }
                }

                if {$predictedCenter eq {}} {
                    set centerResults [Query! $obj has center /center/ in $v]
                    if {[llength $centerResults] > 0} {
                        set predictedCenter \
                            [dict get [lindex $centerResults end] center]
                    }
                }

                if {$previousFrame ne {} && $predictedCenter ne {} &&
                    !$didReanchor} {
                    set flowStartUs [clock microseconds]
                    set flow {}
                    try {
                        set flow [$opticalFlowLib runOpticalFlow \
                                      $previousFrame $frame]
                        set predictedCenter [advectCenterWithFlow \
                            $opticalFlowLib $predictedCenter $flowGeom \
                            $previousFrame $flow]
                    } finally {
                        if {$flow ne {}} {
                            $opticalFlowLib freeOpticalFlow $flow
                        }
                    }
                    set flowElapsedMs [expr {
                        ([clock microseconds] - $flowStartUs) / 1000.0
                    }]
                    Hold! -on $v -key [list sam2 optical-flow timing] \
                        Wish $v is labelled [format \
                            "Optical flow + advect: %.2f ms" $flowElapsedMs]
                    Hold! -on $v -key [list sam2 center $obj] \
                        Claim $obj has center $predictedCenter in $v
                }

                if {$previousFrameRef ne {}} {
                    StatementRelease! $previousFrameRef
                }
                set previousFrame $frame
                set previousFrameRef $frameRef
                set acquiredFrameRef {}
            }
        } finally {
            if {$acquiredFrameRef ne {}} {
                StatementRelease! $acquiredFrameRef
            }
            if {$previousFrameRef ne {}} {
                StatementRelease! $previousFrameRef
            }
        }
    }
}
