set cc [C]
$cc include <stdbool.h>
$cc include <stddef.h>
$cc include <stdlib.h>

$cc code {
    typedef struct { int x, y; } HullPoint;

    static int hullPointCmp(const void *a, const void *b) {
        const HullPoint *pa = a;
        const HullPoint *pb = b;
        if (pa->x != pb->x) return pa->x - pb->x;
        return pa->y - pb->y;
    }

    static long long hullCross(HullPoint o, HullPoint a, HullPoint b) {
        return (long long)(a.x - o.x) * (b.y - o.y)
             - (long long)(a.y - o.y) * (b.x - o.x);
    }

    static double hullCrossD(double ox, double oy,
                             double ax, double ay,
                             double bx, double by) {
        return (ax - ox) * (by - oy) - (ay - oy) * (bx - ox);
    }
}

# Extract the convex-hull arc facing away from the camera principal point and
# return the midpoint of its endpoint chord. The contour stays internal.
$cc proc sam2FootCenter {int width int height Jim_Obj* mask
                         double[2] pp
                         double scaleX double scaleY} Jim_Obj* {
    if (width < 3 || height < 3) {
        return Jim_NewListObj(interp, NULL, 0);
    }

    int maskLen = 0;
    const uint8_t *data = (const uint8_t *)Jim_GetString(mask, &maskLen);
    FOLK_ENSURE(maskLen == width * height);

    size_t capacity = (size_t)width * height;
    HullPoint *points = malloc(capacity * sizeof(*points));
    HullPoint *hull = malloc(capacity * 2 * sizeof(*hull));
    FOLK_ENSURE(points != NULL && hull != NULL);

    size_t pointCount = 0;
    for (int y = 1; y < height - 1; y++) {
        for (int x = 1; x < width - 1; x++) {
            size_t i = (size_t)y * width + x;
            if (!data[i]) continue;
            if (!data[i - 1] || !data[i + 1] ||
                !data[i - width] || !data[i + width]) {
                points[pointCount++] = (HullPoint){x, y};
            }
        }
    }

    if (pointCount < 3) {
        free(points);
        free(hull);
        return Jim_NewListObj(interp, NULL, 0);
    }

    qsort(points, pointCount, sizeof(*points), hullPointCmp);
    size_t uniqueCount = 0;
    for (size_t i = 0; i < pointCount; i++) {
        if (i == 0 || points[i].x != points[i - 1].x ||
                      points[i].y != points[i - 1].y) {
            points[uniqueCount++] = points[i];
        }
    }

    size_t hullCount = 0;
    for (size_t i = 0; i < uniqueCount; i++) {
        while (hullCount >= 2 &&
               hullCross(hull[hullCount - 2], hull[hullCount - 1], points[i]) <= 0) {
            hullCount--;
        }
        hull[hullCount++] = points[i];
    }
    size_t lowerCount = hullCount;
    for (ptrdiff_t i = (ptrdiff_t)uniqueCount - 2; i >= 0; i--) {
        while (hullCount > lowerCount &&
               hullCross(hull[hullCount - 2], hull[hullCount - 1], points[i]) <= 0) {
            hullCount--;
        }
        hull[hullCount++] = points[i];
        if (i == 0) break;
    }
    if (hullCount > 1) hullCount--;
    free(points);

    bool *away = calloc(hullCount, sizeof(*away));
    FOLK_ENSURE(away != NULL);
    size_t awayCount = 0;
    for (size_t i = 0; i < hullCount; i++) {
        size_t j = (i + 1) % hullCount;
        double ax = hull[i].x * scaleX;
        double ay = hull[i].y * scaleY;
        double bx = hull[j].x * scaleX;
        double by = hull[j].y * scaleY;
        if (hullCrossD(ax, ay, bx, by, pp[0], pp[1]) > 0) {
            away[i] = true;
            awayCount++;
        }
    }

    if (awayCount == 0 || awayCount == hullCount) {
        free(away);
        free(hull);
        return Jim_NewListObj(interp, NULL, 0);
    }

    size_t edge = 0;
    while (!away[edge]) edge++;
    while (away[(edge + hullCount - 1) % hullCount]) {
        edge = (edge + hullCount - 1) % hullCount;
    }

    HullPoint first = hull[edge];
    HullPoint last = first;
    for (;;) {
        edge = (edge + 1) % hullCount;
        last = hull[edge];
        if (!away[edge]) break;
    }

    free(away);
    free(hull);

    Jim_Obj *center[2] = {
        Jim_NewDoubleObj(interp, (first.x + last.x) * 0.5 * scaleX),
        Jim_NewDoubleObj(interp, (first.y + last.y) * 0.5 * scaleY),
    };
    return Jim_NewListObj(interp, center, 2);
}

Claim the SAM2 centers library is [$cc compile]

fn sam2PointToXYInQuad {ql q xyz} {
    package require linalg
    namespace import \
        ::math::linearalgebra::sub \
        ::math::linearalgebra::dotproduct \
        ::math::linearalgebra::unitLengthVector

    lassign [$ql vertices $q] topLeft topRight bottomRight bottomLeft
    set xAxis [unitLengthVector [sub $topRight $topLeft]]
    set yAxis [unitLengthVector [sub $bottomLeft $topLeft]]
    set delta [sub $xyz $topLeft]
    list [dotproduct $delta $xAxis] [dotproduct $delta $yAxis]
}

fn sam2CameraPrincipalPointInQuad {ql q} {
    package require linalg
    namespace import \
        ::math::linearalgebra::sub \
        ::math::linearalgebra::scale \
        ::math::linearalgebra::dotproduct \
        ::math::linearalgebra::crossproduct

    lassign [$ql vertices $q] a b c d
    set normal [crossproduct [sub $b $a] [sub $d $a]]
    set opticalAxis {0 0 1}
    set denom [dotproduct $normal $opticalAxis]
    if {abs($denom) < 0.000001} { return {} }

    set distance [expr {[dotproduct $normal $a] / $denom}]
    if {$distance <= 0} { return {} }
    sam2PointToXYInQuad $ql $q [scale $distance $opticalAxis]
}

When /someone/ wishes /v/ tracks object /obj/ /...any/ {
    When when $obj has center /center/ in $v /lambda/ with environment /e/ {
        Wish $obj has center in $v
    }
}

fn advectCenterWithFlow {opticalFlowLib center geom frame flow} {
    set frameWidth [dict get $frame width]
    set frameHeight [dict get $frame height]
    set pixelX [expr {[lindex $center 0] / $geom(width) * $frameWidth}]
    set pixelY [expr {[lindex $center 1] / $geom(height) * $frameHeight}]
    lassign [$opticalFlowLib sampleOpticalFlow $flow $pixelX $pixelY] dx dy

    set x [expr {[lindex $center 0] + $dx * $geom(width) / $frameWidth}]
    set y [expr {[lindex $center 1] + $dy * $geom(height) / $frameHeight}]
    if {$x < 0.0} { set x 0.0 }
    if {$y < 0.0} { set y 0.0 }
    if {$x > $geom(width)} { set x $geom(width) }
    if {$y > $geom(height)} { set y $geom(height) }
    list $x $y
}

When /someone/ wishes /obj/ has center in /v/ {
    When the quad library is /ql/ &\
         the quad changer is /quadChange/ &\
         a calibration from camera /camera/ to display /display/ is /calibration/ &\
         $obj has mask /mask/ in /v/ with /...maskOptions/ &\
         /v/ has resolved geometry /geom/ &\
         /v/ has quad /vq/ &\
         the SAM2 centers library is /centersLib/ {

        fn quadChange

        set pp [sam2CameraPrincipalPointInQuad \
            $ql [quadChange $vq $camera]]
        if {[llength $pp] != 2} { return }

        set width [dict get $maskOptions width]
        set height [dict get $maskOptions height]
        set center [$centersLib sam2FootCenter \
            $width $height $mask $pp \
            [expr {double($geom(width)) / ($width - 1)}] \
            [expr {double($geom(height)) / ($height - 1)}]]

