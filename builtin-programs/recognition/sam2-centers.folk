set cc [C]
$cc include <math.h>
$cc include <stdbool.h>
$cc include <stdlib.h>

# Find the center of the largest inscribed circle in the largest connected
# component of a lightly opened SAM2 mask.
$cc proc sam2MaskCenter {int width int height Jim_Obj* mask
                         double scaleX double scaleY} Jim_Obj* {
    if (width < 3 || height < 3) {
        return Jim_NewListObj(interp, NULL, 0);
    }

    int maskLen = 0;
    const uint8_t *maskData = (const uint8_t *)Jim_GetString(mask, &maskLen);
    FOLK_ENSURE(maskLen == width * height);

    size_t n = (size_t)width * (size_t)height;
    uint8_t *eroded = calloc(n, 1);
    uint8_t *opened = calloc(n, 1);
    FOLK_ENSURE(eroded != NULL && opened != NULL);

    for (int y = 1; y < height - 1; y++) {
        for (int x = 1; x < width - 1; x++) {
            bool keep = true;
            for (int dy = -1; dy <= 1 && keep; dy++) {
                for (int dx = -1; dx <= 1; dx++) {
                    if (maskData[(y + dy) * width + x + dx] == 0) {
                        keep = false;
                        break;
                    }
                }
            }
            eroded[y * width + x] = keep;
        }
    }

    for (int y = 0; y < height; y++) {
        for (int x = 0; x < width; x++) {
            for (int dy = -1; dy <= 1 && !opened[y * width + x]; dy++) {
                int yy = y + dy;
                if (yy < 0 || yy >= height) continue;
                for (int dx = -1; dx <= 1; dx++) {
                    int xx = x + dx;
                    if (xx >= 0 && xx < width && eroded[yy * width + xx]) {
                        opened[y * width + x] = 1;
                        break;
                    }
                }
            }
        }
    }
    free(eroded);

    uint32_t *labels = calloc(n, sizeof(*labels));
    uint32_t *queue = malloc(n * sizeof(*queue));
    FOLK_ENSURE(labels != NULL && queue != NULL);

    uint32_t nextLabel = 0;
    uint32_t largestLabel = 0;
    size_t largestCount = 0;
    for (size_t start = 0; start < n; start++) {
        if (!opened[start] || labels[start]) continue;

        uint32_t label = ++nextLabel;
        size_t head = 0;
        size_t tail = 0;
        queue[tail++] = (uint32_t)start;
        labels[start] = label;

        while (head < tail) {
            uint32_t i = queue[head++];
            int x = i % width;
            int y = i / width;
            for (int dy = -1; dy <= 1; dy++) {
                int yy = y + dy;
                if (yy < 0 || yy >= height) continue;
                for (int dx = -1; dx <= 1; dx++) {
                    int xx = x + dx;
                    if (xx < 0 || xx >= width) continue;
                    size_t j = (size_t)yy * width + xx;
                    if (opened[j] && !labels[j]) {
                        labels[j] = label;
                        queue[tail++] = (uint32_t)j;
                    }
                }
            }
        }

        if (tail > largestCount) {
            largestCount = tail;
            largestLabel = label;
        }
    }
    free(queue);
    free(opened);

    if (!largestLabel) {
        free(labels);
        return Jim_NewListObj(interp, NULL, 0);
    }

    float *distance = malloc(n * sizeof(*distance));
    FOLK_ENSURE(distance != NULL);
    for (size_t i = 0; i < n; i++) {
        distance[i] = labels[i] == largestLabel ? 1e30f : 0.0f;
    }

    double diagonal = hypot(scaleX, scaleY);
    for (int y = 0; y < height; y++) {
        for (int x = 0; x < width; x++) {
            size_t i = (size_t)y * width + x;
            if (labels[i] != largestLabel) continue;
            double d = distance[i];
            if (x == 0 || x == width - 1) d = fmin(d, scaleX);
            if (y == 0 || y == height - 1) d = fmin(d, scaleY);
            if (x > 0) d = fmin(d, distance[i - 1] + scaleX);
            if (y > 0) d = fmin(d, distance[i - width] + scaleY);
            if (x > 0 && y > 0) {
                d = fmin(d, distance[i - width - 1] + diagonal);
            }
            if (x + 1 < width && y > 0) {
                d = fmin(d, distance[i - width + 1] + diagonal);
            }
            distance[i] = d;
        }
    }

    double maxDistance = 0.0;
    for (int y = height - 1; y >= 0; y--) {
        for (int x = width - 1; x >= 0; x--) {
            size_t i = (size_t)y * width + x;
            if (labels[i] != largestLabel) continue;
            double d = distance[i];
            if (x + 1 < width) d = fmin(d, distance[i + 1] + scaleX);
            if (y + 1 < height) d = fmin(d, distance[i + width] + scaleY);
            if (x + 1 < width && y + 1 < height) {
                d = fmin(d, distance[i + width + 1] + diagonal);
            }
            if (x > 0 && y + 1 < height) {
                d = fmin(d, distance[i + width - 1] + diagonal);
            }
            distance[i] = d;
            if (d > maxDistance) maxDistance = d;
        }
    }

    double threshold = maxDistance * 0.9;
    double weightSum = 0.0;
    double sumX = 0.0;
    double sumY = 0.0;
    for (int y = 0; y < height; y++) {
        for (int x = 0; x < width; x++) {
            size_t i = (size_t)y * width + x;
            if (labels[i] != largestLabel || distance[i] < threshold) continue;
            double weight = distance[i] * distance[i];
            weightSum += weight;
            sumX += weight * (x + 0.5) * scaleX;
            sumY += weight * (y + 0.5) * scaleY;
        }
    }

    free(distance);
    free(labels);

    if (weightSum == 0.0) {
        return Jim_NewListObj(interp, NULL, 0);
    }

    Jim_Obj *center[2] = {
        Jim_NewDoubleObj(interp, sumX / weightSum),
        Jim_NewDoubleObj(interp, sumY / weightSum),
    };
    return Jim_NewListObj(interp, center, 2);
}

Claim the SAM2 centers library is [$cc compile]

When /someone/ wishes /v/ tracks object /obj/ /...any/ {
    When when $obj has center /center/ in $v /lambda/ with environment /e/ {
        Wish $obj has center in $v
    }
}

When /someone/ wishes /obj/ has center in /v/ {
    When $obj has mask /mask/ in /v/ with /...maskOptions/ &\
         /v/ has resolved geometry /geom/ &\
         the SAM2 centers library is /centersLib/ {

        set width [dict get $maskOptions width]
        set height [dict get $maskOptions height]
        set center [$centersLib sam2MaskCenter \
            $width $height $mask \
            [expr {double($geom(width)) / $width}] \
            [expr {double($geom(height)) / $height}]]

        if {[llength $center] == 2} {
            Hold! -on $v -key [list sam2 center $obj] \
                Claim $obj has center $center in $v
        }
    }
}
