set cc [C]
$cc cflags -I.
$cc include <stdbool.h>
$cc include <stdlib.h>
$cc include "vendor/stb_ds.h"

$cc code {
    typedef struct {
        int x;
        int y;
    } HullPoint;

    static int hullPointCmp(const void *a, const void *b) {
        const HullPoint *pa = (const HullPoint *)a;
        const HullPoint *pb = (const HullPoint *)b;
        if (pa->x != pb->x) return pa->x - pb->x;
        return pa->y - pb->y;
    }

    static long long hullCross(HullPoint o, HullPoint a, HullPoint b) {
        return (long long)(a.x - o.x) * (b.y - o.y)
             - (long long)(a.y - o.y) * (b.x - o.x);
    }

    static double hullCrossD(double ox, double oy,
                             double ax, double ay,
                             double bx, double by) {
        return (ax - ox) * (by - oy) - (ay - oy) * (bx - ox);
    }

    static bool maskPixel(const uint8_t *mask, int w, int h, int x, int y) {
        return x >= 0 && x < w && y >= 0 && y < h && mask[y * w + x] != 0;
    }

    static void appendXYObj(Jim_Interp *interp, Jim_Obj *list,
                            double x, double y);

    static void appendPointObj(Jim_Interp *interp, Jim_Obj *list,
                               HullPoint p, double scaleX, double scaleY) {
        appendXYObj(interp, list, p.x * scaleX, p.y * scaleY);
    }

    static void appendXYObj(Jim_Interp *interp, Jim_Obj *list,
                            double x, double y) {
        Jim_Obj *xy[2] = {
            Jim_NewDoubleObj(interp, x),
            Jim_NewDoubleObj(interp, y),
        };
        Jim_ListAppendElement(interp, list, Jim_NewListObj(interp, xy, 2));
    }

}

# Returns the convex hull arc of a SAM2 mask that faces away from pp, where pp
# is the camera optical axis projected into the viewport's local {x y} meter
# space.
$cc proc maskFootContour {int width int height Jim_Obj* mask
                          double[2] pp double scaleX double scaleY} Jim_Obj* {
    int w = width;
    int h = height;
    if (w < 3 || h < 3) {
        return Jim_NewListObj(interp, NULL, 0);
    }

    int maskLen = 0;
    const uint8_t *maskData = (const uint8_t *)Jim_GetString(mask, &maskLen);
    FOLK_ENSURE(maskLen == w * h);

    HullPoint *pts = NULL;
    for (int y = 1; y < h - 1; y++) {
        for (int x = 1; x < w - 1; x++) {
            if (!maskPixel(maskData, w, h, x, y)) continue;
            if (!maskPixel(maskData, w, h, x - 1, y) ||
                !maskPixel(maskData, w, h, x + 1, y) ||
                !maskPixel(maskData, w, h, x, y - 1) ||
                !maskPixel(maskData, w, h, x, y + 1)) {
                arrput(pts, ((HullPoint){x, y}));
            }
        }
    }

    ptrdiff_t n = arrlen(pts);
    if (n < 3) {
        Jim_Obj *ret = Jim_NewListObj(interp, NULL, 0);
        for (ptrdiff_t i = 0; i < n; i++) {
            appendPointObj(interp, ret, pts[i], scaleX, scaleY);
        }
        arrfree(pts);
        return ret;
    }

    qsort(pts, (size_t)n, sizeof(HullPoint), hullPointCmp);

    HullPoint *unique = NULL;
    for (ptrdiff_t i = 0; i < n; i++) {
        if (i == 0 || pts[i].x != pts[i - 1].x || pts[i].y != pts[i - 1].y) {
            arrput(unique, pts[i]);
        }
    }
    arrfree(pts);
    pts = unique;
    n = arrlen(pts);

    HullPoint *hull = NULL;
    for (ptrdiff_t i = 0; i < n; i++) {
        while (arrlen(hull) >= 2 &&
               hullCross(hull[arrlen(hull) - 2], hull[arrlen(hull) - 1], pts[i]) <= 0) {
            arrpop(hull);
        }
        arrput(hull, pts[i]);
    }
    ptrdiff_t lowerLen = arrlen(hull);
    for (ptrdiff_t i = n - 2; i >= 0; i--) {
        while (arrlen(hull) > lowerLen &&
               hullCross(hull[arrlen(hull) - 2], hull[arrlen(hull) - 1], pts[i]) <= 0) {
            arrpop(hull);
        }
        arrput(hull, pts[i]);
        if (i == 0) break;
    }
    if (arrlen(hull) > 1) arrpop(hull);
    arrfree(pts);

    ptrdiff_t hn = arrlen(hull);
    Jim_Obj *ret = Jim_NewListObj(interp, NULL, 0);
    if (hn < 3) {
        for (ptrdiff_t i = 0; i < hn; i++) {
            appendPointObj(interp, ret, hull[i], scaleX, scaleY);
        }
        arrfree(hull);
        return ret;
    }

    bool *away = calloc((size_t)hn, sizeof(bool));
    ptrdiff_t awayCount = 0;
    for (ptrdiff_t i = 0; i < hn; i++) {
        ptrdiff_t j = (i + 1) % hn;
        double ax = hull[i].x * scaleX;
        double ay = hull[i].y * scaleY;
        double bx = hull[j].x * scaleX;
        double by = hull[j].y * scaleY;
        if (hullCrossD(ax, ay, bx, by, pp[0], pp[1]) > 0) {
            away[i] = true;
            awayCount++;
        }
    }

    if (awayCount == 0 || awayCount == hn) {
        for (ptrdiff_t i = 0; i < hn; i++) {
            appendPointObj(interp, ret, hull[i], scaleX, scaleY);
        }
        free(away);
        arrfree(hull);
        return ret;
    }

    ptrdiff_t edge = 0;
    while (edge < hn && !away[edge]) edge++;
    while (away[(edge - 1 + hn) % hn]) {
        edge = (edge - 1 + hn) % hn;
    }

    HullPoint *arc = NULL;
    arrput(arc, hull[edge]);
    for (;;) {
        ptrdiff_t next = (edge + 1) % hn;
        arrput(arc, hull[next]);
        edge = next;
        if (!away[edge]) break;
    }

    ptrdiff_t arcLen = arrlen(arc);
    for (ptrdiff_t i = 0; i < arcLen; i++) {
        appendPointObj(interp, ret, arc[i], scaleX, scaleY);
    }

    arrfree(arc);
    free(away);
    arrfree(hull);
    return ret;
}

set sam2FootContourLib [$cc compile]
Claim the SAM2 foot contour library is $sam2FootContourLib

fn cameraPrincipalPointInQuad {ql qInCamera} {
    package require linalg
    namespace import \
        ::math::linearalgebra::add \
        ::math::linearalgebra::sub \
        ::math::linearalgebra::scale \
        ::math::linearalgebra::dotproduct \
        ::math::linearalgebra::crossproduct

    lassign [$ql vertices $qInCamera] a b c d
    set n [crossproduct [sub $b $a] [sub $d $a]]
    set rayDir {0 0 1}
    set denom [dotproduct $n $rayDir]
    if {abs($denom) < 0.000001} {
        return {}
    }

    set t [expr {[dotproduct $n $a] / $denom}]
    if {$t <= 0} {
        return {}
    }

    return [pointToXYInQuad $ql $qInCamera [scale $t $rayDir]]
}

fn pointInQuad {ql q xy} {
    package require linalg
    namespace import \
        ::math::linearalgebra::add \
        ::math::linearalgebra::sub \
        ::math::linearalgebra::scale \
        ::math::linearalgebra::unitLengthVector

    lassign [$ql vertices $q] topLeft topRight bottomRight bottomLeft
    set xAxis [unitLengthVector [sub $topRight $topLeft]]
    set yAxis [unitLengthVector [sub $bottomLeft $topLeft]]
    lassign $xy x y
    return [add $topLeft [add [scale $x $xAxis] [scale $y $yAxis]]]
}

fn pointToXYInQuad {ql q xyz} {
    package require linalg
    namespace import \
        ::math::linearalgebra::sub \
        ::math::linearalgebra::norm \
        ::math::linearalgebra::dotproduct \
        ::math::linearalgebra::unitLengthVector

    lassign [$ql vertices $q] topLeft topRight bottomRight bottomLeft
    set xAxis [unitLengthVector [sub $topRight $topLeft]]
    set yAxis [unitLengthVector [sub $bottomLeft $topLeft]]
    set delta [sub $xyz $topLeft]
    return [list [dotproduct $delta $xAxis] [dotproduct $delta $yAxis]]
}

fn downprojectContourToPlane {ql qInCamera contour heightM} {
    if {$heightM <= 0 || [llength $contour] == 0} {
        return $contour
    }

    package require linalg
    namespace import \
        ::math::linearalgebra::add \
        ::math::linearalgebra::sub \
        ::math::linearalgebra::scale \
        ::math::linearalgebra::dotproduct \
        ::math::linearalgebra::crossproduct \
        ::math::linearalgebra::unitLengthVector

    lassign [$ql vertices $qInCamera] a b c d
    set n [unitLengthVector [crossproduct [sub $b $a] [sub $d $a]]]
    if {[dotproduct $n [scale -1 $a]] < 0} {
        set n [scale -1 $n]
    }

    set planeD [dotproduct $n $a]
    if {abs($planeD) < 0.000001} {
        return $contour
    }

    set corrected [list]
    foreach xy $contour {
        set planeHit [pointInQuad $ql $qInCamera $xy]
        set rayScale [expr {($planeD + $heightM) / $planeD}]
        set elevatedPoint [scale $rayScale $planeHit]
        set footPoint [sub $elevatedPoint [scale $heightM $n]]
        lappend corrected [pointToXYInQuad $ql $qInCamera $footPoint]
    }
    return $corrected
}

fn circleFromArcContourDiameter {contour {circleDiameter {}}} {
    if {[llength $contour] < 3} {
        return {}
    }

    lassign [lindex $contour 0] ax ay
    lassign [lindex $contour end] bx by
    set vx [expr {$bx - $ax}]
    set vy [expr {$by - $ay}]
    set chord [expr {sqrt($vx * $vx + $vy * $vy)}]
    if {$chord < 0.000001} {
        return {}
    }

    if {$circleDiameter eq {}} {
        set circleDiameter $chord
    }
    if {$circleDiameter <= 0} {
        return {}
    }

    set radius [expr {$circleDiameter / 2.0}]
    set halfChord [expr {$chord / 2.0}]
    set signedArcSide 0
    foreach p $contour {
        lassign $p px py
        set dist [expr {($vx * ($py - $ay) - $vy * ($px - $ax)) / $chord}]
        if {abs($dist) > abs($signedArcSide)} {
            set signedArcSide $dist
        }
    }
    if {abs($signedArcSide) < 0.000001} {
        return {}
    }

    # A noisy contour can produce an endpoint chord slightly longer than the
    # known diameter.  There is no exact fixed-radius circle through those two
    # endpoints; use the limiting solution at the chord midpoint instead of
    # rejecting the fit and leaving a stale center behind.
    set centerDistanceSquared [expr {$radius * $radius - $halfChord * $halfChord}]
    if {$centerDistanceSquared < 0} {
        set centerDistanceSquared 0
    }
    set centerDistance [expr {sqrt($centerDistanceSquared)}]
    set mx [expr {($ax + $bx) / 2.0}]
    set my [expr {($ay + $by) / 2.0}]
    set nx [expr {-$vy / $chord}]
    set ny [expr {$vx / $chord}]
    set side [expr {$signedArcSide < 0 ? -1.0 : 1.0}]
    set center [list \
        [expr {$mx - $side * $centerDistance * $nx}] \
        [expr {$my - $side * $centerDistance * $ny}]]
    set sagitta [expr {$radius - $centerDistance}]

    return [list center $center diameter $circleDiameter radius $radius chord $chord sagitta $sagitta]
}

When the quad library is /ql/ &\
     the quad changer is /quadChange/ &\
     the SAM2 foot contour library is /footContourLib/ &\
     a calibration from camera /camera/ to display /display/ is /calibration/ &\
     /v/ has resolved geometry /geom/ &\
     /someone/ wishes /obj/ has foot contour in /v/ &\
     /obj/ has mask /mask/ in /v/ with /...maskOpts/ &\
     /v/ has quad /vq/ {

    fn quadChange

    set vqCamera [quadChange $vq $camera]
    set pp [cameraPrincipalPointInQuad $ql $vqCamera]
    if {$pp eq {}} {
        return
    }

    set width [dict get $maskOpts width]
    set height [dict get $maskOpts height]
    set scaleWidth [expr {$width > 1 ? $width - 1 : 1}]
    set scaleHeight [expr {$height > 1 ? $height - 1 : 1}]
    set scaleX [expr {double($geom(width)) / double($scaleWidth)}]
    set scaleY [expr {double($geom(height)) / double($scaleHeight)}]
    set footContour [$footContourLib maskFootContour \
                         $width $height $mask $pp $scaleX $scaleY]

    # With no physical measurements, treat the observed contour as already on
    # the surface plane and fit a semicircle through its endpoint chord.
    set objectHeightCm 0
    set heightResults [Query! $obj has object height /heightCm/ cm in $v]
    if {[llength $heightResults] > 0} {
        set objectHeightCm [dict get [lindex $heightResults end] heightCm]
    }
    set objectHeightM [expr {double($objectHeightCm) / 100.0}]

    set footContour [downprojectContourToPlane $ql $vqCamera \
                         $footContour $objectHeightM]

    if {[llength $footContour] >= 2} {
        Claim $obj has foot contour $footContour in $v
        # An empty diameter tells circleFromArcContourDiameter to use the
        # contour's endpoint chord length.
        set objectDiameterM {}
        set diameterResults [Query! $obj has object diameter /diameterCm/ cm in $v]
        if {[llength $diameterResults] > 0} {
            set objectDiameterCm [dict get [lindex $diameterResults end] diameterCm]
            set objectDiameterM [expr {double($objectDiameterCm) / 100.0}]
        }
        set arcCircle [circleFromArcContourDiameter $footContour $objectDiameterM]
        if {$arcCircle ne {}} {
            Hold! -key [list $obj foot contour arc] \
                Claim $obj has foot contour arc $arcCircle in $v
        }
    }
}

fn sam2FootHtmlEscape {s} {
    string map {& "&amp;" < "&lt;" > "&gt;" "\"" "&quot;"} $s
}

fn sam2FootJsString {s} {
    return "\"[string map [list "\\" "\\\\" "\"" "\\\"" "\n" "\\n" "\r" "\\r" "\t" "\\t"] $s]\""
}

# Publish controls as an HTML fragment for the canonical /sam2/<viewport>
# endpoint. The SAM2 page owns rendering; this module only owns its controls.
When /obj/ has foot contour /footContour/ in /v/ &\
     /v/ has resolved geometry /geom/ {
    set heightCm 0
    set diameterCm {}

    set contourPoints [join [lmap point $footContour {
        lassign $point x y
        format "%.9g,%.9g" $x $y
    }] " "]

    set escapedObj [sam2FootHtmlEscape $obj]
    set escapedHeight [sam2FootHtmlEscape $heightCm]
    set escapedDiameter [sam2FootHtmlEscape $diameterCm]
    set escapedContourPoints [sam2FootHtmlEscape $contourPoints]
    set geomWidth [dict get $geom width]
    set geomHeight [dict get $geom height]
    set pageJs [sam2FootJsString $v]

    set controlHtml [subst {
        <div class="sam2-control sam2-foot-control"
             data-object-id="$escapedObj"
             data-contour-points="$escapedContourPoints"
             data-geom-width="$geomWidth"
             data-geom-height="$geomHeight">
            <label>
                <span>height</span>
                <input class="height-cm" type="number" step="0.1" min="0"
                       value="$escapedHeight">
                <span>cm</span>
            </label>
            <label>
                <span>diameter</span>
                <input class="diameter-cm" type="number" step="0.1" min="0"
                       value="$escapedDiameter" placeholder="chord">
                <span>cm</span>
            </label>
        </div>
        <script>
        (() => {
            const control = document.currentScript.previousElementSibling;
            const objectId = control.dataset.objectId;
            const page = $pageJs;
            const folk = window.sam2ControlFolk ||
                (window.sam2ControlFolk = new FolkWS());

            const visual = control.closest('section').querySelector('.sam2-image');
            if (visual && visual.querySelector('img')) {
                const oldOverlay = visual.querySelector('.sam2-foot-contour-overlay');
                if (oldOverlay) oldOverlay.remove();

                const svgNs = 'http://www.w3.org/2000/svg';
                const svg = document.createElementNS(svgNs, 'svg');
                svg.classList.add('sam2-foot-contour-overlay');
                svg.setAttribute('viewBox', '0 0 ' + control.dataset.geomWidth +
                    ' ' + control.dataset.geomHeight);
                svg.setAttribute('preserveAspectRatio', 'none');
                svg.setAttribute('style',
                    'position:absolute;inset:0;width:100%;height:100%;pointer-events:none');

                const polyline = document.createElementNS(svgNs, 'polyline');
                polyline.setAttribute('points', control.dataset.contourPoints);
                polyline.setAttribute('fill', 'none');
                polyline.setAttribute('stroke', '#00ff4a');
                polyline.setAttribute('stroke-width', '3');
                polyline.setAttribute('stroke-linejoin', 'round');
                polyline.setAttribute('stroke-linecap', 'round');
                polyline.setAttribute('vector-effect', 'non-scaling-stroke');
                svg.appendChild(polyline);
                visual.appendChild(svg);
            }

            control.querySelector('.height-cm').addEventListener('input', (event) => {
                const input = event.currentTarget;
                const key = 'sam2-foot-contour height ' + page + ' ' + objectId;
                const heightCm = Number(input.value);
                if (!Number.isFinite(heightCm) || heightCm < 0 || input.value === '') {
                    folk.hold(key, '', 'sam2-foot-contour');
                    return;
                }
                const statement = 'Claim ' + dump(objectId) +
                    ' has object height ' + dump(heightCm) + ' cm in ' + dump(page);
                folk.hold(key, statement, 'sam2-foot-contour');
            });

            control.querySelector('.diameter-cm').addEventListener('input', (event) => {
                const input = event.currentTarget;
                const key = 'sam2-foot-contour diameter ' + page + ' ' + objectId;
                const diameterCm = Number(input.value);
                if (!Number.isFinite(diameterCm) || diameterCm <= 0 || input.value === '') {
                    folk.hold(key, '', 'sam2-foot-contour');
                    return;
                }
                const statement = 'Claim ' + dump(objectId) +
                    ' has object diameter ' + dump(diameterCm) + ' cm in ' + dump(page);
                folk.hold(key, statement, 'sam2-foot-contour');
            });
        })();
        </script>
    }]

    Claim $obj has sam2 control $controlHtml in $v
}
