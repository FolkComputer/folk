set cc [C]
$cc cflags -I.
$cc include <stdbool.h>
$cc include <stdlib.h>
$cc include "vendor/stb_ds.h"

$cc code {
    typedef struct {
        int x;
        int y;
    } HullPoint;

    static int hullPointCmp(const void *a, const void *b) {
        const HullPoint *pa = (const HullPoint *)a;
        const HullPoint *pb = (const HullPoint *)b;
        if (pa->x != pb->x) return pa->x - pb->x;
        return pa->y - pb->y;
    }

    static long long hullCross(HullPoint o, HullPoint a, HullPoint b) {
        return (long long)(a.x - o.x) * (b.y - o.y)
             - (long long)(a.y - o.y) * (b.x - o.x);
    }

    static double hullCrossD(double ox, double oy,
                             double ax, double ay,
                             double bx, double by) {
        return (ax - ox) * (by - oy) - (ay - oy) * (bx - ox);
    }

    static bool maskPixel(const uint8_t *mask, int w, int h, int x, int y) {
        return x >= 0 && x < w && y >= 0 && y < h && mask[y * w + x] != 0;
    }

    static void appendXYObj(Jim_Interp *interp, Jim_Obj *list,
                            double x, double y);

    static void appendPointObj(Jim_Interp *interp, Jim_Obj *list,
                               HullPoint p, double scaleX, double scaleY) {
        appendXYObj(interp, list, p.x * scaleX, p.y * scaleY);
    }

    static void appendXYObj(Jim_Interp *interp, Jim_Obj *list,
                            double x, double y) {
        Jim_Obj *xy[2] = {
            Jim_NewDoubleObj(interp, x),
            Jim_NewDoubleObj(interp, y),
        };
        Jim_ListAppendElement(interp, list, Jim_NewListObj(interp, xy, 2));
    }

    static Jim_Obj *makeFootPartsObj(Jim_Interp *interp,
                                     Jim_Obj *footContour,
                                     Jim_Obj *visibleArc,
                                     Jim_Obj *reflectedArc,
                                     Jim_Obj *mirrorLine) {
        Jim_Obj *dict = Jim_NewDictObj(interp, NULL, 0);
        Jim_DictAddElement(interp, dict,
                           Jim_NewStringObj(interp, "footContour", -1),
                           footContour);
        Jim_DictAddElement(interp, dict,
                           Jim_NewStringObj(interp, "visibleArc", -1),
                           visibleArc);
        Jim_DictAddElement(interp, dict,
                           Jim_NewStringObj(interp, "reflectedArc", -1),
                           reflectedArc);
        Jim_DictAddElement(interp, dict,
                           Jim_NewStringObj(interp, "mirrorLine", -1),
                           mirrorLine);
        return dict;
    }
}

# Returns the convex hull arc of a SAM2 mask that faces pp, where pp is the
# camera optical axis projected into the viewport's local {x y} meter space.
$cc proc maskFootContourParts {int width int height Jim_Obj* mask
                               double[2] pp double scaleX double scaleY} Jim_Obj* {
    int w = width;
    int h = height;
    if (w < 3 || h < 3) {
        return makeFootPartsObj(interp,
                                Jim_NewListObj(interp, NULL, 0),
                                Jim_NewListObj(interp, NULL, 0),
                                Jim_NewListObj(interp, NULL, 0),
                                Jim_NewListObj(interp, NULL, 0));
    }

    int maskLen = 0;
    const uint8_t *maskData = (const uint8_t *)Jim_GetString(mask, &maskLen);
    FOLK_ENSURE(maskLen == w * h);

    HullPoint *pts = NULL;
    for (int y = 1; y < h - 1; y++) {
        for (int x = 1; x < w - 1; x++) {
            if (!maskPixel(maskData, w, h, x, y)) continue;
            if (!maskPixel(maskData, w, h, x - 1, y) ||
                !maskPixel(maskData, w, h, x + 1, y) ||
                !maskPixel(maskData, w, h, x, y - 1) ||
                !maskPixel(maskData, w, h, x, y + 1)) {
                arrput(pts, ((HullPoint){x, y}));
            }
        }
    }

    ptrdiff_t n = arrlen(pts);
    if (n < 3) {
        Jim_Obj *ret = Jim_NewListObj(interp, NULL, 0);
        for (ptrdiff_t i = 0; i < n; i++) {
            appendPointObj(interp, ret, pts[i], scaleX, scaleY);
        }
        Jim_Obj *visibleArc = Jim_NewListObj(interp, NULL, 0);
        for (ptrdiff_t i = 0; i < n; i++) {
            appendPointObj(interp, visibleArc, pts[i], scaleX, scaleY);
        }
        arrfree(pts);
        return makeFootPartsObj(interp, ret, visibleArc,
                                Jim_NewListObj(interp, NULL, 0),
                                Jim_NewListObj(interp, NULL, 0));
    }

    qsort(pts, (size_t)n, sizeof(HullPoint), hullPointCmp);

    HullPoint *unique = NULL;
    for (ptrdiff_t i = 0; i < n; i++) {
        if (i == 0 || pts[i].x != pts[i - 1].x || pts[i].y != pts[i - 1].y) {
            arrput(unique, pts[i]);
        }
    }
    arrfree(pts);
    pts = unique;
    n = arrlen(pts);

    HullPoint *hull = NULL;
    for (ptrdiff_t i = 0; i < n; i++) {
        while (arrlen(hull) >= 2 &&
               hullCross(hull[arrlen(hull) - 2], hull[arrlen(hull) - 1], pts[i]) <= 0) {
            arrpop(hull);
        }
        arrput(hull, pts[i]);
    }
    ptrdiff_t lowerLen = arrlen(hull);
    for (ptrdiff_t i = n - 2; i >= 0; i--) {
        while (arrlen(hull) > lowerLen &&
               hullCross(hull[arrlen(hull) - 2], hull[arrlen(hull) - 1], pts[i]) <= 0) {
            arrpop(hull);
        }
        arrput(hull, pts[i]);
        if (i == 0) break;
    }
    if (arrlen(hull) > 1) arrpop(hull);
    arrfree(pts);

    ptrdiff_t hn = arrlen(hull);
    Jim_Obj *ret = Jim_NewListObj(interp, NULL, 0);
    if (hn < 3) {
        for (ptrdiff_t i = 0; i < hn; i++) {
            appendPointObj(interp, ret, hull[i], scaleX, scaleY);
        }
        Jim_Obj *visibleArc = Jim_NewListObj(interp, NULL, 0);
        for (ptrdiff_t i = 0; i < hn; i++) {
            appendPointObj(interp, visibleArc, hull[i], scaleX, scaleY);
        }
        arrfree(hull);
        return makeFootPartsObj(interp, ret, visibleArc,
                                Jim_NewListObj(interp, NULL, 0),
                                Jim_NewListObj(interp, NULL, 0));
    }

    bool *visible = calloc((size_t)hn, sizeof(bool));
    ptrdiff_t visibleCount = 0;
    for (ptrdiff_t i = 0; i < hn; i++) {
        ptrdiff_t j = (i + 1) % hn;
        double ax = hull[i].x * scaleX;
        double ay = hull[i].y * scaleY;
        double bx = hull[j].x * scaleX;
        double by = hull[j].y * scaleY;
        if (hullCrossD(ax, ay, bx, by, pp[0], pp[1]) < 0) {
            visible[i] = true;
            visibleCount++;
        }
    }

    if (visibleCount == 0 || visibleCount == hn) {
        for (ptrdiff_t i = 0; i < hn; i++) {
            appendPointObj(interp, ret, hull[i], scaleX, scaleY);
        }
        Jim_Obj *visibleArc = Jim_NewListObj(interp, NULL, 0);
        for (ptrdiff_t i = 0; i < hn; i++) {
            appendPointObj(interp, visibleArc, hull[i], scaleX, scaleY);
        }
        free(visible);
        arrfree(hull);
        return makeFootPartsObj(interp, ret, visibleArc,
                                Jim_NewListObj(interp, NULL, 0),
                                Jim_NewListObj(interp, NULL, 0));
    }

    ptrdiff_t edge = 0;
    while (edge < hn && !visible[edge]) edge++;
    while (visible[(edge - 1 + hn) % hn]) {
        edge = (edge - 1 + hn) % hn;
    }

    HullPoint *arc = NULL;
    arrput(arc, hull[edge]);
    for (;;) {
        ptrdiff_t next = (edge + 1) % hn;
        arrput(arc, hull[next]);
        edge = next;
        if (!visible[edge]) break;
    }

    ptrdiff_t arcLen = arrlen(arc);
    Jim_Obj *visibleArc = Jim_NewListObj(interp, NULL, 0);
    Jim_Obj *reflectedArc = Jim_NewListObj(interp, NULL, 0);
    Jim_Obj *mirrorLine = Jim_NewListObj(interp, NULL, 0);

    for (ptrdiff_t i = 0; i < arcLen; i++) {
        appendPointObj(interp, ret, arc[i], scaleX, scaleY);
        appendPointObj(interp, visibleArc, arc[i], scaleX, scaleY);
    }

    if (arcLen >= 3) {
        double ax = arc[0].x * scaleX;
        double ay = arc[0].y * scaleY;
        double bx = arc[arcLen - 1].x * scaleX;
        double by = arc[arcLen - 1].y * scaleY;
        appendXYObj(interp, mirrorLine, ax, ay);
        appendXYObj(interp, mirrorLine, bx, by);
    }

    arrfree(arc);
    free(visible);
    arrfree(hull);
    return makeFootPartsObj(interp, ret, visibleArc, reflectedArc, mirrorLine);
}

set sam2FootContourLib [$cc compile]
Claim the SAM2 foot contour library is $sam2FootContourLib

fn cameraPrincipalPointInQuad {ql qInCamera} {
    package require linalg
    namespace import \
        ::math::linearalgebra::add \
        ::math::linearalgebra::sub \
        ::math::linearalgebra::scale \
        ::math::linearalgebra::dotproduct \
        ::math::linearalgebra::crossproduct

    lassign [$ql vertices $qInCamera] a b c d
    set n [crossproduct [sub $b $a] [sub $d $a]]
    set rayDir {0 0 1}
    set denom [dotproduct $n $rayDir]
    if {abs($denom) < 0.000001} {
        return {}
    }

    set t [expr {[dotproduct $n $a] / $denom}]
    if {$t <= 0} {
        return {}
    }

    return [$ql pointToXY $qInCamera [scale $t $rayDir] false]
}

When the quad library is /ql/ &\
     the quad changer is /quadChange/ &\
     the SAM2 foot contour library is /footContourLib/ &\
     a calibration from camera /camera/ to display /display/ is /calibration/ &\
     /v/ has resolved geometry /geom/ &\
     /someone/ wishes /obj/ has foot contour in /v/ &\
     /obj/ has mask /mask/ in /v/ with /...maskOpts/ &\
     /v/ has quad /vq/ {

    fn quadChange

    set vqCamera [quadChange $vq $camera]
    set pp [cameraPrincipalPointInQuad $ql $vqCamera]
    if {$pp eq {}} {
        return
    }

    set width [dict get $maskOpts width]
    set height [dict get $maskOpts height]
    set scaleWidth [expr {$width > 1 ? $width - 1 : 1}]
    set scaleHeight [expr {$height > 1 ? $height - 1 : 1}]
    set scaleX [expr {double($geom(width)) / double($scaleWidth)}]
    set scaleY [expr {double($geom(height)) / double($scaleHeight)}]
    set footContourParts [$footContourLib maskFootContourParts \
                              $width $height $mask $pp $scaleX $scaleY]
    set footContour [dict get $footContourParts footContour]

    if {[llength $footContour] >= 2} {
        Claim $obj has foot contour $footContour in $v
        Claim $obj has SAM2 foot contour parts $footContourParts in $v
    }
}

When the png library is /pngLib/ &\
     /v/ is a viewport {
    Wish the web server handles route [format {/sam2-foot-contour/%s$} $v] \
        with hidden true handler [list apply {{page pngLib} {
            local proc svgPoints {contour geom width height} {
                set points [list]
                foreach p $contour {
                    lassign $p x y
                    lappend points [format "%.3f,%.3f" \
                                        [expr {$x / $geom(width) * $width}] \
                                        [expr {$y / $geom(height) * $height}]]
                }
                return [join $points " "]
            }
            local proc jsString {s} {
                return "\"[string map [list "\\" "\\\\" "\"" "\\\"" "\n" "\\n" "\r" "\\r" "\t" "\\t"] $s]\""
            }

            set promptResults [Query! /anyone/ wishes $page tracks object /id/ with prompt /prompt/]
            lappend promptResults {*}[Query! /anyone/ wishes $page tracks object /id/ with antiprompt /prompt/]
            set ids [lsort -unique [lmap result $promptResults {
                dict get $result id
            }]]

            set entries [list]
            foreach id $ids {
                Wish $id has foot contour in $page

                set imageResults [Query! $id has SAM2 masked image /im/ in $page]
                set partsResults [Query! $id has SAM2 foot contour parts /parts/ in $page]
                set maskResults [Query! $id has mask /mask/ in $page with /...maskOpts/]
                set geomResults [Query! $page has resolved geometry /geom/]
                set body {<div class="missing">waiting for mask and foot contour</div>}

                if {[llength $imageResults] > 0 &&
                    [llength $partsResults] > 0 &&
                    [llength $maskResults] > 0 &&
                    [llength $geomResults] > 0} {

                    set imageResult [lindex $imageResults end]
                    dict with imageResult {
                        StatementAcquire! $__ref

                        set filename [format "/tmp/sam2-foot-contour-%s-%s.png" \
                            [string map {/ _ { } _} $page] \
                            [string map {/ _ { } _} $id]]
                        $pngLib saveAsPng $im $filename

                        set fsize [file size $filename]
                        set fd [open $filename r]
                        fconfigure $fd -translation binary
                        set imageData [read $fd $fsize]
                        close $fd

                        StatementRelease! $__ref
                    }

                    set parts [dict get [lindex $partsResults end] parts]
                    set maskOpts [dict get [lindex $maskResults end] maskOpts]
                    set geom [dict get [lindex $geomResults end] geom]
                    set width [dict get $maskOpts width]
                    set height [dict get $maskOpts height]

                    set visiblePoints [svgPoints [dict getdef $parts visibleArc {}] \
                                           $geom $width $height]
                    set reflectedPoints [svgPoints [dict getdef $parts reflectedArc {}] \
                                             $geom $width $height]
                    set mirrorPoints [svgPoints [dict getdef $parts mirrorLine {}] \
                                          $geom $width $height]

                    set b64 [binary encode base64 $imageData]
                    set body [subst {
                        <div class="overlay" data-object-id="[htmlEscape $id]"
                             data-width="$width" data-height="$height"
                             data-geom-width="$geom(width)" data-geom-height="$geom(height)">
                            <img src="data:image/png;base64,$b64">
                            <svg viewBox="0 0 $width $height" preserveAspectRatio="none">
                                <polyline class="visible" points="$visiblePoints"></polyline>
                                <polyline class="reflected" points="$reflectedPoints"></polyline>
                                <polyline class="mirror" points="$mirrorPoints"></polyline>
                            </svg>
                        </div>
                    }]
                }

                lappend entries [format {<section><h2>%s</h2>%s</section>} \
                    $id $body]
            }

            html [subst {
                <html>
                <head>
                    <title>SAM2 foot contour $page</title>
                    <script src="/lib/folk.js"></script>
                    <style>
                        body { font-family: sans-serif; margin: 24px; }
                        main { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
                        section { border: 1px solid #ddd; padding: 12px; }
                        h2 { font-size: 14px; margin: 0 0 8px; word-break: break-word; }
                        .overlay { position: relative; display: inline-block; max-width: 100%; background: #111; cursor: crosshair; }
                        img { display: block; max-width: 100%; }
                        svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
                        polyline { fill: none; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
                        .visible { stroke: #00ff4a; stroke-width: 3; }
                        .reflected { stroke: #00e5ff; stroke-width: 3; }
                        .mirror { stroke: #ff9f1a; stroke-width: 2; stroke-dasharray: 8 5; }
                        .missing { color: #777; font-size: 14px; }
                    </style>
                </head>
                <body>
                    <h1>SAM2 foot contour $page</h1>
                    <main>
                        [join $entries "\n"]
                    </main>
                    <script>
                        const folk = new FolkWS();
                        const page = [jsString $page];
                        let promptSeq = 0;
                        document.querySelectorAll('.overlay').forEach((overlay) => {
                            overlay.addEventListener('click', (event) => {
                                event.preventDefault();

                                const rect = overlay.getBoundingClientRect();
                                const px = (event.clientX - rect.left) / rect.width * Number(overlay.dataset.width);
                                const py = (event.clientY - rect.top) / rect.height * Number(overlay.dataset.height);
                                const x = px / Number(overlay.dataset.width) * Number(overlay.dataset.geomWidth);
                                const y = py / Number(overlay.dataset.height) * Number(overlay.dataset.geomHeight);
                                const objectId = overlay.dataset.objectId;
                                const antiprompt = event.altKey;
                                const key = 'sam2-foot-contour prompt ' + page + ' ' + objectId + ' ' + Date.now() + '-' + promptSeq++;
                                const statement = antiprompt
                                    ? 'Wish ' + dump(page) + ' tracks object ' + dump(objectId) + ' with antiprompt ' + dump(\[x, y])
                                    : 'Wish ' + dump(page) + ' tracks object ' + dump(objectId) + ' with prompt ' + dump(\[x, y]);
                                folk.hold(key, statement, 'sam2-foot-contour');
                            });
                        });
                    </script>
                </body>
                </html>
            }]
        }} $v $pngLib]
}
