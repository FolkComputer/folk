When when the DINOv2 image embedder is /any/ /any/ with environment /any/ {
    Wish -keep 500ms to load the DINOv2 image embedder
}

When /someone/ wishes to load the DINOv2 image embedder {
    Wish to really load the DINOv2 image embedder
}

When /someone/ wishes to really load the DINOv2 image embedder &\
     the image uvx argtype definer is /defineImageArgtype/ {
    fn defineImageArgtype

    set py [Uvx --with transformers --with pillow --with torch \
                --with torchvision \
                {*}$([file exists /etc/OpenCL/vendors/intel.icd] ?
                  [list --with openvino] : [list])]
    defineImageArgtype $py

    $py exec {
        import sys
        import time
        import importlib.util
        from functools import lru_cache
        from threading import Lock
        from types import SimpleNamespace

        import numpy as np
        import torch
        import torch.nn.functional as F
        from PIL import Image
        from transformers import AutoImageProcessor, AutoModel

        if torch.cuda.is_available():
            device = "cuda"
        elif torch.backends.mps.is_available():
            device = "mps"
        else:
            device = "cpu"

        model_name = "facebook/dinov2-with-registers-small"
        processor = AutoImageProcessor.from_pretrained(model_name)
        model = AutoModel.from_pretrained(model_name).to(device).eval()
        infer = model
        backend = device
        if device == "cpu" and importlib.util.find_spec("openvino"):
            import openvino as ov
            core = ov.Core()
            if "GPU" in core.available_devices:
                class Features(torch.nn.Module):
                    def __init__(self):
                        super().__init__()
                        self.model = model

                    def forward(self, pixel_values):
                        return self.model(pixel_values=pixel_values).last_hidden_state

                features = Features().eval()
                inference_lock = Lock()

                # Slices can change shape; bound the GPU model cache.
                @lru_cache(maxsize=4)
                def compiled_features(shape):
                    converted = ov.convert_model(
                        features, example_input=torch.zeros(shape), input=[list(shape)]
                    )
                    return core.compile_model(
                        converted, "GPU", {"PERFORMANCE_HINT": "LATENCY"}
                    )

                def infer(pixel_values):
                    # CompiledModel.__call__ reuses a request. Copy its output
                    # before another embedding/heatmap call can overwrite it.
                    with inference_lock:
                        compiled = compiled_features(tuple(pixel_values.shape))
                        hidden = compiled([pixel_values.numpy()])[0].copy()
                    return SimpleNamespace(last_hidden_state=torch.from_numpy(hidden))

                backend = "openvino:GPU"
        template_cache = {}
        pose_cache = {}

        def spatial_patch_tokens(output):
            """Discard CLS/register tokens and return image-grid tokens only."""
            first_patch = 1 + getattr(model.config, "num_register_tokens", 0)
            return output.last_hidden_state[:, first_patch:, :]

        def localization_score_maps(image, embeddings):
            inputs = processor(
                images=image.convert("RGB"),
                return_tensors="pt",
                do_center_crop=False,
            )
            inputs = {
                name: value.to(device) for name, value in inputs.items()
            }

            with torch.inference_mode():
                output = infer(**inputs)
                patches = F.normalize(spatial_patch_tokens(output), dim=-1)
                prototypes = F.normalize(
                    torch.tensor(
                        embeddings, dtype=patches.dtype, device=device
                    ),
                    dim=-1,
                )
                patch_size = model.config.patch_size
                grid_height = inputs["pixel_values"].shape[-2] // patch_size
                grid_width = inputs["pixel_values"].shape[-1] // patch_size
                score_maps = (patches[0] @ prototypes.T).T.reshape(
                    len(embeddings), grid_height, grid_width
                )

            return score_maps, grid_width, grid_height

        def reference_pose_angles(pose_angles, pose_counts):
            # Empty entries preserve legacy, reference-relative rotations.
            if not pose_angles:
                return [None] * len(pose_counts)
            if len(pose_angles) != len(pose_counts):
                raise ValueError("pose angle and object counts must match")
            result = []
            for angles, count in zip(pose_angles, pose_counts):
                if not angles:
                    result.append(None)
                elif len(angles) != count or not np.isfinite(angles).all():
                    raise ValueError("each pose needs one finite angle in radians")
                else:
                    result.append(tuple(angles))
            return result

        def offset_match_rotation(match, offset):
            if match is None:
                return None
            score, x, y, rotation = match
            return [score, x, y, float((rotation + offset + np.pi) % (2 * np.pi) - np.pi)]

        def ncc_template(filename):
            if filename in template_cache:
                return template_cache[filename]
            rgb = np.array(Image.open(filename).convert("RGB"), copy=True)
            image_height, image_width = rgb.shape[:2]
            mask = np.any(rgb != 128, axis=-1)
            ys, xs = np.nonzero(mask)
            if not len(xs):
                raise ValueError(f"empty registration template: {filename}")
            left, right = xs.min(), xs.max() + 1
            top, bottom = ys.min(), ys.max() + 1
            rgb = torch.from_numpy(rgb[top:bottom, left:right]).to(device)
            gray = (rgb.float() @ torch.tensor(
                [0.299, 0.587, 0.114], device=device
            ) / 255.0)[None, None]
            # Gaussian centered on the original registration point, not the
            # foreground bounds: half weight halfway to each image edge.
            y, x = np.ogrid[top:bottom, left:right]
            distance2 = (
                ((x - (image_width - 1) / 2.0) / max((image_width - 1) / 4.0, 1.0)) ** 2 +
                ((y - (image_height - 1) / 2.0) / max((image_height - 1) / 4.0, 1.0)) ** 2
            )
            mask = mask[top:bottom, left:right] * np.exp(-np.log(2.0) * distance2)
            mask = torch.from_numpy(mask).to(
                device=device, dtype=torch.float32
            )[None, None]
            result = (
                gray, mask,
                (image_width - 1) / 2.0 - left,
                (image_height - 1) / 2.0 - top,
            )
            template_cache[filename] = result
            return result

        @lru_cache(maxsize=256)
        def rotated_ncc_template(filename, angle, factor=1):
            gray, mask, anchor_x, anchor_y = ncc_template(filename)
            height, width = gray.shape[-2:]
            theta = np.deg2rad(angle)
            c, s = float(np.cos(theta)), float(np.sin(theta))
            # Positive angles turn clockwise in image coordinates (y down).
            out_width = int(np.ceil((abs(c) * width + abs(s) * height) / factor))
            out_height = int(np.ceil((abs(s) * width + abs(c) * height) / factor))
            y, x = torch.meshgrid(
                torch.arange(out_height, device=device, dtype=torch.float32),
                torch.arange(out_width, device=device, dtype=torch.float32),
                indexing="ij",
            )
            x = (x - (out_width - 1) / 2) * factor
            y = (y - (out_height - 1) / 2) * factor
            grid = torch.stack((
                2 * (c * x + s * y) / width,
                2 * (-s * x + c * y) / height,
            ), dim=-1)[None]
            # Premultiply before resampling so excluded background cannot bleed
            # into the foreground. Downsample with area filtering first.
            source = torch.cat((gray * mask, mask), dim=1)
            if factor > 1:
                source = F.interpolate(source, size=(
                    max(1, int(np.ceil(height / factor))),
                    max(1, int(np.ceil(width / factor))),
                ), mode="area")
            rotated = F.grid_sample(source, grid, align_corners=False)
            weights = rotated[:, 1:2]
            values = rotated[:, :1] / weights.clamp_min(1e-12)
            count = weights.sum().clamp_min(1e-12)
            centered = values - (values * weights).sum() / count
            ax, ay = anchor_x - (width - 1) / 2, anchor_y - (height - 1) / 2
            return (
                centered * weights, weights,
                (centered.square() * weights).sum().sqrt(),
                (out_width - 1) / 2 + (c * ax - s * ay) / factor,
                (out_height - 1) / 2 + (s * ax + c * ay) / factor,
            )

        def fft_correlate2d(image, kernel):
            """Valid 2-D cross-correlation via uncached, zero-padded FFTs."""
            image_height, image_width = image.shape[-2:]
            kernel_height, kernel_width = kernel.shape[-2:]
            fft_shape = (
                image_height + kernel_height - 1,
                image_width + kernel_width - 1,
            )
            correlation = torch.fft.irfft2(
                torch.fft.rfft2(image, s=fft_shape) *
                torch.fft.rfft2(kernel, s=fft_shape).conj(),
                s=fft_shape,
            )
            return correlation[
                ..., :image_height - kernel_height + 1,
                :image_width - kernel_width + 1,
            ]

        def ncc_match(image, prepared, coarse_x, coarse_y, radius, cell_size,
                      prior=None):
            template, mask, template_norm, center_x, center_y = \
                prepared
            count = mask.sum()
            # Correlation is undefined for flat templates/windows. Require at
            # least one grayscale level of standard deviation (on a 0-1 scale).
            min_energy = count * (1.0 / 255.0) ** 2
            if template_norm.square() <= min_energy:
                return None
            height, width = template.shape[-2:]
            min_left = max(0, int(np.floor(coarse_x - center_x - radius)))
            max_left = min(
                image.shape[-1] - width,
                int(np.ceil(coarse_x - center_x + radius)),
            )
            min_top = max(0, int(np.floor(coarse_y - center_y - radius)))
            max_top = min(
                image.shape[-2] - height,
                int(np.ceil(coarse_y - center_y + radius)),
            )
            if min_left > max_left or min_top > max_top:
                return None
            search = image[..., min_top:max_top + height, min_left:max_left + width]
            # Remove the ROI's DC level before variance calculations to reduce
            # cancellation on uniform backgrounds; each window is still centered.
            search = search - search.mean()
            with torch.inference_mode():
                # Intentionally recompute all search and template transforms to
                # establish a simple FFT baseline before caching or batching.
                total = fft_correlate2d(search, mask)
                numerator = fft_correlate2d(search, template) - total * template.sum() / count
                square_total = fft_correlate2d(search.square(), mask)
                window_energy = (square_total - total.square() / count).clamp_min(0)
                scores = numerator / (template_norm * window_energy.clamp_min(1e-12).sqrt())
                scores = scores.clamp(-1.0, 1.0).masked_fill(window_energy <= min_energy, -2.0)
                # Rank by proximity to DINO, but return raw NCC for confidence.
                prior_x, prior_y = prior or (coarse_x, coarse_y)
                dx = (torch.arange(scores.shape[-1], device=device) +
                      min_left + center_x - prior_x) / cell_size
                dy = (torch.arange(scores.shape[-2], device=device) +
                      min_top + center_y - prior_y) / cell_size
                ranks = scores - 0.02 * (dy[:, None].square() + dx[None, :].square())
                ranks = ranks.masked_fill(scores < -1.0, -torch.inf)
                index = ranks.flatten().argmax()
                score = scores.flatten()[index]
            if float(score) < -1.0:
                return None
            match_x = int(index) % scores.shape[-1]
            match_y = int(index) // scores.shape[-1]
            return [
                float(score), min_left + match_x + center_x,
                min_top + match_y + center_y,
            ]

        def ncc_center(image, filename, coarse_x, coarse_y, radius, cell_size,
                       previous=None):
            """Return NCC, registration x/y, clockwise rotation in radians."""
            gray, _, _, _ = ncc_template(filename)
            factor = max(1, int(np.ceil(max(gray.shape[-2:]) / 48)))
            search = torch.from_numpy(np.array(image, copy=True)).to(device).float()
            search = (search @ torch.tensor(
                [0.299, 0.587, 0.114], device=device
            ) / 255.0)[None, None]
            factor = min(factor, *search.shape[-2:])
            small = F.avg_pool2d(search, factor) if factor > 1 else search

            def evaluate(angle, scale, x=coarse_x, y=coarse_y, reach=radius):
                angle = angle % 360
                match = ncc_match(
                    small if scale > 1 else search,
                    rotated_ncc_template(filename, angle, scale),
                    (x + 0.5) / scale - 0.5,
                    (y + 0.5) / scale - 0.5,
                    reach / scale, cell_size / scale,
                    prior=((coarse_x + 0.5) / scale - 0.5,
                           (coarse_y + 0.5) / scale - 0.5),
                )
                if match is None:
                    return None
                score, x, y = match
                x, y = (x + 0.5) * scale - 0.5, (y + 0.5) * scale - 0.5
                rank = score - 0.02 * (
                    ((x - coarse_x) / cell_size) ** 2 +
                    ((y - coarse_y) / cell_size) ** 2
                )
                return rank, score, x, y, angle

            def refine(seeds):
                # Keep angular refinement cheap too: only the final +/-3 degree
                # stage needs full-resolution templates and a small position box.
                candidates = []
                for seed in seeds:
                    for delta in range(-15, 16, 3):
                        match = evaluate(seed[4] + delta, factor, seed[2], seed[3],
                                         max(4 * factor, max(gray.shape[-2:]) * 0.15))
                        if match is not None:
                            candidates.append(match)
                if not candidates:
                    return None
                best = max(candidates)
                fine = [m for delta in np.arange(-3, 3.01, 0.5)
                        if (m := evaluate(best[4] + float(delta), 1,
                                          best[2], best[3], max(3, 2 * factor)))
                        is not None]
                return max(fine) if fine else None

            def result(best):
                _, score, x, y, angle = best
                return [score, x, y, float(np.deg2rad((angle + 180) % 360 - 180))]

            if previous is not None:
                old_score, old_x, old_y, old_rotation = previous
                old_angle = round(float(np.rad2deg(old_rotation)) * 2) / 2
                reach = min(radius, max(12, cell_size / 2))
                nearby = [m for delta in range(-12, 13, 3)
                          if (m := evaluate(old_angle + delta, factor,
                                            old_x, old_y, reach)) is not None]
                if nearby:
                    seed = max(nearby)
                    fine = [m for delta in np.arange(-3, 3.01, 0.5)
                            if (m := evaluate(seed[4] + float(delta), 1,
                                              seed[2], seed[3], max(3, 2 * factor)))
                            is not None]
                    if fine:
                        best = max(fine)
                        turn = abs((best[4] - old_angle + 180) % 360 - 180)
                        # Weak or boundary matches trigger global reacquisition.
                        if (best[1] >= max(0.65, old_score - 0.15) and turn < 12 and
                                max(abs(best[2] - old_x), abs(best[3] - old_y)) < reach * 0.8):
                            return result(best)

            candidates = [m for a in range(0, 360, 15)
                          if (m := evaluate(a, factor)) is not None]
            best = refine(sorted(candidates, reverse=True)[:3]) if candidates else None
            return result(best) if best is not None else None

        print(f"dinov2: Loaded {model_name} on {backend}.",
              file=sys.stderr, flush=True)
    }

    $py def embedImage {Image image} {
        rgb = image.convert("RGB")
        foreground = torch.from_numpy(np.array(rgb, copy=True))
        foreground = foreground.ne(128).any(dim=-1).float()[None, None]
        inputs = processor(
            images=rgb, return_tensors="pt", do_center_crop=False
        )
        inputs = {name: value.to(device) for name, value in inputs.items()}

        with torch.inference_mode():
            output = infer(**inputs)
            patches = spatial_patch_tokens(output)
            patch_size = model.config.patch_size
            foreground = F.interpolate(
                foreground,
                size=inputs["pixel_values"].shape[-2:],
                mode="area",
            ).to(device)
            weights = F.avg_pool2d(
                foreground, kernel_size=patch_size, stride=patch_size
            ).flatten(1)
            embedding = F.normalize(
                (patches * weights.unsqueeze(-1)).sum(dim=1) /
                weights.sum(dim=1, keepdim=True).clamp_min(1e-6),
                dim=-1,
            )

        return embedding[0].float().cpu().tolist()
    }

    $py def localizeObjectCenters {
            Image image
            {list list list num} object_embeddings
            {list list str} template_filenames
            num coarse_threshold
            num radius_cells
            {list list num} pose_angles} {
        if not object_embeddings:
            return []
        if len(object_embeddings) != len(template_filenames):
            raise ValueError(
                "object embedding and template counts must be equal"
            )
        pose_counts = [len(poses) for poses in object_embeddings]
        if any(count == 0 for count in pose_counts):
            raise ValueError("each object must have at least one pose")
        if any(len(filenames) != count for filenames, count in zip(
                template_filenames, pose_counts)):
            raise ValueError("embedding and template pose counts must match")
        reference_angles = reference_pose_angles(pose_angles, pose_counts)

        inputs = processor(
            images=image.convert("RGB"),
            return_tensors="pt",
            do_center_crop=False,
        )
        inputs = {name: value.to(device) for name, value in inputs.items()}
        with torch.inference_mode():
            output = infer(**inputs)
            patches = F.normalize(spatial_patch_tokens(output), dim=-1)
            object_prototypes = F.normalize(
                torch.tensor(
                    [embedding for poses in object_embeddings
                     for embedding in poses],
                    dtype=patches.dtype,
                    device=device,
                ),
                dim=-1,
            )
            patch_size = model.config.patch_size
            grid_height = inputs["pixel_values"].shape[-2] // patch_size
            grid_width = inputs["pixel_values"].shape[-1] // patch_size
            object_maps = (patches[0] @ object_prototypes.T).T.reshape(
                sum(pose_counts), grid_height, grid_width
            )

            cell_width = image.width / grid_width
            cell_height = image.height / grid_height
            radius = radius_cells * max(cell_width, cell_height)
            results = []
            # Known reference angles let tracking survive reference switches.
            # Legacy registrations still keep one track per selected reference.
            now = time.monotonic()
            for key, value in list(pose_cache.items()):
                if now - value[0] > 1.0:
                    pose_cache.pop(key, None)
            offset = 0
            for filenames, pose_count, angles in zip(
                    template_filenames, pose_counts, reference_angles):
                pose_maps = object_maps[offset:offset + pose_count]
                pose_scores, pose_indices = pose_maps.flatten(1).max(dim=1)
                pose = int(pose_scores.argmax())
                coarse_score = float(pose_scores[pose])
                coarse_index = int(pose_indices[pose])
                coarse_x = ((coarse_index % grid_width) + 0.5) * cell_width
                coarse_y = ((coarse_index // grid_width) + 0.5) * cell_height
                reference_angle = angles[pose] if angles is not None else 0.0
                key = (tuple(filenames), angles if angles is not None else pose, image.size)
                cached = pose_cache.get(key)
                previous = cached[1] if cached and cached[2] < 30 else None
                if previous and max(abs(previous[1] - coarse_x),
                                    abs(previous[2] - coarse_y)) > radius:
                    previous = None
                # NCC searches relative to this template; the cache and output
                # use the common zero direction recorded during registration.
                relative_previous = offset_match_rotation(previous, -reference_angle)
                match = None if coarse_score < coarse_threshold else \
                    ncc_center(
                        image.convert("RGB"), filenames[pose],
                        coarse_x, coarse_y, radius, max(cell_width, cell_height),
                        previous=relative_previous,
                    )
                match = offset_match_rotation(match, reference_angle)
                if match is not None and match[0] >= 0.65:
                    pose_cache[key] = (time.monotonic(), match,
                                       cached[2] + 1 if previous else 0)
                else:
                    pose_cache.pop(key, None)
                center_score, pixel_x, pixel_y, rotation = match or [
                    -2.0, coarse_x, coarse_y, 0.0
                ]
                # coarse confidence, NCC confidence, registration x/y, scale x/y,
                # clockwise radians in the registration's common frame when
                # pose angles are supplied, otherwise relative to the reference.
                # As before, NCC=-2 means refinement failed (angle then unknown).
                results.append([
                    coarse_score, center_score,
                    pixel_x, pixel_y,
                    1.0, 1.0, rotation,
                ])
                offset += pose_count
        return results
    }

    $py def heatmapsImage {Image image {list list num} embeddings} {
        if not embeddings:
            return []

        score_maps, grid_width, grid_height = localization_score_maps(
            image, embeddings
        )
        maps = score_maps.float().cpu().flatten(1).tolist()
        return [grid_width, grid_height, maps]
    }

    fn DINOv2Heatmaps {im embeddings} {
        return [$py heatmapsImage $im $embeddings]
    }
    fn DINOv2LocalizeObjectCenters {
            im embeddings templateFilenames coarseThreshold radiusCells
            {poseAngles {}}} {
        return [$py localizeObjectCenters \
            $im $embeddings $templateFilenames $coarseThreshold $radiusCells \
            $poseAngles]
    }

    fn DINOv2 {im} { return [$py embedImage $im] }
    Claim the DINOv2 image embedder is [fn DINOv2]
    Claim the DINOv2 image heatmapper is [fn DINOv2Heatmaps]
    Claim the DINOv2 object center localizer is \
        [fn DINOv2LocalizeObjectCenters]
}
