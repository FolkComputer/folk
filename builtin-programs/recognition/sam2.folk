When when the SAM2 segmenter is /any/ /any/ with environment /any/ {
    Wish -keep 500ms to load SAM2
}

When /someone/ wishes to load SAM2 &\
     the image uvx argtype definer is /defineImageArgtype/ {
    fn defineImageArgtype

    set py [Uvx --with pillow --with torch --with numpy \
                --with huggingface_hub \
                --with "git+https://github.com/osnr/segment-anything-2-real-time.git"]

    defineImageArgtype $py

    $py exec {
        import os
        import sys
        import importlib.util
        import struct
        print(f"sam2: Boot (PID={os.getpid()})", file=sys.stderr)

        import torch
        import numpy as np
        import threading
        from hydra import compose
        from hydra.utils import instantiate
        from huggingface_hub import hf_hub_download
        from omegaconf import OmegaConf
        from sam2.build_sam import _load_checkpoint

        if torch.cuda.is_available():
            device = "cuda"
        elif torch.backends.mps.is_available():
            device = "mps"
        else:
            device = "cpu"

        vendored_predictor_path = os.path.abspath("vendor/sam2_camera_predictor.py")
        vendored_predictor_module = "folk_sam2_camera_predictor"
        spec = importlib.util.spec_from_file_location(
            vendored_predictor_module,
            vendored_predictor_path,
        )
        if spec is None or spec.loader is None:
            raise RuntimeError(f"sam2: Could not load {vendored_predictor_path}")
        sam2_camera_predictor = importlib.util.module_from_spec(spec)
        sys.modules[vendored_predictor_module] = sam2_camera_predictor
        spec.loader.exec_module(sam2_camera_predictor)

        def build_sam2_camera_predictor(
            config_file,
            ckpt_path=None,
            mode="eval",
            hydra_overrides_extra=[],
            apply_postprocessing=True,
            vos_optimized=False,
        ):
            hydra_overrides = [
                f"++model._target_={vendored_predictor_module}.SAM2CameraPredictor",
            ]

            if vos_optimized:
                hydra_overrides = [
                    f"++model._target_={vendored_predictor_module}.SAM2CameraPredictorVOS",
                ]

            if apply_postprocessing:
                hydra_overrides_extra = hydra_overrides_extra.copy()
                hydra_overrides_extra += [
                    "++model.sam_mask_decoder_extra_args.dynamic_multimask_via_stability=true",
                    "++model.sam_mask_decoder_extra_args.dynamic_multimask_stability_delta=0.05",
                    "++model.sam_mask_decoder_extra_args.dynamic_multimask_stability_thresh=0.98",
                    "++model.binarize_mask_from_pts_for_mem_enc=true",
                    "++model.fill_hole_area=8",
                ]
            hydra_overrides.extend(hydra_overrides_extra)

            cfg = compose(config_name=config_file, overrides=hydra_overrides)
            OmegaConf.resolve(cfg)
            model = instantiate(cfg.model, _recursive_=True)
            _load_checkpoint(model, ckpt_path)
            model = model.to(device)
            if mode == "eval":
                model.eval()
            return model

        model_cfg = "configs/sam2.1/sam2.1_hiera_s.yaml"
        checkpoint = hf_hub_download(
            repo_id="facebook/sam2.1-hiera-small",
            filename="sam2.1_hiera_small.pt",
        )

        print(f"sam2: Loading camera predictor.", file=sys.stderr)
        predictor = build_sam2_camera_predictor(model_cfg, checkpoint)
        predictor_initialized = False
        predictor_prompt_bboxes = []
        predictor_lock = threading.Lock()
        print(f"sam2: Using device: {device}", file=sys.stderr, flush=True)
    }

    $py def segment {Image image {list list num} pointCoords {list num} pointLabels} {
        global predictor_initialized
        image_np = np.array(image.convert("RGB"))
        with predictor_lock, torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
            if not predictor_initialized:
                predictor.load_first_frame(image_np)
                predictor_initialized = True
                _, out_obj_ids, out_mask_logits = predictor.add_new_prompt(
                    frame_idx=0,
                    obj_id=1,
                    points=pointCoords,
                    labels=pointLabels,
                )
            else:
                # takes ~25ms on folk-hex
                out_obj_ids, out_mask_logits = predictor.track(image_np)

        # takes ~40ms on folk-hex
        masks = (out_mask_logits[:, 0] > 0).detach().cpu().numpy()
        assert len(masks) == len(out_obj_ids), (
            f"sam2: got {len(masks)} masks for {len(out_obj_ids)} object ids"
        )

        ret = bytearray()
        ret.extend(struct.pack("<I", len(out_obj_ids)))

        for idx, obj_id in enumerate(out_obj_ids):
            mask = np.ascontiguousarray(masks[idx].astype(np.uint8) * 255)
            mask_bytes = mask.tobytes()
            ret.extend(struct.pack("<qI", int(obj_id), len(mask_bytes)))
            ret.extend(mask_bytes)

        return ret
    }

    $py def trackObjects {Image image {list num} objIds {list list num} promptBboxes} {
        global predictor_initialized
        global predictor_prompt_bboxes
        image_np = np.array(image.convert("RGB"))

        if len(objIds) != len(promptBboxes):
            raise ValueError(
                f"sam2: got {len(objIds)} object ids and {len(promptBboxes)} prompts"
            )

        objIds = [int(obj_id) for obj_id in objIds]
        promptBboxes = [list(map(float, bbox)) for bbox in promptBboxes]

        with predictor_lock, torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
            existing_obj_ids = []
            if predictor_initialized:
                existing_obj_ids = list(predictor.condition_state.get("obj_ids", []))

            # The vendored camera predictor cannot add a new target after tracking
            # has started. Restart the tracking state whenever the requested object
            # set changes; callers keep object identity through objIds.
            if (
                (not predictor_initialized)
                or existing_obj_ids != objIds
                or predictor_prompt_bboxes != promptBboxes
            ):
                predictor.load_first_frame(image_np)
                predictor_initialized = True
                predictor_prompt_bboxes = promptBboxes

                out_obj_ids = []
                out_mask_logits = []
                for obj_id, bbox in zip(objIds, promptBboxes):
                    _, out_obj_ids, out_mask_logits = predictor.add_new_prompt(
                        frame_idx=0,
                        obj_id=obj_id,
                        bbox=bbox,
                    )
            else:
                out_obj_ids, out_mask_logits = predictor.track(image_np)

        masks = (out_mask_logits[:, 0] > 0).detach().cpu().numpy()
        assert len(masks) == len(out_obj_ids), (
            f"sam2: got {len(masks)} masks for {len(out_obj_ids)} object ids"
        )

        ret = bytearray()
        ret.extend(struct.pack("<I", len(out_obj_ids)))

        for idx, obj_id in enumerate(out_obj_ids):
            mask = np.ascontiguousarray(masks[idx].astype(np.uint8) * 255)
            mask_bytes = mask.tobytes()
            ret.extend(struct.pack("<qI", int(obj_id), len(mask_bytes)))
            ret.extend(mask_bytes)

        return ret
    }

    fn decodeSAM2Masks {bytes} {
        set offset 0

        if {[binary scan $bytes @${offset}i count] != 1} {
            error "SAM2: could not decode object count"
        }
        incr offset 4

        set ret {}
        for {set i 0} {$i < $count} {incr i} {
            if {[binary scan $bytes @${offset}q objId] != 1} {
                error "SAM2: could not decode object id $i"
            }
            set objId [expr {int($objId)}]
            incr offset 8

            if {[binary scan $bytes @${offset}i maskLen] != 1} {
                error "SAM2: could not decode mask length $i"
            }
            incr offset 4

            set maskEnd [expr {$offset + $maskLen - 1}]
            set maskBytes [string range $bytes $offset $maskEnd]
            if {[string length $maskBytes] != $maskLen} {
                error "SAM2: short mask payload $i"
            }
            incr offset $maskLen

            lappend ret [list $objId $maskBytes]
        }

        if {$offset != [string length $bytes]} {
            error "SAM2: trailing bytes after decode"
        }
        return $ret
    }

    fn decodeSAM2Masks

    fn SAM2 args {
        decodeSAM2Masks [$py segment {*}$args]
    }
    fn SAM2Track args {
        decodeSAM2Masks [$py trackObjects {*}$args]
    }
    Claim the SAM2 segmenter is [fn SAM2]
    Claim the SAM2 object tracker is [fn SAM2Track]

    When the image library is /imageLib/ {
        set cc [C]
        $cc extend $imageLib
        $cc proc maskToBinaryImage {int width int height Jim_Obj* mask} Image {
            int maskLen = 0;
            const uint8_t *maskData = (const uint8_t *)Jim_GetString(mask, &maskLen);
            FOLK_ENSURE(maskLen == width * height);
            Image result = imageNew(width, height, 1, 0);
            for (int y = 0; y < height; y++) {
                for (int x = 0; x < width; x++) {
                    result.data[y * result.bytesPerRow + x] = maskData[y * width + x];
                }
            }
            return result;
        }
        $cc proc applyMaskToImage {Image im Jim_Obj* mask} Image {
            int maskLen = 0;
            const uint8_t *maskData = (const uint8_t *)Jim_GetString(mask, &maskLen);
            FOLK_ENSURE(maskLen == im.width * im.height);
            Image result = imageNew(im.width, im.height, im.components, im.uniq);
            for (int y = 0; y < im.height; y++) {
                for (int x = 0; x < im.width; x++) {
                    uint8_t m = maskData[y * im.width + x];
                    for (int c = 0; c < im.components; c++) {
                        result.data[y * result.bytesPerRow + x * im.components + c] =
                            m ? im.data[y * im.bytesPerRow + x * im.components + c] : 0;
                    }
                }
            }
            return result;
        }
        set maskToImageLib [$cc compile]
        Claim the SAM2 mask-to-image library is $maskToImageLib
    }
}

When /anyone/ wishes /page/ tracks object /id/ with prompt /prompt/ {
    Wish -keep 400ms $page has a SAM2 object tracker
    Wish -keep 400ms to load SAM2
}

When /someone/ wishes /page/ has a SAM2 object tracker &\
     the SAM2 object tracker is /sam2Track/ &\
     the SAM2 contours library is /sam2ContoursLib/ &\
     the quad library is /quadLib/ {
    fn sam2Track

    fn sam2PromptBbox {quadLib pageQuad geom slice prompt} {
        package require linalg
        namespace import \
            ::math::linearalgebra::sub \
            ::math::linearalgebra::dotproduct

        lassign [$quadLib vertices $pageQuad] topLeft topRight bottomRight bottomLeft

        set xAxis [sub $topRight $topLeft]
        set yAxis [sub $bottomLeft $topLeft]
        set xDen [dotproduct $xAxis $xAxis]
        set yDen [dotproduct $yAxis $yAxis]

        set first 1
        foreach v [$quadLib vertices $prompt] {
            set delta [sub $v $topLeft]
            set pageX [expr {[dotproduct $delta $xAxis] / $xDen * $geom(width)}]
            set pageY [expr {[dotproduct $delta $yAxis] / $yDen * $geom(height)}]
            set x [expr {$pageX / $geom(width) * $slice(width)}]
            set y [expr {$pageY / $geom(height) * $slice(height)}]

            if {$first} {
                set minX $x; set maxX $x
                set minY $y; set maxY $y
                set first 0
            } else {
                if {$x < $minX} { set minX $x }
                if {$x > $maxX} { set maxX $x }
                if {$y < $minY} { set minY $y }
                if {$y > $maxY} { set maxY $y }
            }
        }

        return [list $minX $minY $maxX $maxY]
    }

    When $page has resolved geometry /geom/ &\
         the quad changer is /quadChange/ &\
         -serially $page has camera slice /slice/ {
        fn quadChange

        set promptResults [Query! /anyone/ wishes $page tracks object /id/ with prompt /prompt/]
        if {[llength $promptResults] == 0} { return }

        Require! $page has quad /pageQuad/

        set promptsById [dict create]
        foreach result $promptResults {
            dict with result {
                dict set promptsById $id $prompt
            }
        }

        set sam2Ids {}
        set bboxes {}
        set idBySam2Id [dict create]
        set sam2Id 0
        set ids [lsort [dict keys $promptsById]]
        foreach id $ids {
            lappend sam2Ids $sam2Id
            set prompt [quadChange [dict get $promptsById $id] [$quadLib space $pageQuad]]
            lappend bboxes [sam2PromptBbox \
                $quadLib $pageQuad $geom $slice $prompt]
            dict set idBySam2Id $sam2Id $id
            incr sam2Id
        }

        set objects [sam2Track $slice $sam2Ids $bboxes]
        set scaleX [expr {double($geom(width)) / double($slice(width))}]
        set scaleY [expr {double($geom(height)) / double($slice(height))}]

        foreach object $objects {
            lassign $object sam2Id mask
            set id [dict get $idBySam2Id $sam2Id]

            set contours [$sam2ContoursLib findMaskContours \
                $slice(width) $slice(height) $mask \
                1.0 $scaleX $scaleY]

            Hold! -key [list sam2 track contours $page $id] \
                Claim $id has contours $contours in $page
        }
    }
}
