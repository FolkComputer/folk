set cc [dict link $C {}]

cc::include <pthread.h>
cc::include <assert.h>
cc::include <stdio.h>
cc::include <string.h>

cc::addcode {

// key = value of -on passed to Hold!,
// val = a dict whose key = the value passed to -key
// and whose value = its corresponding held statement
static Zicl_Dict* holds = NULL;
static int areHoldsInitialized = 0;

static pthread_mutex_t holdMutex = PTHREAD_MUTEX_INITIALIZER;

// Linear scan is fine here: `holds` has at most one entry per loaded/held
// file, not a hot-path lookup.
static Zicl_OptionalValue holdsGet(Zicl_Value key) {
    int n = Zicl_DictLength(holds);
    const Zicl_Value* items = Zicl_DictItems(holds);
    for (int i = 0; i < n; i++) {
        if (ziclEquals(items[2 * i], key)) return Zicl_Wrap(items[2 * i + 1]);
    }
    return ZICL_NONE;
}

}

cc::proc init {} void {
    pthread_mutex_lock(&holdMutex);
    if (!areHoldsInitialized) {
        areHoldsInitialized = 1;
        holds = ziclNewDict(NULL, 0);
    }
    pthread_mutex_unlock(&holdMutex);
}

cc::proc loadHolds {char* canonicalName char* holdStr} void {
    pthread_mutex_lock(&holdMutex);
    Zicl_Value key = ziclNewString(canonicalName, -1);
    Zicl_Value val = ziclNewString(holdStr, -1);
    ziclDictPut(holds, key, val);
    Zicl_Release(key);
    Zicl_Release(val);
    pthread_mutex_unlock(&holdMutex);
}

# canonical, tclEscaped, and filename all have to do with the value from -on in Hold!
cc::proc saveHold {char* canonical Zicl_Value tclEscaped char* filename Zicl_Value key Zicl_Value clause} void {
    pthread_mutex_lock(&holdMutex);
    assert(areHoldsInitialized);

    Zicl_Value canonicalKey = ziclNewString(canonical, -1);

    Zicl_Dict* holdDict;
    Zicl_OptionalValue existing = holdsGet(canonicalKey);
    if (Zicl_IsNone(existing)) {
        // this is this files' first hold
        holdDict = ziclNewDict(NULL, 0);
    } else {
        folkZiclAssert(Zicl_DupAsDict(interp, Zicl_Unwrap(existing), &holdDict));
    }

    // empty clause, e.g. removal
    int clauseLen;
    ziclGetString(clause, &clauseLen);
    if (clauseLen == 0) {
        int removed;
        folkZiclAssert(Zicl_DictRemove(holdDict, key, &removed));
    } else {
        ziclDictPut(holdDict, key, clause);
    }

    Zicl_Value newHoldVal = Zicl_BoxDict(holdDict);
    ziclDictPut(holds, canonicalKey, newHoldVal);
    Zicl_Release(canonicalKey);

    pthread_mutex_unlock(&holdMutex);

    // grab entries from dict
    int pairCount = Zicl_DictLength(holdDict);
    const Zicl_Value* dictItems = Zicl_DictItems(holdDict);

    if (pairCount > 0) {
        // write changes
        FILE* file = fopen(filename, "w+b");
        assert(file != NULL);

        // write the filename in tcl form at the top of the file
        int tclEscapedLen;
        const char* tclEscapedStr = ziclGetString(tclEscaped, &tclEscapedLen);
        fwrite(tclEscapedStr, 1, tclEscapedLen, file);
        fwrite("\n\n", 1, 2, file);

        // write all hash entries, with one entry per line
        for (int i = 0; i < pairCount; i++) {
            Zicl_Value pair[] = { dictItems[2 * i], dictItems[2 * i + 1] };
            Zicl_Value pairList = Zicl_BoxList(ziclNewList(pair, 2));

            int pairLen;
            const char* pairStr = ziclGetString(pairList, &pairLen);
            fwrite(pairStr, 1, pairLen, file);
            fwrite("\n", 1, 1, file);

            Zicl_Release(pairList);
        }

        fclose(file);
    } else {
        // the dict is empty, so we should delete its hold file if it exists
        remove(filename); // no need to check error
    }

    Zicl_ReleaseDict(holdDict);
}

set savedHoldsLib [cc::compile]
savedHoldsLib::init

When /someone/ wishes to deserialize namespace hold with directory /directory/ {
    set holdFiles [glob -nocomplain $directory/*]

    foreach holdFile $holdFiles {
        set fd [fopen $holdFile r]
        set holds [read $fd]
        close $fd

        # the hold file's first line is its canonical name (since
        # having / in a filename would mess a lot of stuff up),
        # while the rest of the file is a dict of holds
        set canonicalName [lindex $holds 0]
        set holdDict [lrange $holds 1 end]

        dict for {key clause} $holdDict {
            Hold! -on $canonicalName -key $key -- {*}$clause
        }

        savedHoldsLib::loadHolds $canonicalName $holdDict
    }

    Claim the saved holds are loaded
}

When the hold save directory is /holdDirectory/ {
    Subscribe: save hold on /on/ with key /key/ clause /clause/ {
        set canonical $on
        set tclEscaped [list $on]
        set escapedFilename ""

        # does it match builtin-programs/**/*.folk? If so,
        # chop off builtin-programs/
        if {![regexp {^builtin-programs/(.*\.folk)} $canonical -> escapedFilename]} {
            set escapedFilename $canonical
        }

        # replace all / with __
        set escapedFilename [regsub -all -- / $escapedFilename __]
        set escapedFilename "$holdDirectory/$escapedFilename"

        savedHoldsLib::saveHold $canonical $tclEscaped $escapedFilename \
            key::$clause
    }

    Claim saving is ready
}
