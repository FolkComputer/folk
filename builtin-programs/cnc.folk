# Stereo bed setup and local-coordinate toolpath preview.
fn cncRay {k w h point} {
    dict with k {}
    set u [expr {([lindex $point 0]*double($k(width))/$w-$cx)/$fx}]
    set v [expr {([lindex $point 1]*double($k(height))/$h-$cy)/$fy}]
    set x $u;set y $v
    for {set i 0} {$i<100} {incr i} {
        set r [expr {$x*$x+$y*$y}];set radial [expr {1+$k1*$r+$k2*$r*$r}]
        set nx [expr {($u-2*$p1*$x*$y-$p2*($r+2*$x*$x))/$radial}]
        set ny [expr {($v-$p1*($r+2*$y*$y)-2*$p2*$x*$y)/$radial}]
        if {!(abs($nx)<Inf && abs($ny)<Inf)} {error "Camera distortion did not converge."}
        set change [expr {abs($nx-$x)>abs($ny-$y)?abs($nx-$x):abs($ny-$y)}];set x $nx;set y $ny
        if {$change<1e-12} {return [list [expr {$x-$s/$fx*$y}] $y]}
    }
    error "Camera distortion did not converge."
}

fn cncProject {k w h point} {
    dict with k {}
    lassign $point x y z
    if {$z<=0} {error "The bed is behind a camera or projector."}
    set y [expr {double($y)/$z}];set x [expr {double($x)/$z+$s/$fx*$y}]
    set r [expr {$x*$x+$y*$y}];set radial [expr {1+$k1*$r+$k2*$r*$r}]
    list [expr {(($x*$radial+2*$p1*$x*$y+$p2*($r+2*$x*$x))*$fx+$cx)*$w/double($k(width))}] \
         [expr {(($y*$radial+$p1*($r+2*$y*$y)+2*$p2*$x*$y)*$fy+$cy)*$h/double($k(height))}]
}

# Convert unit-suffixed controller coordinates to meters.
fn cncPositionMeters {pos} {
    if {[llength $pos] != 3} {error "CNC position must contain three components"}
    set result {}
    foreach value $pos {
        if {![regexp {^(.+)(mm|in)$} $value -> amount suffix] || ![string is double -strict $amount]} {
            error "CNC position component must have an mm or in suffix: $value"
        }
        set scale [dict get {mm .001 in .0254} $suffix]
        lappend result [expr {double($amount)*$scale}]
    }
    return $result
}

fn cncGcodePaths {gcode pos} {
    fn cncPositionMeters
    lassign [cncPositionMeters $pos] x y
    set unit .0254;set absolute 1;set motion 0;set paths {};set points {};set lastRapid -1
    foreach line [split $gcode \n] {
        regsub -all {\([^)]*\)} $line {} line
        set line [string toupper [lindex [split $line {;}] 0]]
        set words {};set skip 0
        foreach {word letter value} [regexp -all -inline {([A-Z])\s*([-+]?(?:[0-9]+\.?[0-9]*|\.[0-9]+))} $line] {
            set value [expr {double($value)}]
            if {$letter eq {G}} {
                switch -- $value {
                    0.0 - 1.0 - 2.0 - 3.0 {set motion [expr {int($value)}]}
                    20.0 {set unit .0254}
                    21.0 {set unit .001}
                    90.0 {set absolute 1}
                    91.0 {set absolute 0}
                    17.0 {}
                    default {set skip 1}
                }
            } else {dict set words $letter $value}
        }
        # In particular, G4 X4 is a dwell, not an X move.
        if {$skip} continue
        if {![dict exists $words X] && ![dict exists $words Y] && !($motion in {2 3} && ([dict exists $words I] || [dict exists $words J]))} continue
        set nx $x;set ny $y
        if {[dict exists $words X]} {set nx [expr {$words(X)*$unit+($absolute?0:$x)}]}
        if {[dict exists $words Y]} {set ny [expr {$words(Y)*$unit+($absolute?0:$y)}]}
        set rapid [expr {$motion==0}]
        if {$rapid!=$lastRapid} {
            if {[llength $points]>1} {lappend paths [dict create rapid $lastRapid points $points]}
            set points [list [list $x $y]];set lastRapid $rapid
        }
        if {$motion in {2 3}} {
            if {![dict exists $words I] && ![dict exists $words J]} {error {CNC arcs need I/J center offsets}}
            set cx [expr {$x+[dict getdef $words I 0]*$unit}];set cy [expr {$y+[dict getdef $words J 0]*$unit}]
            set radius [expr {hypot($x-$cx,$y-$cy)}]
            if {$radius<=0} {error {CNC arc radius is zero}}
            set start [expr {atan2($y-$cy,$x-$cx)}]
            set sweep [expr {atan2($ny-$cy,$nx-$cx)-$start}]
            set tau [expr {2*acos(-1)}]
            if {$motion==2 && $sweep>=0} {set sweep [expr {$sweep-$tau}]}
            if {$motion==3 && $sweep<=0} {set sweep [expr {$sweep+$tau}]}
            # At most 0.25 mm chord error, with a five-degree angular cap.
            set cosine [expr {1-.00025/$radius}]
            set step [expr {2*acos($cosine < -1 ? -1 : $cosine)}]
            if {$step>acos(-1)/36} {set step [expr {acos(-1)/36}]}
            set count [expr {int(ceil(abs($sweep)/$step))}]
            if {$count<1} {set count 1}
            for {set i 1} {$i<$count} {incr i} {
                set angle [expr {$start+$sweep*$i/$count}]
                lappend points [list [expr {$cx+$radius*cos($angle)}] [expr {$cy+$radius*sin($angle)}]]
            }
        }
        if {$nx!=$x || $ny!=$y || $motion in {2 3}} {lappend points [list $nx $ny]}
        set x $nx;set y $ny
    }
    if {[llength $points]>1} {lappend paths [dict create rapid $lastRapid points $points]}
    return $paths
}

# A camera's extrinsics map camera coordinates into projector coordinates.
fn cncStereoGeometry {left right lk le rk re} {
    package require linalg
    namespace import ::math::linearalgebra::*
    fn cncRay
    fn cncProject

    if {[norm [sub $le(t) $re(t)]] < .01} {
        error "The calibrated stereo baseline is too small."
    }
    set selections [list $left $right]
    set intrinsics [list $lk $rk]
    set centers [list $le(t) $re(t)]
    set rotations [list [transpose $le(R)] [transpose $re(R)]]
    set projections {}
    set rays {}
    foreach selection $selections k $intrinsics R $rotations t $centers {
        set pixels $selection(points)
        set width $selection(width)
        set height $selection(height)
        if {[llength $pixels] != 5 || $width <= 0 || $height <= 0} {
            error "Select five points in each view."
        }
        foreach pixel $pixels {
            lassign $pixel x y
            if {[llength $pixel] != 2 || !(0 <= $x && $x < $width && 0 <= $y && $y < $height)} {
                error "A selected point is outside its image."
            }
        }
        set turnSign 0
        for {set i 0} {$i < 4} {incr i} {
            lassign [lindex $pixels $i] x y
            lassign [lindex $pixels [expr {($i + 1) % 4}]] bx by
            lassign [lindex $pixels [expr {($i + 2) % 4}]] cx cy
            set turn [expr {($bx-$x)*($cy-$by) - ($by-$y)*($cx-$bx)}]
            if {$turn == 0 || ($i && $turnSign*$turn <= 0)} {
                error "Click corners 1–4 in perimeter order."
            }
            set turnSign $turn
        }
        lappend projections [lmap row $R offset [scale -1 [matmul $R $t]] {
            concat $row [list $offset]
        }]
        lappend rays [lmap pixel $pixels {cncRay $k $width $height $pixel}]
    }

    set points {}
    for {set i 0} {$i < 5} {incr i} {
        set matrix {}
        foreach P $projections xy $rays {
            foreach coordinate [lindex $xy $i] row [lrange $P 0 1] {
                lappend matrix [sub [scale $coordinate [lindex $P 2]] $row]
            }
        }
        lassign [determineSVD $matrix] U singularValues V
        set v [getcol $V [lsearch -exact $singularValues [lindex [lsort -real $singularValues] 0]]]
        set w [lindex $v 3]
        if {abs($w) < 1e-10} {error "Point [expr {$i + 1}] did not triangulate."}
        set point [scale [expr {1.0/$w}] [lrange $v 0 2]]
        if {[lindex $point 2] <= 0} {error "A selected point is behind the projector."}
        foreach selection $selections k $intrinsics R $rotations t $centers {
            set uv [cncProject $k $selection(width) $selection(height) [matmul $R [sub $point $t]]]
            set distance [norm [sub $uv [lindex $selection(points) $i]]]
            if {!($distance <= 20)} {
                error "Point [expr {$i + 1}] does not line up between the cameras. Check the selections and calibration."
            }
        }
        lappend points $point
    }

    # Fit the bed plane to corners 1–4. Project point 5 onto that plane
    # so its XY location anchors the preview even if clicked on top of stock.
    set corners [lrange $points 0 3]
    set center [scale .25 [matmul [transpose $corners] {1 1 1 1}]]
    set centered [lmap p $corners {sub $p $center}]
    lassign [determineSVD $centered] U singularValues V
    set normal [getcol $V [lsearch -exact $singularValues [lindex [lsort -real $singularValues] 0]]]
    set deviations [lmap p $centered {dotproduct $p $normal}]
    set corners [lmap p $corners d $deviations {sub $p [scale $d $normal]}]
    lassign $corners p1 p2 p3 p4
    set xAxis [sub $p2 $p1]
    set yAxis [sub $p4 $p1]
    set xLength [norm $xAxis]
    set yLength [norm $yAxis]
    foreach d $deviations {
        if {abs($d) > .005 && abs($d) > .015*($xLength+$yLength)} {
            error "Corners 1–4 do not lie on the same plane."
        }
    }
    if {$xLength < .003} {error "The selected bed is too small."}
    set xAxis [scale [expr {1.0/$xLength}] $xAxis]
    set yAxis [sub $yAxis [scale [dotproduct $yAxis $xAxis] $xAxis]]
    set yLength [norm $yAxis]
    if {$yLength < .003} {error "The selected bed is too small."}
    set yAxis [scale [expr {1.0/$yLength}] $yAxis]

    set p5 [lindex $points 4]
    set origin [sub $p5 [scale [dotproduct [sub $p5 $center] $normal] $normal]]
    dict create origin $origin xAxis $xAxis yAxis $yAxis normal [crossproduct $xAxis $yAxis] corners $corners
}

# Match the live test at 3840 px: a 230 px tag with a 44 px white margin.
# Select calibration IDs normally used for projection, avoiding printed IDs.
# Target the probe at cutting moves, so a partially filled bed still yields
# observations near the actual job. Rapid moves can span the entire table.
fn cncCutBounds {paths} {
    set xs {}
    set ys {}
    foreach path $paths {
        if {$path(rapid)} continue
        foreach point $path(points) {
            lassign $point x y
            lappend xs $x
            lappend ys $y
        }
    }
    if {![llength $xs]} {return {}}
    set xs [lsort -real $xs]
    set ys [lsort -real $ys]
    list [lindex $xs 0] [lindex $ys 0] [lindex $xs end] [lindex $ys end]
}

fn cncProbeLayout {geometry pk pw ph modelLib {bounds {}}} {
    package require linalg
    namespace import ::math::linearalgebra::*
    fn cncProject
    set ids {}
    foreach id [dict keys [$modelLib unitModel]] {
        if {[$modelLib isProjectedTag $id]} {lappend ids $id}
    }
    set side [expr {230.0*$pw/3840}]
    set margin [expr {159.0*$pw/3840}]
    dict with geometry {}
    lassign $bounds minX minY maxX maxY
    set border [lmap p $corners {cncProject $pk $pw $ph $p}]
    lassign $corners a b c d
    set tags {}
    # Place the center tag first so a small but usable bed can still be probed.
    foreach cell {{1 1} {0 0} {0 2} {2 0} {2 2} {0 1} {1 0} {1 2} {2 1}} {
        lassign $cell row col
        if {[llength $bounds]} {
            set u [lindex {.18 .5 .86} $row]
            set v [lindex {.14 .5 .86} $col]
            set p [add $origin [add [scale [expr {$minX+$u*($maxX-$minX)}] $xAxis] \
                [scale [expr {$minY+$v*($maxY-$minY)}] $yAxis]]]
        } else {
            set u [lindex {.16 .5 .84} $row]
            set v [lindex {.16 .5 .84} $col]
            set p [add [scale [expr {(1-$u)*(1-$v)}] $a] [scale [expr {$u*(1-$v)}] $b]]
            set p [add $p [add [scale [expr {$u*$v}] $c] [scale [expr {(1-$u)*$v}] $d]]]
        }
        lassign [cncProject $pk $pw $ph $p] x y
        set x0 [expr {$x-$margin}]
        set x1 [expr {$x+$margin}]
        set y0 [expr {$y-$margin}]
        set y1 [expr {$y+$margin}]
        if {$x0 < 0 || $y0 < 0 || $x1 >= $pw || $y1 >= $ph} continue
        set fits true
        foreach xx [list $x0 $x1 $x1 $x0] yy [list $y0 $y0 $y1 $y1] {
            set signs {}
            foreach a0 $border b0 [concat [lrange $border 1 end] [list [lindex $border 0]]] {
                lassign $a0 ax ay
                lassign $b0 bx by
                lappend signs [expr {($bx-$ax)*($yy-$ay)-($by-$ay)*($xx-$ax) >= 0}]
            }
            if {[llength [lsort -unique $signs]] > 1} {set fits false; break}
        }
        dict for {id tag} $tags {
            lassign $tag(center) tx ty
            if {abs($tx-$x) < 2*$margin && abs($ty-$y) < 2*$margin} {set fits false; break}
        }
        if {!$fits} continue
        set id [lindex $ids [dict size $tags]]
        if {$id eq ""} break
        dict set tags $id [dict create cell $cell center [list $x $y] side $side margin $margin]
    }
    return $tags
}

fn cncProbeRect {matrix x0 y0 x1 y1 color} {
    set a [list $x0 $y0]
    set b [list $x1 $y0]
    set c [list $x1 $y1]
    set d [list $x0 $y1]
    list [list $matrix $a $b $d $color] [list $matrix $b $c $d $color]
}

fn cncProbeDraw {tags matrix printLib imageLib} {
    fn cncProbeRect
    set backgrounds {}
    set cells {}
    dict for {id tag} $tags {
        lassign $tag(center) x y
        set margin $tag(margin)
        set half [expr {$tag(side)/2}]
        set x0 [expr {$x-$half}]
        set y0 [expr {$y-$half}]
        lappend backgrounds {*}[cncProbeRect $matrix [expr {$x-$margin}] [expr {$y-$margin}] \
            [expr {$x+$margin}] [expr {$y+$margin}] {1 1 1 1}]
        lappend backgrounds {*}[cncProbeRect $matrix $x0 $y0 [expr {$x+$half}] [expr {$y+$half}] {0 0 0 1}]
        set image [$printLib tagImageForId $id]
        try {
            set size [$imageLib Image_width $image]
            set stride [$imageLib Image_bytesPerRow $image]
            set step [expr {$tag(side)/$size}]
            for {set row 0} {$row < $size} {incr row} {
                for {set col 0} {$col < $size} {incr col} {
                    if {[$imageLib Image_data $image [expr {$row*$stride+$col}]] != 255} continue
                    set xx [expr {$x0+$col*$step}]
                    set yy [expr {$y0+$row*$step}]
                    lappend cells {*}[cncProbeRect $matrix $xx $yy [expr {$xx+$step}] [expr {$yy+$step}] {1 1 1 1}]
                }
            }
        } finally {
            $imageLib imageFree $image
        }
    }
    list $backgrounds $cells
}

# Select the latest whole-frame detection so incremental reports cannot
# double-count a frame. JPEG and detector coordinates share the live size.
fn cncProbeDetections {camera since} {
    set timestamp $since
    set tags {}
    foreach frame [Query! /detector/ detects tags /tags/ on camera $camera at timestamp /ts/ in time /elapsed/] {
        if {[lindex $frame(detector) end] ne "entire-frame" || $frame(ts) <= $timestamp} continue
        set timestamp $frame(ts)
        set tags {}
        foreach tag $frame(tags) {dict set tags $tag(id) $tag}
    }
    list $timestamp $tags
}

fn cncProbePoint {left right expected cameras pk pw ph geometry} {
    package require linalg
    namespace import ::math::linearalgebra::*
    fn cncRay
    fn cncProject
    set matrix {}
    foreach camera $cameras pixel [list $left $right] {
        lassign $camera k e w h
        set rotation [transpose $e(R)]
        set P [lmap row $rotation t [scale -1 [matmul $rotation $e(t)]] {concat $row [list $t]}]
        foreach coordinate [cncRay $k $w $h $pixel] row [lrange $P 0 1] {
            lappend matrix [sub [scale $coordinate [lindex $P 2]] $row]
        }
    }
    lassign [determineSVD $matrix] U S V
    set v [getcol $V [lsearch -exact $S [lindex [lsort -real $S] 0]]]
    set w [lindex $v 3]
    if {abs($w) < 1e-10} {error "Tag rays did not meet."}
    set point [scale [expr {1.0/$w}] [lrange $v 0 2]]
    foreach camera $cameras pixel [list $left $right] {
        lassign $camera k e w h
        set uv [cncProject $k $w $h [matmul [transpose $e(R)] [sub $point $e(t)]]]
        if {!([norm [sub $uv $pixel]] <= 6)} {error "Tag did not line up between the cameras."}
    }
    if {!([norm [sub [cncProject $pk $pw $ph $point] $expected]] <= $pw*30.0/3840)} {
        error "Tag did not line up with the projector."
    }
    dict with geometry {}
    set delta [sub $point $origin]
    list [dotproduct $delta $xAxis] [dotproduct $delta $yAxis] [dotproduct $delta $normal]
}

# Collect the same ID in two fresh stereo pairs. The center and four inner
# corners give one tag a measured footprint even when its neighbors are hidden.
fn cncProbeSample {tags left right cameras pk pw ph geometry timeout} {
    fn cncProbeDetections
    fn cncProbePoint
    set started [clock milliseconds]
    set since [expr {$started/1000.0 + .15}]
    set deadline [expr {$started+$timeout}]
    set settle [expr {$started+2200}]
    set lastLeft $since
    set lastRight $since
    set previous {}
    set confirmed {}
    while {[clock milliseconds] < $deadline} {
        lassign [cncProbeDetections $left $since] lt ltags
        lassign [cncProbeDetections $right $since] rt rtags
        if {$lt > $lastLeft && $rt > $lastRight} {
            set lastLeft $lt
            set lastRight $rt
            dict for {id tag} $tags {
                if {![dict exists $ltags $id] || ![dict exists $rtags $id]} continue
                set l [dict get $ltags $id]
                set r [dict get $rtags $id]
                if {[llength $l(p)] != 4 || [llength $r(p)] != 4} continue
                lassign $tag(center) x y
                set offset [expr {.3*$tag(side)}]
                set samples {}
                foreach a [concat [list $l(c)] $l(p)] b [concat [list $r(c)] $r(p)] \
                        dx {0 -1 1 1 -1} dy {0 1 1 -1 -1} {
                    set uv [list [expr {$x+$dx*$offset}] [expr {$y+$dy*$offset}]]
                    if {[catch {cncProbePoint $a $b $uv $cameras $pk $pw $ph $geometry} point]} break
                    lappend samples $point
                }
                if {[llength $samples] != 5} continue
                if {[dict exists $previous $id]} {
                    set mean {}
                    foreach a [dict get $previous $id] b $samples {
                        lappend mean [lmap av $a bv $b {expr {($av+$bv)*.5}}]
                    }
                    dict set confirmed $tag(cell) $mean
                }
                dict set previous $id $samples
            }
            if {[dict size $confirmed] == [dict size $tags]} break
        }
        if {[dict size $confirmed] && [clock milliseconds] >= $settle} break
        sleep .04
    }
    return $confirmed
}

# Clip the fitted patch to the selected bed in local XY.
fn cncClipPatch {polygon bed} {
    set winding 0
    set next [concat [lrange $bed 1 end] [list [lindex $bed 0]]]
    foreach a $bed b $next {
        lassign $a ax ay
        lassign $b bx by
        set winding [expr {$winding+$ax*$by-$ay*$bx}]
    }
    set sign [expr {$winding >= 0 ? 1 : -1}]
    foreach a $bed b $next {
        if {![llength $polygon]} break
        lassign $a ax ay
        lassign $b bx by
        set dx [expr {$sign*($bx-$ax)}]
        set dy [expr {$sign*($by-$ay)}]
        set clipped {}
        foreach p $polygon q [concat [lrange $polygon 1 end] [list [lindex $polygon 0]]] {
            lassign $p px py
            lassign $q qx qy
            set from [expr {$dx*($py-$ay)-$dy*($px-$ax)}]
            set to [expr {$dx*($qy-$ay)-$dy*($qx-$ax)}]
            if {$from >= 0} {lappend clipped $p}
            if {($from >= 0) != ($to >= 0)} {
                set t [expr {$from/($from-$to)}]
                lappend clipped [list [expr {$px+$t*($qx-$px)}] [expr {$py+$t*($qy-$py)}]]
            }
        }
        set polygon $clipped
    }
    return $polygon
}

# Use a common plane only when several tags across both axes agree. Extend the
# supported rectangle by at most half a grid interval, capped at 24 cm,
# so cuts just beyond the outer probe row can still use the measured plane.
fn cncProbePlanePatch {samples geometry} {
    if {[dict size $samples] < 4 || $geometry eq ""} {return {}}
    package require linalg
    namespace import ::math::linearalgebra::*
    fn cncClipPatch
    set rows {}
    set cols {}
    set xs {}
    set ys {}
    set design {}
    set heights {}
    dict for {cell points} $samples {
        lassign $cell row col
        lappend rows $row
        lappend cols $col
        lassign [lindex $points 0] x y z
        lappend xs $x
        lappend ys $y
        lappend design [list $x $y 1.0]
        lappend heights $z
    }
    set rowCount [llength [lsort -unique $rows]]
    set colCount [llength [lsort -unique $cols]]
    if {$rowCount < 2 || $colCount < 2} {return {}}
    set Dt [transpose $design]
    set gram [matmul $Dt $design]
    if {abs([det $gram]) < .002} {return {}}
    lassign [solvePGauss $gram [matmul $Dt $heights]] a b c
    if {$a*$a+$b*$b > .02} {return {}}
    set sum 0.0
    foreach x $xs y $ys z $heights {
        set error [expr {$a*$x+$b*$y+$c-$z}]
        if {abs($error) > .022} {return {}}
        set sum [expr {$sum+$error*$error}]
    }
    if {sqrt($sum/[llength $heights]) > .012} {return {}}
    set xs [lsort -real $xs]
    set ys [lsort -real $ys]
    set x0 [lindex $xs 0]; set x1 [lindex $xs end]
    set y0 [lindex $ys 0]; set y1 [lindex $ys end]
    set padx [expr {($x1-$x0)/2/($rowCount-1)}]
    set pady [expr {($y1-$y0)/2/($colCount-1)}]
    if {$padx > .24} {set padx .24}
    if {$pady > .24} {set pady .24}
    set x0 [expr {$x0-$padx}]; set x1 [expr {$x1+$padx}]
    set y0 [expr {$y0-$pady}]; set y1 [expr {$y1+$pady}]
    dict with geometry {}
    set bed [lmap p $corners {
        set delta [sub $p $origin]
        list [dotproduct $delta $xAxis] [dotproduct $delta $yAxis]
    }]
    set polygon [cncClipPatch [list [list $x0 $y0] [list $x1 $y0] [list $x1 $y1] [list $x0 $y1]] $bed]
    lmap p $polygon {
        lassign $p x y
        list $x $y [expr {$a*$x+$b*$y+$c}]
    }
}

# Map triangles are interpolated in local XY. A single tag covers its inner
# quad. Three or four neighboring tag centers also cover their grid cell.
fn cncHeightMap {samples {patch {}}} {
    set triangles {}
    set first [lindex $patch 0]
    foreach a [lrange $patch 1 end-1] b [lrange $patch 2 end] {
        lappend triangles [list $first $a $b]
    }
    foreach row {0 1} {
        foreach col {0 1} {
            set quad {}
            foreach dr {0 1 1 0} dc {0 0 1 1} {
                set key [list [expr {$row+$dr}] [expr {$col+$dc}]]
                if {[dict exists $samples $key]} {lappend quad [lindex [dict get $samples $key] 0]}
            }
            if {[llength $quad] >= 3} {lappend triangles [lrange $quad 0 2]}
            if {[llength $quad] == 4} {lappend triangles [list [lindex $quad 0] {*}[lrange $quad 2 3]]}
        }
    }
    dict for {cell points} $samples {
        lassign $points center a b c d
        foreach p [list $a $b $c $d] q [list $b $c $d $a] {
            lappend triangles [list $center $p $q]
        }
    }
    set map {}
    foreach triangle $triangles {
        lassign $triangle a b c
        lassign $a ax ay az
        lassign $b bx by bz
        lassign $c cx cy cz
        set ux [expr {$bx-$ax}]
        set uy [expr {$by-$ay}]
        set vx [expr {$cx-$ax}]
        set vy [expr {$cy-$ay}]
        set det [expr {$ux*$vy-$uy*$vx}]
        if {abs($det) < 1e-8} continue
        set u [list [expr {$vy/$det}] [expr {-$vx/$det}]]
        set v [list [expr {-$uy/$det}] [expr {$ux/$det}]]
        lappend map [list $a $u $v [expr {$bz-$az}] [expr {$cz-$az}]]
    }
    return $map
}

# Clip a move against every measured triangle. Each interval is drawn using
# its own surface so moves crossing a map boundary do not connect two heights.
fn cncHeightIntervals {a b map} {
    lassign $a x0 y0
    lassign $b x1 y1
    set dx [expr {$x1-$x0}]
    set dy [expr {$y1-$y0}]
    set sections {}
    set boundaries {0.0 1.0}
    foreach triangle $map {
        lassign $triangle anchor u v dzU dzV
        lassign $anchor ax ay az
        lassign $u ux uy
        lassign $v vx vy
        set u0 [expr {$ux*($x0-$ax)+$uy*($y0-$ay)}]
        set v0 [expr {$vx*($x0-$ax)+$vy*($y0-$ay)}]
        set du [expr {$ux*$dx+$uy*$dy}]
        set dv [expr {$vx*$dx+$vy*$dy}]
        set lo 0.0
        set hi 1.0
        foreach base [list $u0 $v0 [expr {1-$u0-$v0}]] slope [list $du $dv [expr {-$du-$dv}]] {
            if {abs($slope) < 1e-10} {
                if {$base < -1e-10} {set hi -1; break}
            } else {
                set t [expr {-$base/$slope}]
                if {$slope > 0 && $t > $lo} {set lo $t}
                if {$slope < 0 && $t < $hi} {set hi $t}
            }
        }
        if {$hi-$lo < 1e-9} continue
        lappend sections [list $lo $hi [expr {$az+$u0*$dzU+$v0*$dzV}] [expr {$du*$dzU+$dv*$dzV}]]
        lappend boundaries $lo $hi
    }
    set intervals {}
    set boundaries [lsort -real -unique $boundaries]
    foreach lo [lrange $boundaries 0 end-1] hi [lrange $boundaries 1 end] {
        if {$hi-$lo < 1e-9} continue
        set mid [expr {($lo+$hi)*.5}]
        set z 0.0
        set dz 0.0
        foreach section $sections {
            lassign $section start end height slope
            if {$start <= $mid && $mid <= $end} {
                set z $height
                set dz $slope
                break
            }
        }
        lappend intervals [lmap t [list $lo $hi] {
            list [expr {$x0+$dx*$t}] [expr {$y0+$dy*$t}] [expr {$z+$dz*$t}]
        }]
    }
    return $intervals
}

fn cncProjectPath {points map geometry pk pw ph} {
    package require linalg
    namespace import ::math::linearalgebra::*
    fn cncHeightIntervals
    fn cncProject
    dict with geometry {}
    set lines {}
    set line {}
    set last {}
    foreach a [lrange $points 0 end-1] b [lrange $points 1 end] {
        foreach interval [cncHeightIntervals $a $b $map] {
            lassign $interval start end
            if {$last eq "" || [norm [sub $start $last]] > .00001} {
                if {[llength $line] > 1} {lappend lines $line}
                set line {}
                lassign $start x y z
                set p [add $origin [add [scale $x $xAxis] [add [scale $y $yAxis] [scale $z $normal]]]]
                lappend line [cncProject $pk $pw $ph $p]
            }
            lassign $end x y z
            set p [add $origin [add [scale $x $xAxis] [add [scale $y $yAxis] [scale $z $normal]]]]
            lappend line [cncProject $pk $pw $ph $p]
            set last $end
        }
    }
    if {[llength $line] > 1} {lappend lines $line}
    return $lines
}

fn cncCameraPair {cameras} {
    lrange [lsort -unique [lmap item $cameras {dict get $item camera}]] 0 1
}

When the collected results for {camera /camera/ has width /w/ height /h/} are /cameras/ {
    fn cncCameraPair
    lassign [cncCameraPair $cameras] left right
    if {$right eq ""} return
    When cnc claims camera $left has CNC setup points /lp/ with width /lw/ height /lh/ &\
         cnc claims camera $right has CNC setup points /rp/ with width /rw/ height /rh/ &\
         camera $left has intrinsics /lk/ & camera $right has intrinsics /rk/ &\
         camera $left to display /display/ has extrinsics /le/ &\
         camera $right to display /display/ has extrinsics /re/ &\
         display /display/ has intrinsics /pk/ & display /display/ has width /pw/ height /ph/ {
        fn cncStereoGeometry
        try {
            set geometry [cncStereoGeometry [dict create points $lp width $lw height $lh] \
                [dict create points $rp width $rw height $rh] $lk $le $rk $re]
        } on error e {
            Claim CNC setup status is $e
            return
        }
        Claim CNC setup status is "Point 5 is set. The preview uses local coordinates."
        # Probe once per job. Position updates only refresh the preview.
        When the CNC gcode is /gcode/ {
            fn cncProbeLayout
            fn cncCutBounds
            fn cncGcodePaths
            fn cncProbeDraw
            fn cncProbeSample
            fn cncHeightMap
            fn cncProbePlanePatch
            set probe [list $this probe $display [clock microseconds]]
            set samples {}
            set probeStatus {}
            On unmatch {
                foreach key {progress backdrop cells left right} {Hold! -on $probe -key $key {}}
            }
            try {
                if {[llength [Query! /any/ wishes to draw calibration model /model/ using \
                        model-to-display homography /matrix/ with message /message/ on display $display]]} {
                    error "Calibration is already using the projector."
                }
                set modelLib [QueryOne! the calibration model library is /./]
                set imageLib [QueryOne! the image library is /./]
                set printLib [QueryOne! the print library is /./]
                set canvas [QueryOne! $display has canvas /./ with /...options/]
                set matrix [QueryOne! $display has canvas projection /./]
                set bounds {}
                if {![catch {QueryOne! the CNC local position is /./} position] &&
                    ![catch {cncGcodePaths $gcode $position} paths]} {
                    set bounds [cncCutBounds $paths]
                }
                set tags [cncProbeLayout $geometry $pk $pw $ph $modelLib $bounds]
                if {![dict size $tags] && [llength $bounds]} {
                    set tags [cncProbeLayout $geometry $pk $pw $ph $modelLib]
                }
                if {![dict size $tags]} {error "No full-size probe tag fits inside the selected bed."}
                set cameras {}
                foreach camera [list $left $right] k [list $lk $rk] e [list $le $re] key {left right} {
                    set size [lindex [Query! camera $camera has width /w/ height /h/] 0]
                    lappend cameras [list $k $e $size(w) $size(h)]
                    if {![llength [Query! /owner/ wishes camera $camera detects tags]]} {
                        Hold! -on $probe -key $key Wish camera $camera detects tags
                    }
                }
                lassign [cncProbeDraw $tags $matrix $printLib $imageLib] backdrop cells
                Hold! -on $probe -key progress Claim CNC preview status is "Probing the bed with AprilTags…"
                # Batch the white surrounds, dark tag backgrounds, and light tag
                # cells in drawing order. The pattern uses calibration polarity.
                Hold! -on $probe -key backdrop Wish the GPU draws pipeline fillTriangle onto canvas $canvas \
                    with instances $backdrop layer 154
                Hold! -on $probe -key cells Wish the GPU draws pipeline fillTriangle onto canvas $canvas \
                    with instances $cells layer 155
                set samples [cncProbeSample $tags $left $right $cameras $pk $pw $ph $geometry 6000]
                if {[dict size $samples]} {
                    set probeStatus "Height map from [dict size $samples] of [dict size $tags] stereo tags. Unmeasured areas use the bed plane."
                } else {
                    set probeStatus "No tags confirmed in two stereo frames. Using the bed plane."
                }
            } on error e {
                set probeStatus "Height probe unavailable. Using the bed plane. $e"
            } finally {
                foreach key {progress backdrop cells left right} {Hold! -on $probe -key $key {}}
            }
            set patch [cncProbePlanePatch $samples $geometry]
            set map [cncHeightMap $samples $patch]
            if {[llength $patch] >= 3} {
                set probeStatus "Local surface fitted from [dict size $samples] of [dict size $tags] stereo tags. Unmeasured areas use the bed plane."
            }
            When the CNC local position is /position/ {
                fn cncGcodePaths
                fn cncProjectPath
                try {
                    set projectedPaths {}
                    foreach path [cncGcodePaths $gcode $position] {
                        foreach line [cncProjectPath $path(points) $map $geometry $pk $pw $ph] {
                            lappend projectedPaths [list $path(rapid) $line]
                        }
                    }
                } on error e {
                    Claim CNC preview status is $e
                    return
                }
                foreach path $projectedPaths {
                    lassign $path rapid pixels
                    set color [expr {$rapid ? {0 .5 1 .6} : {1 1 0 1}}]
                    Wish to draw a line onto $display with points $pixels width 3 color $color layer 115
                }
                if {[llength $projectedPaths]} {
                    Claim CNC preview status is $probeStatus
                } else {
                    Claim CNC preview status is "The G-code has no XY moves to preview."
                }
            }
        }
    }
}

Wish the web server handles route {/cnc} with handler {
    fn cncCameraPair
    set cameras [cncCameraPair [Query! camera /camera/ has width /w/ height /h/]]
    set panels {}
    foreach camera $cameras {
        set saved null
        set selections [Query! cnc claims camera $camera has CNC setup points /points/ with width /width/ height /height/]
        if {![llength $selections]} {
            set selections [Query! cnc claims camera $camera has CNC bed corners /points/ with width /width/ height /height/]
        }
        if {[llength $selections]} {
            set saved [json::encode [dict remove [lindex $selections 0] __ref] {obj points {list list num} width num height num}]
        }
        lappend panels [subst {
            <section data-camera="[htmlEscape $camera]" data-saved="[htmlEscape $saved]">
                <h2>[htmlEscape $camera]</h2>
                <div class="image"><canvas></canvas><svg aria-hidden="true" preserveAspectRatio="none"></svg></div>
                <p class="status" role="status">Waiting for camera…</p>
                <button class="undo" disabled>Undo point</button>
                <button class="clear" disabled>Clear points</button>
            </section>
        }]
    }
    set waiting [expr {[llength $cameras] == 2 ?
        "Select five points in each calibrated camera view." :
        "Two cameras are required. Reload after both are connected."}]
    set script {
        const ws = new FolkWS(document.getElementById('connectionStatus'));
        const setup = document.getElementById('setup');
        const preview = document.getElementById('preview');
        ws.watchCollected('/any/ claims CNC setup status is /status/', matches => {
            setup.textContent = matches[0]?.status ?? setup.dataset.waiting;
        });
        ws.watchCollected('/any/ claims CNC preview status is /status/', matches => {
            preview.textContent = matches[0]?.status ?? 'The preview needs completed setup, G-code, and a local position.';
        });

        document.querySelectorAll('.cameras section').forEach(panel => {
            const {camera, saved} = panel.dataset;
            const canvas = panel.querySelector('canvas');
            const context = canvas.getContext('2d');
            const svg = panel.querySelector('svg');
            const status = panel.querySelector('.status');
            const undo = panel.querySelector('.undo');
            const clear = panel.querySelector('.clear');
            const selection = JSON.parse(saved);
            let {points, width, height} = selection ?? {points: [], width: 0, height: 0};
            let ready = false, frozen = false, busy = false, request;

            function draw() {
                const w = width || canvas.width;
                const h = height || canvas.height;
                const scale = w / Math.max(1, canvas.getBoundingClientRect().width);
                svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
                const corners = points.slice(0, 4);
                const outline = corners.length === 4 ? [...corners, corners[0]] : corners;
                svg.innerHTML = `
                    <polyline points="${outline.map(p => p.join(',')).join(' ')}"
                        fill="none" stroke="#5af49b" stroke-width="2" vector-effect="non-scaling-stroke"/>
                ` + points.map(([x, y], i) => `
                    <circle cx="${x}" cy="${y}" r="${5 * scale}" fill="${i === 4 ? '#70caff' : '#ffd84d'}"
                        stroke="#14191f" stroke-width="${scale}"/>
                    <text x="${x + 8 * scale}" y="${y - 8 * scale}" font-size="${15 * scale}"
                        fill="white" stroke="#14191f" stroke-width="${3 * scale}" paint-order="stroke">${i + 1}</text>
                `).join('');
                undo.disabled = clear.disabled = busy || points.length === 0;
                status.textContent = busy ? 'Updating…' : points.length === 5 ? 'Five points selected.' :
                    points.length === 4 ? 'Click point 5, the local XY zero.' :
                    ready ? `Click corner ${points.length + 1}.` : 'Waiting for camera…';
            }

            async function frame() {
                if (frozen || request || document.hidden) return;
                request = new AbortController();
                try {
                    const response = await fetch('/camera-frame?' + new URLSearchParams({camera}), {
                        cache: 'no-store', signal: request.signal,
                    });
                    if (!response.ok) throw Error(`Camera unavailable (${response.status}).`);
                    const image = await createImageBitmap(await response.blob());
                    try {
                        if (frozen || request.signal.aborted) return;
                        if (canvas.width !== image.width) canvas.width = image.width;
                        if (canvas.height !== image.height) canvas.height = image.height;
                        context.drawImage(image, 0, 0);
                        ready = true;
                        draw();
                    } finally {
                        image.close();
                    }
                } catch (e) {
                    if (e.name !== 'AbortError') status.textContent = e.message;
                } finally {
                    request = null;
                }
            }

            canvas.onclick = async event => {
                if (!ready || busy || points.length === 5) return;
                frozen = true;
                if (!points.length) {
                    width = canvas.width;
                    height = canvas.height;
                }
                const rect = canvas.getBoundingClientRect();
                points.push([
                    Math.max(0, Math.min(width - 1, (event.clientX - rect.left) * width / rect.width)),
                    Math.max(0, Math.min(height - 1, (event.clientY - rect.top) * height / rect.height)),
                ]);
                if (points.length < 5) {
                    draw();
                    return;
                }
                busy = true;
                draw();
                let error;
                try {
                    await ws.run(tcl`Hold! -save -on cnc -key ${camera} -- cnc claims camera ${camera} has CNC setup points ${points} with width ${width} height ${height}`);
                    frozen = false;
                } catch (e) {
                    points.pop();
                    error = e;
                } finally {
                    busy = false;
                    draw();
                    if (error) status.textContent = error.message;
                }
            };

            async function remove(all) {
                if (busy || !points.length) return;
                busy = true;
                draw();
                let error;
                try {
                    if (points.length >= 4) await ws.hold(camera, '', 'cnc', true);
                    points = all ? [] : points.slice(0, -1);
                    if (!points.length) width = height = 0;
                    frozen = points.length > 0;
                } catch (e) {
                    error = e;
                } finally {
                    busy = false;
                    draw();
                    if (error) status.textContent = error.message;
                }
            }
            undo.onclick = () => remove(false);
            clear.onclick = () => remove(true);
            window.addEventListener('resize', draw);
            window.addEventListener('pagehide', () => request?.abort());
            setInterval(frame, 150);
            frame();
        });
    }
    html [subst {
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CNC bed setup</title>
    <style>
        body { font: 16px system-ui, sans-serif; margin: 20px; }
        .cameras { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
        h2 { font-size: 1rem; overflow-wrap: anywhere; }
        .image { position: relative; background: #14191f; }
        canvas { display: block; width: 100%; cursor: crosshair; }
        svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
        button { font: inherit; margin-inline-end: 6px; }
        @media (max-width: 700px) { .cameras { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <h1>CNC bed setup</h1>
    <p>Click the same physical points in both camera views. Follow the CNC axes regardless of how either image is rotated.</p>
    <ol>
        <li>Bed reference corner.</li>
        <li>Adjacent corner in the +X direction.</li>
        <li>Opposite corner (+X, +Y).</li>
        <li>Adjacent corner in the +Y direction.</li>
        <li>Local XY zero (X=0, Y=0) for aligning the toolpath preview.</li>
    </ol>
    <p>Each view freezes while you select points. The fifth click saves that view and resumes live video.</p>
    <p>Each new G-code job briefly projects AprilTags to measure surface heights for the preview.</p>
    <div id="connectionStatus">Connecting…</div>
    <p id="setup" role="status" data-waiting="[htmlEscape $waiting]">[htmlEscape $waiting]</p>
    <p id="preview" role="status"></p>
    <div class="cameras">[join $panels \n]</div>
    <script src="/lib/folk.js"></script>
    <script>$script</script>
</body>
</html>
    }]
}
