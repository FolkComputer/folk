When the image library is /imageLib/ {
    set cc [dict link $C {}]
    cc::extend $imageLib
    cc::addcflags -I./vendor/gifdec
    cc::addendcflags ./vendor/gifdec/gifdec.c -fPIC
    cc::include "gifdec.h"
    cc::include <stdlib.h>

    cc::proc loadGif {char* filename} Zicl_Value {
        gd_GIF *gif = gd_open_gif(filename);
        if (!gif) {
            FOLK_ERROR("loadGif: Failed to open %s", filename);
        }

        Zicl_List* framesList = ziclNewList(NULL, 0);
        Zicl_List* delaysList = ziclNewList(NULL, 0);

        while (gd_get_frame(gif)) {
            Image im;
            im.width = gif->width;
            im.height = gif->height;
            im.components = 3;
            im.bytesPerRow = im.width * 3;
            im.data = malloc(im.bytesPerRow * im.height);
            im.uniq = 0;

            gd_render_frame(gif, im.data);

            // Box the Image struct into a Zicl value.
            Zicl_Value imObj;
            $[cc::ret Image imObj im]
            ziclListAppend(framesList, imObj);
            Zicl_Release(imObj);

            // gifdec delay is in 1/100s of a second. Convert to milliseconds.
            ziclListAppend(delaysList, Zicl_NewLong(gif->gce.delay * 10));
        }

        uint16_t w = gif->width;
        uint16_t h = gif->height;
        gd_close_gif(gif);

        Zicl_Dict* result = ziclNewDict(NULL, 0);
        Zicl_Value framesKey = ziclNewString("frames", -1);
        Zicl_Value delaysKey = ziclNewString("delays", -1);
        Zicl_Value widthKey = ziclNewString("width", -1);
        Zicl_Value heightKey = ziclNewString("height", -1);
        Zicl_Value framesVal = Zicl_BoxList(framesList);
        Zicl_Value delaysVal = Zicl_BoxList(delaysList);
        ziclDictPut(result, framesKey, framesVal);
        ziclDictPut(result, delaysKey, delaysVal);
        ziclDictPut(result, widthKey, Zicl_NewLong(w));
        ziclDictPut(result, heightKey, Zicl_NewLong(h));
        Zicl_Release(framesKey);
        Zicl_Release(delaysKey);
        Zicl_Release(widthKey);
        Zicl_Release(heightKey);
        Zicl_Release(framesVal);
        Zicl_Release(delaysVal);
        return Zicl_BoxDict(result);
    }

    set gifLib [cc::compile]
    Claim the gif library is $gifLib
}
