When libapriltag has been built with C prototype /Apriltag/ {

# We try to use the AprilTag matrix library (instead of tcllib linalg)
# to do matrix/homography operations in the live calibration inner
# loop, to help with performance:
set cc [dict link $Apriltag {}]
cc::include <math.h>
cc::include <common/matd.h>
cc::include <common/homography.h>

# A native object type for `matd_t*`. The object's inline body holds the
# `matd_t*` itself (the matrix is variable-size, so it stays behind the
# pointer rather than living in the body), and the type shimmers both ways:
# a Tcl list-of-lists converts into a matrix, and a matrix renders back out
# as `{a b c} {d e f}`.
cc::objtype matd {
    Zicl_ObjectVTable* matd_ObjectVTable;

    static matd_t* matd_fromObject(const Zicl_Object* obj) {
        return *(matd_t**) Zicl_ObjectBodyConst(obj);
    }

    void matd_freeIntRepProc(Zicl_Object* objPtr) {
        matd_destroy(*(matd_t**) Zicl_ObjectBody(objPtr));
    }
    Zicl_Object* matd_dupIntRepProc(const Zicl_Object* srcPtr) {
        void* body = NULL;
        Zicl_Object* newObject = Zicl_NewObject(matd_ObjectVTable, sizeof(matd_t*), &body);
        if (newObject == NULL) return NULL;
        *(matd_t**) body = matd_copy(matd_fromObject(srcPtr));
        return newObject;
    }
    int matd_updateStringProc(Zicl_Object* objPtr) {
        matd_t* mat = matd_fromObject(objPtr);

        // Worst case per element: "-1.234567e-308 " and similar, so 26 bytes
        // is ample; plus the braces and separator around each row.
        size_t cap = (size_t)mat->nrows * (mat->ncols * 26 + 3) + 1;
        char* s = malloc(cap);
        if (s == NULL) return ZICL_OOM;
        defer { free(s); }

        size_t i = 0;
        for (unsigned int row = 0; row < mat->nrows; row++) {
            if (row > 0) s[i++] = ' ';
            s[i++] = '{';
            for (unsigned int col = 0; col < mat->ncols; col++) {
                if (col > 0) s[i++] = ' ';
                i += snprintf(&s[i], cap - i, "%f", MATD_EL(mat, row, col));
            }
            s[i++] = '}';
        }
        s[i] = 0;

        return Zicl_SetObjectString(objPtr, s, (int)i);
    }

    /* Shimmers `shim` to a matd, parsing a list-of-lists if it isn't one
       already. The returned matrix stays owned by the shimmered value.

       `rc` is what the matrix's cleanup guard keys off, so every fallible
       call below goes through ZICL_TRY and every bail-out returns through
       `return (rc = ...)`. A bare `return ZICL_ERR` would leave `rc` at
       ZICL_OK and leak the matrix, so the assignment is kept inside the
       return rather than as a separate step that can drift apart from it. */
    int matd_shimmerFrom(Zicl_Interp* interp, Zicl_Shimmerable* shim, matd_t** out) {
        void* body = Zicl_AsObject(Zicl_Current(shim), matd_ObjectVTable);
        if (body) { *out = *(matd_t**) body; return ZICL_OK; }

        int rc = ZICL_OK;

        const Zicl_List* rows;
        ZICL_TRY(Zicl_ListShimmer(interp, shim, &rows), rc);
        int nrows = Zicl_ListLength(rows);
        if (nrows <= 0) return (rc = ZICL_ERR);
        const Zicl_Value* rowValues = Zicl_ListItems(rows);

        // Column count comes from the first row; the rest must agree.
        int ncols;
        {
            Zicl_Shimmerable row0 = Zicl_NewShimmerable(rowValues[0]);
            defer { Zicl_ShimDiscardChanges(&row0); }
            const Zicl_List* row0List;
            ZICL_TRY(Zicl_ListShimmer(interp, &row0, &row0List), rc);
            ncols = Zicl_ListLength(row0List);
        }
        if (ncols <= 0) return (rc = ZICL_ERR);

        matd_t* mat = matd_create(nrows, ncols);
        if (mat == NULL) return (rc = ZICL_OOM);
        // Ownership transfers to the shimmered value on success, so this only
        // fires on the failing paths.
        defer { if (rc != ZICL_OK) matd_destroy(mat); }

        for (int row = 0; row < nrows; row++) {
            Zicl_Shimmerable rowShim = Zicl_NewShimmerable(rowValues[row]);
            defer { Zicl_ShimDiscardChanges(&rowShim); }

            const Zicl_List* rowList;
            ZICL_TRY(Zicl_ListShimmer(interp, &rowShim, &rowList), rc);
            if (Zicl_ListLength(rowList) != ncols) return (rc = ZICL_ERR);

            const Zicl_Value* cells = Zicl_ListItems(rowList);
            for (int col = 0; col < ncols; col++) {
                Zicl_Shimmerable cell = Zicl_NewShimmerable(cells[col]);
                defer { Zicl_ShimDiscardChanges(&cell); }
                ZICL_TRY(Zicl_GetDouble(interp, &cell, &MATD_EL(mat, row, col)), rc);
            }
        }

        // Converts `shim` in place, so the list rep is replaced by ours.
        void* newBody = Zicl_PrepareToShimmer(shim, matd_ObjectVTable);
        if (newBody == NULL) return (rc = ZICL_OOM);
        *(matd_t**) newBody = mat;
        *out = mat;
        return ZICL_OK;
    }

    void matd_init(void) {
        matd_ObjectVTable = malloc(sizeof(Zicl_ObjectVTable));
        *matd_ObjectVTable = (Zicl_ObjectVTable) {
            .is_c_vtable = true,
            .name = "matd_t*",
            .duplicate = matd_dupIntRepProc,
            .free_internal_rep = matd_freeIntRepProc,
            .update_string = matd_updateStringProc,
            // Nothing in the body another thread could race on: the matrix is
            // immutable once built, and holds no Zicl_Values.
            .make_crossthread = Zicl_NoopMakeCrossthread,
            .enumerate_struct = NULL
        };
    }
}
cc::argtype matd_t* {
    matd_t* $argname;
    __ENSURE_OK(matd_shimmerFrom(interp, $shim, &$argname));
}
cc::rtype matd_t* {
    {
        void* body = NULL;
        Zicl_Object* obj = Zicl_NewObject(matd_ObjectVTable, sizeof(matd_t*), &body);
        if (obj == NULL) folkZiclAssert(ZICL_OOM);
        *(matd_t**) body = $rvalue;
        $robj = Zicl_BoxObject(obj);
    }
}

cc::proc computeNormalizer {int nPoints float points[][2]} matd_t* {
    double cx = 0, cy = 0;
    for (int i = 0; i < nPoints; i++) {
        cx += points[i][0]; cy += points[i][1];
    }
    cx /= nPoints; cy /= nPoints;

    double avgDist = 0;
    for (int i = 0; i < nPoints; i++) {
        double dx = points[i][0] - cx;
        double dy = points[i][1] - cy;
        avgDist += sqrt(dx*dx + dy*dy);
    }
    avgDist /= nPoints;

    double scale = sqrt(2.0) / avgDist;

    matd_t *normalizer = matd_create(3, 3);
    MATD_EL(normalizer, 0, 0) = scale;
    MATD_EL(normalizer, 1, 1) = scale;
    MATD_EL(normalizer, 2, 2) = 1.0;
    MATD_EL(normalizer, 0, 2) = -scale * cx;
    MATD_EL(normalizer, 1, 2) = -scale * cy;

    return normalizer;
}

cc::addcode {
    static void homographyProject(const matd_t *H, double x, double y, double *ox, double *oy)
    {
        double xx = MATD_EL(H, 0, 0)*x + MATD_EL(H, 0, 1)*y + MATD_EL(H, 0, 2);
        double yy = MATD_EL(H, 1, 0)*x + MATD_EL(H, 1, 1)*y + MATD_EL(H, 1, 2);
        double zz = MATD_EL(H, 2, 0)*x + MATD_EL(H, 2, 1)*y + MATD_EL(H, 2, 2);

        *ox = xx / zz;
        *oy = yy / zz;
    }
}

# Takes a list of at least 4 point pairs (model -> image) like
#
# [list \
#   [list x0 y0 u0 v0]] \
#   [list x1 y1 u1 v1] \
#   [list x2 y2 u2 v2] \
#   [list x3 y3 u3 v3]]
#
# Returns a 3x3 homography that maps model (x, y) to image (u, v)
# (using homogeneous coordinates).
cc::addcode {
    static matd_t *estimateHomographyBaseImpl(int nPointPairs, float pointPairs[][4]);
    static void refineHomography(int nPointPairs, float pointPairs[][4],
                                 matd_t *H);
}
cc::proc estimateHomography {float[nPointPairs][4] pointPairs} matd_t* {
    matd_t *H = estimateHomographyBaseImpl(nPointPairs, pointPairs);
    refineHomography(nPointPairs, pointPairs, H);
    return H;
}

cc::proc estimateHomographyBaseImpl {float[nPointPairs][4] pointPairs} matd_t* {
    float xys[nPointPairs][2];
    float uvs[nPointPairs][2];
    for (int i = 0; i < nPointPairs; i++) {
        xys[i][0] = pointPairs[i][0]; xys[i][1] = pointPairs[i][1];
        uvs[i][0] = pointPairs[i][2]; uvs[i][1] = pointPairs[i][3];
    }

    // Compute a similarity transformation T that normalizes model
    // points.
    matd_t *T = computeNormalizer(nPointPairs, xys);

    // Compute a similarity transformation T' that normalizes image
    // points.
    matd_t *T_ = computeNormalizer(nPointPairs, uvs);

    // Apply DLT to obtain a homography H.

    matd_t *A = matd_create(2*nPointPairs, 9);
    for (int i = 0; i < nPointPairs; i++) {
        double x, y;
        homographyProject(T, xys[i][0], xys[i][1], &x, &y);
        double u, v;
        homographyProject(T_, uvs[i][0], uvs[i][1], &u, &v);

        double row0[9] = {x, y, 1, 0, 0, 0, -u*x, -u*y, -u};
        double row1[9] = {0, 0, 0, x, y, 1, -v*x, -v*y, -v};

        for (int j = 0; j < 9; j++) {
            MATD_EL(A, 2*i, j) = row0[j];
            MATD_EL(A, 2*i+1, j) = row1[j];
        }
    }

    matd_svd_t svd = matd_svd_flags(A, MATD_SVD_NO_WARNINGS);
    matd_destroy(A);

    // H' = V[-1].reshape(3, 3)
    // H' /= H'[2, 2]
    matd_t *H_ = matd_create(3, 3);
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            MATD_EL(H_, i, j) = MATD_EL(svd.V, 3*i+j, svd.V->ncols-1);
        }
    }
    matd_destroy(svd.U);
    matd_destroy(svd.S);
    matd_destroy(svd.V);

    matd_scale_inplace(H_, 1.0 / MATD_EL(H_, 2, 2));

    // Set H = inv(T_) * H' * T.
    matd_t *H = matd_op("M^-1 * M * M", T_, H_, T);
    matd_destroy(T);
    matd_destroy(T_);
    matd_destroy(H_);
    return H;
}

# The refinement code is based on how OpenCV uses LMSolver in findHomography:
# https://github.com/opencv/opencv/blob/9cdd525bc59b34a3db8f6db905216c5398ca93d6/modules/calib3d/src/fundam.cpp
cc::addcflags -I./vendor/cmpfit
cc::include <float.h>
cc::include "mpfit.h"
cc::include "mpfit.c"
cc::proc refineHomography {int nPointPairs float[][4] pointPairs
                           matd_t* H} void {
    mp_result result = {0};
    mpfit(refineHomographyComputeError,
          // Number of error functions:
          nPointPairs * 2,
          // Number of parameters to optimize:
          9,
          H->data, NULL,
          NULL,
          pointPairs,
          &result);
}
cc::addcode {
    int refineHomographyComputeError(int m, int n, double *h,
                                     double *errptr, double **dvec, void *private_data) {
        float (*pointPairs)[4] = (float (*)[4])private_data;
        int nPointPairs = m / 2;
        for (int i = 0; i < nPointPairs; i++) {
            double Mx = pointPairs[i][0], My = pointPairs[i][1];
            double ww = h[6]*Mx + h[7]*My + h[8];
            ww = fabs(ww) > DBL_EPSILON ? 1./ww : 0;
            double xi = (h[0]*Mx + h[1]*My + h[2])*ww;
            double yi = (h[3]*Mx + h[4]*My + h[5])*ww;
            errptr[i*2] = xi - pointPairs[i][2];
            errptr[i*2+1] = yi - pointPairs[i][3];
        }
        return 0;
    }
}

cc::proc applyHomography {matd_t* H double[2] xy} Zicl_Value {
    double out[2];
    homography_project(H, xy[0], xy[1], &out[0], &out[1]);

    Zicl_Value retObjs[2] = { Zicl_NewDouble(out[0]), Zicl_NewDouble(out[1]) };
    return Zicl_BoxList(ziclNewList(retObjs, 2));
}
cc::proc matdMul {matd_t* a matd_t* b} matd_t* {
    return matd_multiply(a, b);
}
set matLib [cc::compile]
Claim the calibration matrix library is $matLib

}
