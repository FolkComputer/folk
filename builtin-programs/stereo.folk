# Start a resident local stereo worker only while a stereo page is connected.
When /someone/ wishes to load stereo {
    Wish to really load stereo
}

When /someone/ wishes to really load stereo {
    set py [Uvx --python 3.12 --with numpy --with opencv-python-headless==4.11.0.86 \
                --with onnxruntime --with pooch==1.8.2]
    $py exec {
        # Xd = R Xc + t converts camera coordinates to the shared display frame.
        # The output is rectified left-camera Z in meters.
        import base64
        import contextlib
        import json
        from pathlib import Path
        import sys
        import threading
        import time

        import cv2
        import numpy as np


        def camera_matrix(k, size):
            sx, sy = size[0] / k['width'], size[1] / k['height']
            if abs(k.get('s', 0)) > 1e-8:
                raise ValueError('Stereo rectification requires zero camera skew')
            return np.array([[k['fx']*sx, 0, k['cx']*sx],
                             [0, k['fy']*sy, k['cy']*sy], [0, 0, 1.]], dtype=np.float64)


        def rectify(frames, width=640, size=None):
            """Undistort/rectify into one horizontal, positive-disparity stereo pair."""
            if len(frames) != 2 or frames[0]['camera'] == frames[1]['camera']:
                raise ValueError('Two distinct calibrated cameras are required')
            images = [cv2.imread(f['filename']) for f in frames]
            if any(i is None for i in images):
                raise ValueError('Could not decode both camera frames')
            width = size[0] if size else width
            rectified_size = (width, round(width * images[0].shape[0] / images[0].shape[1]))
            size = size or rectified_size
            ks = [camera_matrix(f['k'], rectified_size) for f in frames]
            ds = [np.array([f['k'].get(k, 0) for k in ('k1','k2','p1','p2')], dtype=np.float64) for f in frames]
            rs = [np.array(f['e']['R'], dtype=float) for f in frames]
            ts = [np.array(f['e']['t'], dtype=float) for f in frames]
            # Transform first camera coordinates into second camera coordinates.
            r = rs[1].T @ rs[0]
            t = rs[1].T @ (ts[0] - ts[1])
            baseline = np.linalg.norm(t)
            if not np.isfinite(baseline) or baseline < .01:
                raise ValueError('Calibrated stereo baseline is too small')
            a, b, p, q, _, _, _ = cv2.stereoRectify(*[ks[0], ds[0], ks[1], ds[1]], rectified_size, r, t.reshape(3,1),
                flags=cv2.CALIB_ZERO_DISPARITY, alpha=1)
            # Fast-FoundationStereo expects horizontal epipolar lines.
            if abs(q[1,3]) > abs(q[0,3]):
                raise ValueError('Vertical stereo calibration is unsupported; mount cameras horizontally')
            if q[0,3] > 0:
                return rectify(frames[::-1], width, size)
            geometry = list(zip(ks, ds, (a, b), (p, q)))
            source_mask = np.ones(rectified_size[::-1], np.uint8)
            union = np.zeros_like(source_mask)
            for k, d, rotation, projection in geometry:
                maps = cv2.initUndistortRectifyMap(k, d, rotation, projection, rectified_size, cv2.CV_32FC1)
                union |= cv2.remap(source_mask, *maps, cv2.INTER_NEAREST)
            x, y, w, h = cv2.boundingRect(union)
            if not w or not h:
                raise ValueError('Stereo rectification maps both cameras outside the output frame')

            # Fit both image footprints with one transform to keep epipolar rows and
            # zero-disparity alignment intact. Scale the depth conversion with it.
            scale = min(size[0] / w, size[1] / h)
            tx = (size[0] - 1) / 2 - scale * (x + (w - 1) / 2)
            ty = (size[1] - 1) / 2 - scale * (y + (h - 1) / 2)
            fit = np.array([[scale, 0, tx], [0, scale, ty], [0, 0, 1]])
            result = []
            masks = []
            for image, (k, d, rotation, projection) in zip(images, geometry):
                maps = cv2.initUndistortRectifyMap(k, d, rotation, fit @ projection, size, cv2.CV_32FC1)
                resized = cv2.resize(image, rectified_size, interpolation=cv2.INTER_AREA)
                result.append(cv2.remap(resized, *maps, cv2.INTER_LINEAR))
                masks.append(cv2.remap(source_mask, *maps, cv2.INTER_NEAREST) > 0)
            return result, masks, scale * p[0,0] * baseline, [f['camera'] for f in frames]


        def png(image):
            ok, data = cv2.imencode('.png', image)
            if not ok:
                raise ValueError('PNG encoding failed')
            return base64.b64encode(data).decode('ascii')


        # Pin demo assets to the upstream revision used for this integration.
        UPSTREAM_REVISION = '476f4249561f7c79ca707326954f9255643412a6'
        MODEL_URL = 'https://drive.usercontent.google.com/download?id=1p9vgRh_8R1FXA79l8VdnN28dDQ3NEEhf'
        MODEL_HASH = 'sha256:cd9e80a0178481a76b2b7d198f30261db45ec7796f4d1610aca33e502f8ece89'


        def cached_asset(url, known_hash=None):
            import pooch
            return Path(pooch.retrieve(url, known_hash=known_hash,
                path=pooch.os_cache('folk-stereo'),
                downloader=pooch.HTTPDownloader(timeout=(5, 60))))


        def demo_frames():
            url = f'https://raw.githubusercontent.com/NVlabs/Fast-FoundationStereo/{UPSTREAM_REVISION}/demo_data'
            files = {name: cached_asset(f'{url}/{name}')
                     for name in ('K.txt', 'left.png', 'right.png')}
            lines = files['K.txt'].read_text().splitlines()
            k = np.array([float(v) for v in lines[0].split()]).reshape(3,3)
            baseline = float(lines[1])
            h,w = cv2.imread(str(files['left.png'])).shape[:2]
            intrinsics = dict(width=w,height=h,fx=k[0,0],fy=k[1,1],cx=k[0,2],cy=k[1,2])
            return [dict(camera='Demo '+name, filename=str(files[name+'.png']), k=intrinsics,
                         e=dict(R=np.eye(3).tolist(),t=[i*baseline,0,0])) for i,name in enumerate(('left','right'))]


        class Stereo:
            def __init__(self, model_path=None, iters=4):
                import onnxruntime as ort
                self.iters = iters
                self.warmed = False
                model_path = model_path or cached_asset(MODEL_URL, MODEL_HASH)
                options = ort.SessionOptions()
                options.intra_op_num_threads = 2
                options.inter_op_num_threads = 1
                # Bound retained allocations on the 7 GB CNC machine.
                options.enable_cpu_mem_arena = False
                options.enable_mem_pattern = False
                self.onnx = ort.InferenceSession(str(model_path), options, providers=['CPUExecutionProvider'])
                inputs = self.onnx.get_inputs()
                if len(inputs) != 2 or any(i.type != 'tensor(float)' for i in inputs):
                    raise ValueError('Expected two float32 ONNX image inputs')
                _, channels, h, w = inputs[0].shape
                if channels != 3 or not isinstance(h, int) or not isinstance(w, int):
                    raise ValueError('Expected fixed NCHW ONNX input dimensions')
                self.size = (w, h)
                self.backend = 'ONNX Runtime CPU (2 threads)'

            def infer(self, images):
                mean = np.array([123.675,116.28,103.53], np.float32)
                std = np.array([58.395,57.12,57.375], np.float32)
                tensors = [np.ascontiguousarray(((cv2.cvtColor(i, cv2.COLOR_BGR2RGB).astype(np.float32)-mean)/std).transpose(2,0,1)[None]) for i in images]
                feed = {info.name: tensor for info,tensor in zip(self.onnx.get_inputs(),tensors)}
                warmup = 0.
                if not self.warmed:
                    start = time.perf_counter()
                    self.onnx.run(None, feed)
                    warmup = time.perf_counter()-start
                    self.warmed = True
                start = time.perf_counter()
                disparity = self.onnx.run(None, feed)[0]
                return disparity.squeeze().astype(np.float32), time.perf_counter()-start, warmup

            def process(self, payload):
                start = time.perf_counter()
                frames = demo_frames() if payload.get('demo') else payload['frames']
                images, masks, fb, names = rectify(frames, size=self.size)
                disp, inference, warmup = self.infer(images)
                yy, xx = np.indices(disp.shape)
                right_x = np.rint(xx - disp).astype(np.int32)
                valid = np.isfinite(disp) & (disp > .1) & (right_x >= 0) & (right_x < disp.shape[1]) & masks[0]
                valid &= masks[1][yy, np.clip(right_x, 0, disp.shape[1]-1)]
                depth = np.full(disp.shape, np.nan, np.float32)
                depth[valid] = fb / disp[valid]
                values = depth[valid]
                if not len(values):
                    raise ValueError('No valid stereo depth pixels')
                low, high = np.percentile(values, [2,98])
                normalized = np.zeros(disp.shape, np.uint8)
                normalized[valid] = (255*np.clip((depth[valid]-low)/max(high-low, 1e-6), 0, 1)).astype(np.uint8)
                color = cv2.applyColorMap(255-normalized, cv2.COLORMAP_TURBO)
                color[~valid] = 0
                # Lossless raw metric depth: 16-bit millimeters; 0 means invalid/out of range.
                mm = np.zeros(disp.shape, np.uint16)
                encodable = valid & (depth < 65.535)
                mm[encodable] = np.maximum(1, np.rint(depth[encodable]*1000)).astype(np.uint16)
                result = dict(left=png(images[0]), right=png(images[1]), depth=png(color), depthMillimeters=png(mm),
                    cameras=names, width=disp.shape[1], height=disp.shape[0],
                    nearMeters=float(low), farMeters=float(high), validFraction=float(valid.mean()),
                    inferenceSeconds=inference, warmupSeconds=warmup, iterations=self.iters, backend=self.backend)
                result['pairSeconds'] = time.perf_counter() - start
                return result


        stereo_model = None
        stereo_lock = threading.Lock()
    }
    $py def stereoEstimate {str payload} {
        global stereo_model
        with stereo_lock, contextlib.redirect_stdout(sys.stderr):
            if stereo_model is None:
                stereo_model = Stereo()
            return json.dumps(stereo_model.process(json.loads(payload)), allow_nan=False)
    }
    fn stereoEstimate {payload} { $py stereoEstimate $payload }
    Claim the stereo estimator is [fn stereoEstimate]
}

Wish the web server handles route {/lib/stereo.js} with handler {
    set script {const ws = new FolkWS(document.getElementById('connectionStatus'));
const capture = document.getElementById('capture');
const demo = document.getElementById('demo');
let demoMode = false;
const live = document.getElementById('live');
const status = document.getElementById('status');
let busy = false, stopped = false, initialCapture = true;

ws.watchCollected('the stereo estimator is /estimator/', matches => {
    capture.disabled = demo.disabled = !matches.length || busy;
    if (matches.length && !busy) {
        status.textContent = 'Ready. First pair includes model loading and warmup.';
        if (initialCapture) { initialCapture = false; update(); }
    }
});
ws.watchCollected('stereo has error /error/', matches => {
    if (matches.length) status.textContent = matches[0].error;
});
ws.send('Wish to load stereo');

async function update() {
    if (busy || stopped || capture.disabled) return;
    busy = true;
    capture.disabled = demo.disabled = true;
    const started = Date.now();
    const showProgress = () => {
        status.textContent = `Processing pair… ${Math.floor((Date.now()-started)/1000)} s elapsed. First capture includes model loading and warmup.`;
    };
    showProgress();
    const progress = setInterval(showProgress, 1000);
    try {
        const response = await fetch('/stereo-frame' + (demoMode ? '?demo=1' : ''), {cache:'no-store'});
        if (!response.ok) throw Error(`Stereo request failed (${response.status})`);
        const result = await response.json();
        if (result.error) throw Error(result.error);
        for (const name of ['left','right','depth']) document.getElementById(name).src = 'data:image/png;base64,' + result[name];
        for (let i=0;i<2;i++) document.getElementById(i ? 'rightLabel':'leftLabel').textContent = `Rectified ${i ? 'right':'left'}: ${result.cameras[i]}`;
        const download = document.getElementById('download');
        download.href = 'data:image/png;base64,' + result.depthMillimeters;
        download.hidden = false;
        status.textContent = `${result.width} × ${result.height}, ${result.iterations} iterations. ${result.backend || 'Model'} inference: ${(result.inferenceSeconds*1000).toFixed(1)} ms. Pair processing: ${(result.pairSeconds*1000).toFixed(1)} ms.\nColor range: ${result.nearMeters.toFixed(2)}–${result.farMeters.toFixed(2)} m; ${(100*result.validFraction).toFixed(0)}% valid.${result.warmupSeconds ? ` Warmup: ${result.warmupSeconds.toFixed(1)} s.` : ''}`;
    } catch (error) {
        status.textContent = error.message;
        live.checked = false;
    } finally {
        clearInterval(progress);
        busy = false;
        capture.disabled = demo.disabled = false;
    }
    if (live.checked && !stopped) setTimeout(update, 100);
}
capture.onclick = () => {demoMode = false; update();};
demo.onclick = () => {demoMode = true; update();};
live.onchange = () => { if (live.checked) update(); };
window.addEventListener('pagehide', () => {stopped = true;});
}
    dict create statusAndHeaders "HTTP/1.1 200 OK\nConnection: close\nContent-Type: text/javascript; charset=utf-8\nCache-Control: no-store\n\n" body $script
}

Wish the web server handles route {/stereo} with handler {
    set response [html {
<!doctype html><html><head><title>Stereo depth</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body {font:16px system-ui; margin:20px; background:#111; color:#eee}
.views {display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px}
img {width:100%; display:block} figure {margin:0} a {color:#8cf}
button {font:inherit;padding:8px} #status {white-space:pre-wrap}
</style></head><body><h1>Stereo depth</h1>
<p>Rectified camera views and depth along the left camera’s optical axis, in meters. Warm colors are near; cool colors are far. Black pixels have no valid depth.</p>
<span id="connectionStatus">Connecting…</span>
<p><button id="demo" disabled>Try demo pair</button> <button id="capture" disabled>Capture stereo pair</button> <label><input id="live" type="checkbox"> Repeat</label> <a id="download" hidden download="depth-mm.png">Download 16-bit depth (millimeters)</a></p>
<p id="status" role="status">Starting stereo worker…</p>
<div class="views"><figure><figcaption id="leftLabel">Rectified left</figcaption><img id="left"></figure><figure><figcaption id="rightLabel">Rectified right</figcaption><img id="right"></figure><figure><figcaption>Depth</figcaption><img id="depth"></figure></div>
<script src="/lib/folk.js"></script><script src="/lib/stereo.js?v=2"></script>
</body></html>
    }]
    dict set response statusAndHeaders "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/html; charset=utf-8\r\nCache-Control: no-store, max-age=0\r\n\r\n"
    return $response
}

Wish the web server handles route {/stereo-frame} with handler {
    set files {}
    try {
        if {[dict getdef $QUERY demo 0] eq "1"} {
            set estimator [QueryOne! the stereo estimator is /./];fn estimator
            set result [estimator {{"demo":true}}]
        } else {
            set libraries [Query! the jpeg library is /jpegLib/]
            if {![llength $libraries]} {error {No live cameras in this server. Use Try demo pair, or start the normal Folk service with cameras connected.}}
            set jpegLib [dict get [lindex $libraries 0] jpegLib]
            set frames {};set names {}
            # Both cameras must share the same calibrated display coordinate frame.
            foreach pose [lsort -command {apply {{a b} {string compare $a(camera) $b(camera)}}} [Query! camera /camera/ to display /display/ has extrinsics /e/]] {
                set camera $pose(camera)
                if {[lsearch -exact $names $camera]>=0} continue
                if {[llength $frames] && $pose(display) ne $commonDisplay} continue
                set ks [Query! camera $camera has intrinsics /k/]
                set latest [lindex [lsort -real -decreasing -index 1 [lmap r [Query! camera $camera has jpeg frame /jpeg/ at timestamp /timestamp/] {list $r(jpeg) $r(timestamp)}]] 0]
                if {![llength $ks] || ![llength $latest]} continue
                set commonDisplay $pose(display)
                lassign $latest jpeg timestamp
                set filename [file tempfile /tmp/stereo-frame-XXXXXX];lappend files $filename
                set f [open $filename wb]
                try {puts -nonewline $f [$jpegLib jpegData $jpeg]} finally {close $f}
                lappend frames [dict create camera $camera filename $filename timestamp $timestamp k [dict get [lindex $ks 0] k] e $pose(e)]
                lappend names $camera
                if {[llength $frames]==2} break
            }
            if {[llength $frames]!=2} {error {Two live cameras with calibration in the same display are required}}
            set estimator [QueryOne! the stereo estimator is /./];fn estimator
            set payload [json::encode [dict create frames $frames] {obj frames {list obj timestamp num k {obj width num height num fx num fy num cx num cy num k1 num k2 num p1 num p2 num s num} e {obj R {list list num} t {list num}}}}]
            set result [estimator $payload]
        }
    } on error {e} {
        set result [json::encode [dict create error $e] obj]
    } finally {
        foreach filename $files {file delete -force $filename}
    }
    dict create statusAndHeaders "HTTP/1.1 200 OK\nConnection: close\nContent-Type: application/json\nCache-Control: no-store\n\n" body $result
}
