+// Exposure range of the camera in microseconds (V4L2 counts in 100us
+// steps). Falls back to a generous default if the control can't be
+// queried, and says so with `queried 0`.
+$camc proc cameraExposureRange {Camera* camera} Jim_Obj* {
+    struct v4l2_queryctrl q;
+    memset(&q, 0, sizeof q);
+    q.id = V4L2_CID_EXPOSURE_ABSOLUTE;
+    if (xioctl(camera->fd, VIDIOC_QUERYCTRL, &q) == -1 ||
+        (q.flags & V4L2_CTRL_FLAG_DISABLED)) {
+        return Jim_ObjPrintf("min 300 max 100000 step 100 queried 0");
+    }
+    return Jim_ObjPrintf("min %d max %d step %d queried 1",
+                         q.minimum * 100, q.maximum * 100, q.step * 100);
+}
+
+// The exposure the camera is currently using, in microseconds (-1 if it
+// can't be read). Used to seed the autoexposure loop with reality
+// instead of a guess.
+$camc proc getExposure {Camera* camera} int {
+    struct v4l2_control c;
+    memset(&c, 0, sizeof c);
+    c.id = V4L2_CID_EXPOSURE_ABSOLUTE;
+    if (xioctl(camera->fd, VIDIOC_G_CTRL, &c) == -1) return -1;
+    return c.value * 100;
+}
