# This program gets directly evaluated at the top level.

apply [fn {} {
    # We setpgrp so that all subprocesses spawned by Folk, even ones
    # that outlive Folk itself, can be killed later by their PGID (the
    # PID in folk.pid).
    catch { setpgrp }

    catch {
        set fp [file open "folk.pid" r]
        set oldPid [stream read $fp]; close $fp
        try {
            if {[string trim [exec ps -o state= -p $oldPid]] eq "Z"} {
                error "Zombie Folk process exists (PID $oldPid)"
            }
            stream write $realStderr "boot: ERROR: Another Folk (PID $oldPid) already running.\n"
            Exit! 1
        } on error e {
            if {$e ne ""} {
                stream write $realStderr "boot: $e; this is OK; continuing.\n"
            }
        }
    }

    set fp [file open "folk.pid" w]
    stream write $fp [pid]; close $fp
    # in case we're running as root:
    catch { exec chown folk folk.pid }
}]

__installLocalStdoutAndStderr "boot.folk"

Assert! when /this/ has program code /programCode/ [fn {this programCode} {
    # Program code arrives as a bare string (read off disk, out of the
    # editor, off a printed page), so it carries no source location and
    # every error inside it would report an empty file name. Stamp the
    # program's own name and line 1 on it here, at the one place all of
    # those producers funnel through.
    set programCode [info source $programCode $this 1]

    if {$this eq "builtin-programs/collect.folk"} {
        # We don't have Collect available in boot.folk yet, since it's
        # implemented in userspace, so we can't do the queries. Just
        # run it always.
        SayWithSource $this 1 0 {} {} \
            when [fn {} $programCode]
        return
    }

    When /nobody/ wishes program $this does not run {
        When /nobody/ wishes program $this is replaced with /...anything/ {
            SayWithSource $this 1 0 {} {} \
                when [fn {} $programCode]
        }
        When /someone/ wishes program $this is replaced with /...replacedOpts/ {
            SayWithSource $this 1 0 {} {} \
                when [fn {} [info source [dict get $replacedOpts code] $this 1]]
        }
    }
}]

fn LoadProgram! {programFilename} {
    set fp [file open $programFilename r]
    set code [stream read $fp]
    close $fp

    set editedPath "$env::HOME/folk-data/program/[regsub {\.folk$} $programFilename {}].folk.edited"
    if {[file exists $editedPath]} {
        set efd [file open $editedPath r]
        set code [stream read $efd]
        close $efd
    }

    Hold! -on boot.folk -key [list $programFilename code] \
        -keep 100ms \
        Claim $programFilename has program code $code
}
foreach programFilename [list {*}[glob -nocomplain builtin-programs/*.folk] \
                             {*}[glob -nocomplain builtin-programs/*/*.folk] \
                             {*}[glob -nocomplain "user-programs/[info hostname]/*.folk"] \
                             {*}[glob -nocomplain "$env::HOME/folk-data/local-program/*.folk"] \
                             {*}[glob -nocomplain "$env::HOME/folk-data/local-program/*/*.folk"]] {
    if {[string match "*/_archive/*" $programFilename]} {
        continue
    }

    LoadProgram! $programFilename
}

if {$tcl_platform::os eq "darwin"} {
    # HACK: We must run all the GPU and window setup stuff
    # synchronously in the main thread on macOS.

    fn fake {s} {
        set __envStack [list]

        rename When When'
        fn When args {
            set pattern [lrange $args 0 end-1]

            # Await the dependencies being available.
            while {[llength [Query! {*}$pattern]] != 1} {
                sleep 0.1
            }

            # Restore real When before running the body, so any When
            # calls inside the body register persistent async handlers.
            rename When {}
            rename When' When

            tailcall ForEach! {*}$args
        }

        source $s

        if {[exists -command When']} {
            rename When {}
            rename When' When
        }
    }
    fake "builtin-programs/gpu/gpu.folk"
    # textures.folk and pipelines.folk don't need the main thread
    # (no GLFW/window work), so they run as normal async programs.
    # draw.folk's fake When polls until their claims are available.
    fake "builtin-programs/gpu/draw.folk"
}
