Wish the web server handles route "/static-html/$" with handler [fn {args} {
  html "<h1>Hello World!</h1>"
}]

Wish the web server handles route "/score/$" with handler [fn {args} {
  json "{\"score\": 5}"
}]

When the collected results for [list /regionName/ has region /region/] are /regionResults/ {
  Wish the web server handles route "/regions/$" with handler [fn {args} {
    set body "<ol>"
    foreach result $regionResults {
      append body "<li><strong>[dict get $result regionName]</strong>: [dict get $result region]</li>"
    }
    append body "</ol>"
    html $body
  }]
}

Wish the web server handles route "/redirect/$" with handler [fn {args} {
  dict create statusAndHeaders "HTTP/1.1 302 Found\nLocation: https://folk.computer"
}]

Wish the web server handles route {/pagee/(\d*)$} with handler [fn {args} {
  if {[regexp -all {/pagee/(\d*)$} $path whole_match pageNumber]} {
    html "<h1>Hello Page Number $pageNumber</h1>"
  }
}]
